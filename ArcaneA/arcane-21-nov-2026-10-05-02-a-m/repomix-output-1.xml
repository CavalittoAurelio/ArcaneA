                    />
                  </label>

                  <label className="sm:col-span-3 space-y-1">
                    <span className="block font-semibold text-[var(--arc-muted)]">Categoría</span>
                    <select
                      value={customKind}
                      onChange={(e) => setCustomKind(e.target.value as EffectSubType | 'status')}
