<file path="app/applet/parse_repomix.py">
import os
import re
import xml.etree.ElementTree as ET

xml_path = '/repomix-output.xml'
output_base = '/app/applet'

print("Reading repomix-output.xml...")
with open(xml_path, 'r', encoding='utf-8') as f:
    content = f.read()

# Find all file tags: <file path="...">...</file>
# Note that repomix output has line numbers prepended like "1: <file path=...>" or similar because of repomix line numbering feature if enabled, or maybe the file itself has line numbers in repomix output.
# Let's inspect how repomix output lines are formatted.
# The user note said: "The following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>."
# So EVERY line in repomix-output.xml has "123: " prefix!

lines = content.split('\n')
clean_lines = []
for line in lines:
    # Match pattern like ^\s*\d+:\s?(.*)$
    match = re.match(r'^\s*(\d+):\s?(.*)$', line)
    if match:
        clean_lines.append(match.group(2))
    else:
        clean_lines.append(line)

clean_content = '\n'.join(clean_lines)

# Now parse clean_content as XML or regex search for <file path="...">...</file>
file_matches = re.finditer(r'<file path="([^"]+)">\n(.*?)\n</file>', clean_content, re.DOTALL)

extracted_count = 0
for m in file_matches:
    file_path = m.group(1)
    file_content = m.group(2)
    
    # Normalize file path: strip leading directory prefixes like Arcane/arcane-19-nov-2026-7-49-50-p-m/ if present
    # Let's check what prefixes exist
    rel_path = file_path
    for prefix in ['Arcane/arcane-19-nov-2026-7-49-50-p-m/', 'Arcane/']:
        if rel_path.startswith(prefix):
            rel_path = rel_path[len(prefix):]
            break
            
    # Destination absolute path
    dest_path = os.path.join(output_base, rel_path)
    os.makedirs(os.path.dirname(dest_path), exist_ok=True)
    
    with open(dest_path, 'w', encoding='utf-8') as out_f:
        out_f.write(file_content)
        
    print(f"Extracted: {rel_path} -> {dest_path}")
    extracted_count += 1

print(f"Successfully extracted {extracted_count} files from repomix-output.xml!")
</file>

