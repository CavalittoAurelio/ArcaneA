                      ))}
                    </optgroup>
                  ))}
                </select>
                {(() => {
                  const sel = MAGE_NATURES.find((n) => n.id === newNatureId);
                  if (!sel || sel.affinityOrders.length === 0) return null;
                  return (
                    <p className="mt-1 text-[11px] text-[var(--arc-muted)] leading-snug">
