  @media(max-width:520px){.stat-grid{grid-template-columns:1fr}}
  .stat-card{background:var(--panel-2);border:1px solid var(--border);border-radius:10px;
    padding:12px;transition:border-color .15s}
  .stat-card:hover{border-color:var(--accent-dark)}
  .stat-name{font-size:.78rem;text-transform:uppercase;letter-spacing:.6px;
    color:var(--accent-2);font-weight:600;margin-bottom:8px;display:flex;align-items:center;gap:6px}
  .stat-card select{margin-bottom:8px}
  .stat-info{display:flex;justify-content:space-between;align-items:center;
    font-size:.78rem;color:var(--text-dim)}
  .stat-points{background:var(--panel);border:1px solid var(--border);
    padding:2px 8px;border-radius:4px;color:var(--accent-3)}
  .stat-dice{background:var(--panel);border:1px solid var(--accent-dark);
    padding:2px 10px;border-radius:4px;color:var(--accent);font-family:monospace;font-weight:700}

  .formula-formula{font-family:monospace;font-size:.9rem;background:var(--panel-2);
    border:1px solid var(--accent-dark);border-radius:8px;padding:10px 12px;
    text-align:center;color:var(--accent-2);margin-bottom:12px}
  .formula-formula strong{color:var(--accent);font-weight:700}
  .formula-presets{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}
  .formula-table{width:100%;border-collapse:collapse;font-size:.85rem;
    background:var(--panel-2);border-radius:8px;overflow:hidden;border:1px solid var(--border);margin-top:6px}
  .formula-table th{padding:7px 10px;background:var(--panel);color:var(--text-dim);
    font-weight:600;font-size:.72rem;text-transform:uppercase;letter-spacing:.5px;text-align:left}
  .formula-table th:last-child{text-align:right}
  .formula-table th:nth-child(2){text-align:right}
  .formula-table td{padding:7px 10px;border-top:1px solid var(--border)}
  .formula-table td:nth-child(2){text-align:right;color:var(--accent-3);font-family:monospace}
  .formula-table td:nth-child(3){text-align:right;color:var(--accent);font-family:monospace;font-weight:700}
  .formula-table tr.current{background:rgba(143,181,106,.12)}
  .formula-table tr.current td:first-child{color:var(--accent);font-weight:600}
  .formula-note{font-size:.75rem;color:var(--text-muted);font-style:italic;margin-top:8px;line-height:1.5}

  .form-group{margin-bottom:14px}
  .form-group > label{display:block;font-size:.78rem;text-transform:uppercase;
    letter-spacing:.5px;color:var(--text-dim);margin-bottom:6px}
  input[type=text],input[type=number],select,textarea{width:100%;background:var(--panel-2);
    border:1px solid var(--border);border-radius:8px;padding:8px 10px;color:var(--text);
    font-family:inherit;font-size:.9rem;transition:border-color .15s,box-shadow .15s}
  input:focus,select:focus,textarea:focus{outline:none;border-color:var(--accent);
    box-shadow:0 0 0 2px rgba(143,181,106,.18)}
  textarea{resize:vertical;min-height:70px}

  button{background:var(--panel-2);border:1px solid var(--border);color:var(--text);
    border-radius:8px;padding:8px 14px;cursor:pointer;font-family:inherit;font-size:.9rem;
    transition:all .15s;display:inline-flex;align-items:center;justify-content:center;gap:6px}
  button:hover{border-color:var(--accent);background:var(--panel-3)}
  button.primary{background:var(--accent-dark);border-color:var(--accent);color:#fff;font-weight:600}
  button.primary:hover{background:var(--accent)}
  button.danger{color:var(--danger)}
  button.danger:hover{border-color:var(--danger);background:#2e1810}

  .chips{display:flex;flex-wrap:wrap;gap:6px;min-height:30px;margin-bottom:8px}
  .chip{background:var(--panel-2);border:1px solid var(--accent-dark);color:var(--text);
    border-radius:999px;padding:4px 10px;font-size:.82rem;display:inline-flex;align-items:center;gap:6px}
  .chip::before{content:"◈";color:var(--accent-2);font-size:.75rem}
  .chip button{background:none;border:none;color:var(--text-dim);padding:0;
    font-size:1rem;line-height:1;cursor:pointer;display:inline-flex}
  .chip button:hover{color:var(--danger)}

  .row{display:flex;gap:8px}
  .row > *{flex:1}
  .row > button{flex:0 0 auto}

  .dice-counter{display:flex;align-items:center;gap:10px}
  .dice-counter button{width:38px;height:38px;font-size:1.3rem;padding:0}
  .dice-preview{font-family:monospace;font-size:1.1rem;color:var(--accent-2);
    padding:6px 14px;background:var(--panel-2);border-radius:8px;border:1px solid var(--border)}
  .dice-preview-icon{display:inline-block;margin-right:6px;vertical-align:middle}

  .stat-linked-box{background:var(--panel-2);border:1px solid var(--accent-dark);
    border-radius:8px;padding:10px 12px;display:flex;align-items:center;justify-content:space-between;
    gap:10px;flex-wrap:wrap}
  .stat-linked-box .label{font-size:.82rem;color:var(--text-dim)}
  .stat-linked-box .value{font-family:monospace;font-size:1.15rem;color:var(--accent);font-weight:700}
  .stat-linked-box .stat-tag{font-size:.7rem;color:var(--text-muted);
    background:var(--panel);padding:2px 8px;border-radius:4px;border:1px solid var(--border)}

  .attack-stat-checkbox{
    display:flex;align-items:center;gap:10px;padding:10px 12px;
    background:var(--panel-2);border:1px solid var(--border);
    border-radius:8px;cursor:pointer;margin-bottom:6px;
    transition:border-color .15s,background .15s;user-select:none;
  }
  .attack-stat-checkbox:hover{border-color:var(--accent-dark)}
  .attack-stat-checkbox.checked{border-color:var(--accent);background:rgba(143,181,106,.08)}
  .attack-stat-checkbox input[type=checkbox]{width:18px;height:18px;
    accent-color:var(--accent);cursor:pointer;flex:0 0 auto;margin:0}
  .attack-stat-checkbox .stat-label{flex:1;color:var(--text);font-size:.88rem}
  .attack-stat-checkbox .stat-dice-inline{font-family:monospace;color:var(--accent);
    font-weight:700;font-size:.88rem}
  .attack-stat-checkbox .stat-lvl-inline{font-size:.7rem;color:var(--text-muted)}

  .effect-tabs{display:flex;gap:4px;margin-bottom:12px}
  .effect-tabs button{flex:1;font-size:.85rem;padding:8px 4px}
  .effect-tabs button.active{background:var(--accent-dark);border-color:var(--accent);color:#fff}

  .damage-die-row{display:flex;gap:6px;align-items:center;margin-bottom:6px}
  .damage-die-row select{flex:0 0 100px}
  .damage-die-row input{flex:0 0 80px}
  .damage-die-row button{flex:0 0 auto;padding:6px 10px}

  .actions{display:flex;gap:8px;margin-top:16px;flex-wrap:wrap}
  .actions button{flex:1;min-width:110px}

  .spell-card{background:var(--panel-2);border:1px solid var(--border);
    border-left:3px solid var(--accent-dark);border-radius:10px;padding:14px;
    margin-bottom:12px;transition:border-color .15s}
  .spell-card:hover{border-color:var(--accent);border-left-color:var(--accent)}
  .spell-card.is-basic{border-left-color:var(--accent-2)}
  .spell-card h3{margin:0 0 6px;font-size:1rem;color:var(--accent-2);
    display:flex;align-items:center;gap:8px;flex-wrap:wrap}
  .badge-basic{background:var(--accent-2);color:#2a1e10;font-size:.62rem;
    padding:2px 7px;border-radius:4px;font-weight:700;letter-spacing:.6px;text-transform:uppercase}
  .badge-assured{background:rgba(212,168,67,.15);color:var(--accent-2);
    border:1px solid var(--accent-2);font-size:.62rem;padding:2px 7px;
    border-radius:4px;font-weight:600;letter-spacing:.4px}
  .badge-manual{background:rgba(184,123,74,.15);color:var(--accent-3);
    border:1px solid var(--accent-3);font-size:.62rem;padding:2px 7px;
    border-radius:4px;font-weight:600;letter-spacing:.4px}
  .spell-stats{display:flex;flex-wrap:wrap;gap:6px;margin:8px 0}
  .spell-stat-chip{font-size:.72rem;padding:3px 9px;border-radius:999px;
    background:var(--panel);border:1px solid var(--border);color:var(--text-dim);
    display:inline-flex;align-items:center;gap:5px}
  .spell-stat-chip strong{color:var(--accent);font-family:monospace}
  .spell-stat-chip.cast{border-color:var(--accent-dark)}
  .spell-stat-chip.atk{border-color:var(--accent-3);color:var(--text)}
  .spell-meta{display:flex;flex-wrap:wrap;gap:6px;font-size:.78rem;
    color:var(--text-dim);margin-bottom:8px}
  .spell-meta span{background:var(--panel);padding:2px 8px;border-radius:4px;border:1px solid var(--border)}
  .spell-orders{display:flex;flex-wrap:wrap;gap:4px;margin-bottom:8px}
  .spell-orders .chip{font-size:.72rem;padding:2px 8px}
  .spell-effect-text{font-size:.85rem;color:var(--text);margin-bottom:8px;white-space:pre-wrap;
    background:var(--panel);padding:8px 10px;border-radius:6px;border:1px solid var(--border);line-height:1.5}
  .spell-actions{display:flex;gap:6px;flex-wrap:wrap}
  .spell-actions button{padding:6px 10px;font-size:.82rem}

  .log-entry{background:var(--panel-2);border-left:3px solid var(--accent);
    border-radius:6px;padding:10px 12px;margin-bottom:10px;font-size:.85rem}
  .log-entry.cast-only{border-left-color:var(--accent-dark)}
  .log-entry.attack-only{border-left-color:var(--accent-3)}
  .log-title{font-weight:600;color:var(--accent-2);margin-bottom:8px;font-size:.95rem}
  .log-step{background:var(--panel);border:1px solid var(--border);border-radius:6px;
    padding:8px 10px;margin:8px 0}
  .log-step-title{font-size:.78rem;text-transform:uppercase;letter-spacing:.5px;
    color:var(--accent);font-weight:600;margin-bottom:6px}
  .log-step-title.attack{color:var(--accent-3)}
  .log-step-title.damage{color:var(--accent-2)}
  .log-line{margin:5px 0;line-height:1.5}

  .dice-row{display:flex;flex-wrap:wrap;gap:4px;margin:6px 0;align-items:center}
  .die{display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;
    border-radius:7px;font-weight:700;font-family:monospace;font-size:.95rem;border:2px solid}
  .die-neutral{background:#2e2418;color:var(--text-muted);border-color:#4a3624}
  .die-fail{background:#3e1c12;color:#ff9a7a;border-color:#7a3020}
  .die-success{background:#1e3a18;color:#c4f2a4;border-color:#4a7a30}
  .die-assured{background:#3a2e10;color:var(--accent-2);border-color:#8a6a20;border-style:dashed}

  .success{color:var(--success);font-weight:600}
  .fail{color:var(--fail);font-weight:600}
  .heal{color:#a4d67e;font-weight:600}
  .empty{color:var(--text-dim);font-style:italic;font-size:.85rem}
  .hint{font-size:.75rem;color:var(--text-dim);margin-top:4px;line-height:1.5}

  .empty-illustration{display:flex;flex-direction:column;align-items:center;gap:8px;
    padding:20px;color:var(--text-muted);font-style:italic;font-size:.85rem}
  .empty-illustration svg{opacity:.55}

  .flash{animation:flash .7s ease}
  @keyframes flash{0%{background:var(--accent-dark)}100%{background:var(--panel-2)}}

  .rule-list{list-style:none;padding:0;margin:8px 0;display:grid;
    grid-template-columns:1fr 1fr;gap:6px;font-size:.85rem}
  .rule-list li{display:flex;align-items:center;gap:8px;padding:6px 10px;
    background:var(--panel-2);border-radius:6px;border:1px solid var(--border)}
  .rule-list .die{width:26px;height:26px;font-size:.85rem}

  .mini-btn{font-size:.75rem;padding:5px 10px;color:var(--text-dim);
    background:transparent;border:1px dashed var(--border-light)}
  .mini-btn:hover{color:var(--accent);border-color:var(--accent-dark);border-style:solid;background:var(--panel-2)}

  /* ---------- FLOATING PANEL ---------- */
  .float-panel{
    position:fixed;bottom:20px;right:20px;width:220px;
    background:var(--panel);border:2px solid var(--accent-dark);
    border-radius:12px;box-shadow:0 8px 32px rgba(0,0,0,.6),0 0 0 1px rgba(212,168,67,.1);
    z-index:1000;font-size:.85rem;
  }
  .float-panel.minimized .float-body{display:none}
  .float-panel.minimized .float-min{transform:rotate(180deg)}
  .float-header{
    cursor:move;padding:10px 12px;background:var(--panel-2);
    border-radius:10px 10px 0 0;display:flex;justify-content:space-between;align-items:center;
    user-select:none;font-weight:600;color:var(--accent-2);font-size:.82rem;letter-spacing:.4px;
  }
  .float-header:active{cursor:grabbing}
  .float-min{
    background:none;border:none;color:var(--text-dim);
    width:24px;height:24px;padding:0;cursor:pointer;font-size:1rem;
    border-radius:4px;transition:transform .2s,color .15s;
  }
  .float-min:hover{color:var(--accent)}
  .float-body{padding:12px}
  .float-row{display:flex;align-items:center;gap:8px;margin-bottom:8px}
  .float-row > span:first-child{flex:1;color:var(--text-dim);font-size:.78rem}
  .float-row button{width:28px;height:28px;padding:0;font-size:1rem}
  .float-val{font-family:monospace;min-width:1.5em;text-align:center;
    color:var(--accent);font-weight:700;font-size:1rem}
  #floatRoll{width:100%;margin-top:4px;padding:8px;font-size:.85rem}
  .float-result{margin-top:10px}
  .float-result .dice-row{margin:4px 0}
  .float-result .die{width:26px;height:26px;font-size:.82rem}
  .float-result .dice-summary{font-size:.75rem;color:var(--text-dim);margin-top:6px;line-height:1.4}

  .manual-damage-section input[type=number]{background:var(--panel);border:1px solid var(--accent-dark);
    padding:6px 10px;border-radius:6px;color:var(--text);font-family:inherit;font-size:.9rem;flex:1}
  .manual-damage-section input[type=number]:focus{outline:none;border-color:var(--accent);
    box-shadow:0 0 0 2px rgba(143,181,106,.18)}

  .backup-panel{grid-column:1/-1;margin:0;padding:0;border:1px solid var(--border,var(--borde));border-radius:14px;background:linear-gradient(135deg,rgba(93,125,70,.10),rgba(197,151,76,.045));overflow:hidden}
  .backup-head{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;cursor:pointer;list-style:none;padding:14px 18px}
  .backup-head::-webkit-details-marker{display:none}
  .backup-title{font-size:.9rem;font-weight:650;color:var(--text,var(--text-main))}
  .backup-summary-right{display:flex;align-items:center;gap:12px}
  .backup-chevron{font-size:1.1rem;color:var(--text-dim);transition:transform .2s}
  .backup-panel[open] .backup-chevron{transform:rotate(45deg)}
  .backup-panel[open] .backup-head{border-bottom:1px solid var(--border)}
  .backup-panel > .backup-note,.backup-panel > .backup-actions,.backup-panel > .backup-status{margin-left:18px;margin-right:18px}
  .backup-panel > .backup-note{margin-top:14px}
  .backup-panel > .backup-actions{margin-bottom:0}
  .backup-panel > .backup-status{margin-bottom:14px}
  .backup-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
  .backup-actions button{min-height:38px}
  .backup-note{font-size:.78rem;color:var(--text-muted,var(--text-dim));line-height:1.5}
  .backup-status{font-size:.78rem;margin-top:8px;min-height:1.2em;color:var(--success,#8ebd76)}
  .backup-actions .primary{background:var(--accent,var(--accent-green))}
  @media(max-width:600px){.backup-head{padding:13px}.backup-panel > .backup-note,.backup-panel > .backup-actions,.backup-panel > .backup-status{margin-left:13px;margin-right:13px}.backup-actions{display:grid;grid-template-columns:1fr 1fr}.backup-actions button{width:100%}}

</style>
</head>
<body>

<header>
  <div class="logo">
    <svg viewBox="0 0 72 72" width="62" height="62" aria-hidden="true">
      <defs>
        <linearGradient id="rockGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#b09070"/><stop offset="100%" stop-color="#4a3a28"/>
        </linearGradient>
        <linearGradient id="leafGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#c4e09a"/><stop offset="100%" stop-color="#6a9147"/>
        </linearGradient>
      </defs>
      <g stroke="#6a9147" stroke-width="2.2" opacity=".75">
        <line x1="8" y1="12" x2="8" y2="62"/>
        <line x1="4" y1="26" x2="12" y2="26" stroke-width="2.6"/>
        <line x1="4" y1="46" x2="12" y2="46" stroke-width="2.6"/>
        <line x1="64" y1="14" x2="64" y2="64"/>
        <line x1="60" y1="30" x2="68" y2="30" stroke-width="2.6"/>
        <line x1="60" y1="50" x2="68" y2="50" stroke-width="2.6"/>
      </g>
      <g fill="url(#leafGrad)" stroke="#3d5a2f" stroke-width=".8">
        <path d="M 10 22 Q 20 14 26 22 Q 18 23 10 22 Z"/>
        <path d="M 62 24 Q 54 16 48 24 Q 56 25 62 24 Z"/>
      </g>
      <polygon points="16,52 24,36 36,32 50,38 58,52 50,62 22,62"
               fill="url(#rockGrad)" stroke="#2a2018" stroke-width="1.6" stroke-linejoin="round"/>
      <line x1="26" y1="46" x2="30" y2="56" stroke="#2a2018" stroke-width="1" opacity=".55"/>
      <line x1="46" y1="44" x2="48" y2="58" stroke="#2a2018" stroke-width="1" opacity=".55"/>
      <line x1="36" y1="50" x2="38" y2="60" stroke="#2a2018" stroke-width="1" opacity=".45"/>
      <path d="M 36 32 Q 37 20 48 16 Q 46 28 36 32 Z" fill="url(#leafGrad)" stroke="#3d5a2f" stroke-width="1.1"/>
      <path d="M 36 32 Q 32 22 22 20 Q 26 28 36 32 Z" fill="#8fb56a" stroke="#3d5a2f" stroke-width="1.1" opacity=".9"/>
      <line x1="36" y1="32" x2="36" y2="26" stroke="#3d5a2f" stroke-width="1.2"/>
    </svg>
  </div>
  <div class="title-block">
    <h1>Arcane — Testeador de Hechizos de Tierra</h1>
    <div class="sub">Sistema casero d6 · senda del monje · paneles plegables</div>
  </div>
  <div class="badges">
    <span class="badge">Regla <strong>1 fallo · 5/6 éxito</strong></span>
    <span class="badge">Fórmula <strong id="formulaBadge">1 + nivel</strong></span>
  </div>
</header>

<main>



  <div class="column">
    <section class="panel" data-pid="profile">
      <h2>
        <span class="panel-toggle">▼</span>
        <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="8" r="4"/><path d="M4 21 v-2 a4 4 0 0 1 4 -4 h8 a4 4 0 0 1 4 4 v2"/>
        </svg>
        <span>Perfil del personaje</span>
      </h2>
      <div class="panel-content">
        <div class="stat-grid" id="statGrid"></div>
        <div class="hint">Los dados se calculan con la fórmula configurada más abajo.</div>
      </div>
    </section>

    <section class="panel" data-pid="formula">
      <h2>
        <span class="panel-toggle">▼</span>
        <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 18 L8 6 L12 14 L16 4 L20 18"/>
        </svg>
        <span>Fórmula de dados</span>
        <span style="margin-left:auto;font-size:.65rem;color:var(--text-muted);text-transform:none;letter-spacing:0;font-weight:normal">configurable</span>
      </h2>
      <div class="panel-content">
        <div class="formula-formula">
          dados = <strong id="formulaBaseDisplay">1</strong> + (nivel × <strong id="formulaMultDisplay">1</strong>)
          → actualmente: <strong id="formulaCurrent">1 + nivel</strong>
        </div>
        <div class="row">
          <div class="form-group" style="margin-bottom:0">
            <label>Dados base</label>
            <input type="number" id="formulaBase" min="0" max="10" step="1" value="1">
          </div>
          <div class="form-group" style="margin-bottom:0">
            <label>Multiplicador por nivel</label>
            <input type="number" id="formulaMult" min="0" max="5" step="1" value="1">
          </div>
        </div>
        <div class="formula-presets">
          <button class="mini-btn formula-preset" data-base="1" data-mult="1">1 + nivel</button>
          <button class="mini-btn formula-preset" data-base="0" data-mult="1">Solo nivel</button>
          <button class="mini-btn formula-preset" data-base="1" data-mult="2">1 + 2×nivel</button>
          <button class="mini-btn formula-preset" data-base="2" data-mult="1">2 + nivel</button>
        </div>
        <div style="margin-top:14px">
          <table class="formula-table">
            <thead><tr><th>Nivel</th><th>Puntos</th><th>Dados</th></tr></thead>
            <tbody id="formulaPreviewBody"></tbody>
          </table>
        </div>
        <div class="form-group" style="margin-top:14px;margin-bottom:0">
          <label>Notas / confirmación del DM</label>
          <input type="text" id="formulaNotes" placeholder="Ej: pendiente confirmar con el DM...">
        </div>
        <div class="formula-note">Los hechizos con estadísticas vinculadas se recalculan automáticamente.</div>
      </div>
    </section>

    <section class="panel" data-pid="editor">
      <h2>
        <span class="panel-toggle">▼</span>
        <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
