      setOrders((prev) => {
        if (controlsSonic && prev.length === 0) return [SONIC_BASE_ORDER];
        if (!controlsSonic && prev.length === 1 && prev[0] === SONIC_BASE_ORDER) return [];
        return prev;
      });
