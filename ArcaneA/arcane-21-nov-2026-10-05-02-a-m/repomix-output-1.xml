      {/* ¿Cuándo necesita acción de casteo? + Éxitos asegurados */}
      <div hidden={!tierIsVisible('personalization')} data-builder-tier="personalization" className="space-y-4 border-t border-[var(--arc-border)] pt-4">
        <div className="space-y-2">
