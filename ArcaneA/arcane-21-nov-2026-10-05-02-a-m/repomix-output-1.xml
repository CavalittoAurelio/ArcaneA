  }, [activeCharacter?.id, controlsSonic, defaultArmorElement, editingSpell]);

  const applyTurnCount = (turns: number) => {
    const safe = Math.max(0, Math.min(999, Math.floor(turns || 0)));
    setDurationTurns(safe);
