              })
            }
            className="min-h-[28px] rounded-md border border-[var(--arc-border)] px-2 text-[10px] font-semibold text-[var(--arc-text)] hover:bg-[var(--arc-surface)]"
          >
            {isSpellDisabled ? 'Rehabilitar' : 'Deshabilitar'}
          </button>
        </div>
      )}
    </div>
  );

  if (presentation === 'map') {
    return (
      <div className={`relative flex w-full flex-col items-center gap-1 text-center ${isCapstone ? 'max-w-56' : 'max-w-48'}`}>
        <span
          aria-hidden="true"
          className={`relative flex items-center justify-center rounded-full border bg-[var(--arc-surface)] transition-transform hover:scale-105 ${
            isCapstone ? 'h-[76px] w-[76px] border-2' : 'h-[52px] w-[52px]'
          } ${
            learned
              ? 'border-[#9ad489] shadow-[0_0_16px_rgba(154,212,137,0.28)]'
              : spellAccess.accessible
                ? 'shadow-[0_0_16px_rgba(220,180,90,0.2)]'
                : 'border-[var(--arc-border)]'
          }`}
          style={{
            color: iconColor,
            borderColor: learned
              ? undefined
              : spellAccess.accessible
                ? `${iconColor}cc`
                : undefined,
            boxShadow: isCapstone && spellAccess.accessible
              ? `0 0 24px ${iconColor}55`
              : undefined,
          }}
        >
          {spellImageIcon ? (
            <img
              src={spellImageIcon}
              alt=""
              className={isCapstone ? 'h-14 w-14 object-contain' : 'h-10 w-10 object-contain'}
            />
          ) : (
            <SpellIcon className={isCapstone ? 'h-8 w-8' : 'h-5 w-5'} />
          )}
          {learned && (
            <span className="absolute -right-1 -top-1 flex h-5 w-5 items-center justify-center rounded-full border border-[#9ad489] bg-[var(--arc-surface)] text-[#9ad489]">
              <Check className="h-3 w-3" />
            </span>
          )}
          {!spellAccess.accessible && !learned && (
            <span className="absolute -right-1 -top-1 flex h-5 w-5 items-center justify-center rounded-full border border-[var(--arc-border)] bg-[var(--arc-surface)] text-[var(--arc-muted)]">
              <Lock className="h-3 w-3" />
            </span>
          )}
        </span>
        <span className={`max-w-full truncate text-xs font-semibold ${isCapstone ? 'text-[var(--arc-accent)]' : 'text-[var(--arc-text)]'}`}>
          {spell.name}
        </span>
        {isCapstone && (
          <span className="text-[9px] font-bold uppercase tracking-[0.18em] text-[var(--arc-muted)]">
            Nodo culminante · Nv. {spellAccess.requiredMastery}
          </span>
        )}
        <div className="flex flex-wrap items-center justify-center gap-1">{actions}</div>
        {details}
      </div>
    );
  }

  return (
    <div
      className={`rounded-lg border p-2.5 ${
        learned
          ? 'border-[#9ad489]/60 bg-[var(--arc-raised)]'
          : spellAccess.accessible
            ? 'border-[var(--arc-accent)]/60 bg-[var(--arc-raised)]'
            : 'border-[var(--arc-border)]'
      }`}
    >
      <div className="flex flex-wrap items-center justify-between gap-2">
        <div className="flex min-w-0 items-center gap-2">
          <span
            aria-hidden="true"
            className="flex h-7 w-7 shrink-0 items-center justify-center rounded-md border"
            style={{
              color: iconColor,
              borderColor: `${iconColor}66`,
              backgroundColor: `${iconColor}14`,
            }}
          >
            {spellImageIcon ? (
              <img src={spellImageIcon} alt="" className="h-8 w-8 object-contain" />
            ) : (
              <SpellIcon className="h-4 w-4" />
            )}
          </span>
          <span className="font-semibold text-[var(--arc-text)]">{spell.name}</span>
        </div>
        <div className="flex shrink-0 flex-wrap items-center gap-1.5">{actions}</div>
      </div>
      {details}
    </div>
  );
}

interface KnowledgeTreeNetworkProps {
  branches: KnowledgeBranch[];
  disciplineColor: string;
  capstoneNode?: ReactNode;
  renderNode: (spellId: string) => ReactNode;
}

function KnowledgeTreeNetwork({
  branches,
  disciplineColor,
  capstoneNode,
  renderNode,
}: KnowledgeTreeNetworkProps) {
  const maxBranchLength = Math.max(0, ...branches.map((branch) => branch.spellIds.length));
  const nodeSpacing = 112;
  const firstNodeY = 84;
  const capstoneY = firstNodeY + maxBranchLength * nodeSpacing;
  const height = capstoneNode
    ? capstoneY + 110
    : firstNodeY + Math.max(0, maxBranchLength - 1) * nodeSpacing + 110;
  const minWidth = Math.max(620, branches.length * 260);

  return (
    <div className="overflow-x-auto pb-3">
      <div
        className="relative mx-auto"
        style={{ minWidth: `${minWidth}px`, height: `${height}px` }}
      >
        <svg
          aria-hidden="true"
          className="pointer-events-none absolute inset-0 z-0 h-full w-full"
          viewBox={`0 0 1000 ${height}`}
          preserveAspectRatio="none"
        >
          <g
            fill="none"
            stroke={disciplineColor}
            strokeOpacity="0.5"
            strokeWidth="2"
            vectorEffect="non-scaling-stroke"
          >
            {branches.map((branch, branchIndex) => {
              const x = ((branchIndex + 0.5) / branches.length) * 1000;
              const lastNodeY = firstNodeY + (branch.spellIds.length - 1) * nodeSpacing;
              return (
                <g key={branch.id}>
                  <path d={`M 500 0 C 500 38 ${x} 38 ${x} ${firstNodeY}`} />
                  {branch.spellIds.slice(1).map((spellId, index) => {
                    const y = firstNodeY + index * nodeSpacing;
                    return <path key={`${spellId}-edge`} d={`M ${x} ${y} V ${y + nodeSpacing}`} />;
                  })}
                  {capstoneNode && branch.spellIds.length > 0 && (
                    <path
                      d={`M ${x} ${lastNodeY} C ${x} ${capstoneY - 30} 500 ${capstoneY - 30} 500 ${capstoneY}`}
                    />
                  )}
                </g>
              );
            })}
          </g>
        </svg>

        {branches.map((branch, branchIndex) => (
          <section
            key={branch.id}
            className="absolute top-0 z-10 flex h-full flex-col items-center"
            style={{
              left: `${(branchIndex / branches.length) * 100}%`,
              width: `${100 / branches.length}%`,
            }}
          >
            <h4 className="absolute top-7 max-w-[90%] truncate text-center text-[10px] font-bold uppercase tracking-[0.14em] text-[var(--arc-accent)]">
              {branch.label}
            </h4>
            {branch.spellIds.map((spellId, nodeIndex) => (
              <div
                key={spellId}
                className="absolute flex w-full justify-center"
                style={{ top: `${firstNodeY + nodeIndex * nodeSpacing - 28}px` }}
              >
                {renderNode(spellId)}
              </div>
            ))}
          </section>
        ))}

        {capstoneNode && (
          <div
            className="absolute left-1/2 z-20 flex -translate-x-1/2 justify-center"
            style={{ top: `${capstoneY - 38}px` }}
          >
            {capstoneNode}
          </div>
        )}
      </div>
    </div>
  );
}

export function KnowledgeTreePanel({
  spells,
  activeCharacter,
  settings,
  onLearnSpell,
  onSetDisciplineMastery,
  onToggleDisciplineDiscovery,
  onUpdateSettings,
  onGoToGrimorio,
}: KnowledgeTreePanelProps) {
  const [gmMode, setGmMode] = useState(false);
  const [treeViewMode, setTreeViewMode] = useState<'graph' | 'list'>('graph');
  const [expandedSpellIds, setExpandedSpellIds] = useState<Set<string>>(new Set());
  const [notice, setNotice] = useState<string | null>(null);

  const spellsById = useMemo(
    () => new Map(spells.map((spell) => [spell.id, spell])),
    [spells]
  );
  const metadataBySpellId = useMemo(
    () => new Map(KNOWLEDGE_SPELL_METADATA.map((metadata) => [metadata.spellId, metadata])),
    []
  );
  const knownSpellIds = useMemo(
    () => new Set(activeCharacter?.knownSpells || []),
    [activeCharacter?.knownSpells]
  );
  const discoveredDisciplines = useMemo(
    () => new Set(activeCharacter?.discoveredKnowledgeDisciplines || []),
    [activeCharacter?.discoveredKnowledgeDisciplines]
  );

  const updateDisciplineRequirements = (
    disciplineId: string,
    requirements: KnowledgeTreeSettings['accessRequirementsByDiscipline'][string]
  ) => {
    onUpdateSettings({
      ...settings,
      accessRequirementsByDiscipline: {
        ...settings.accessRequirementsByDiscipline,
        [disciplineId]: requirements,
      },
    });
  };

  const updateSpellMasteryRequirement = (spellId: string, value: string) => {
    const masteryRequirementsBySpell = { ...settings.masteryRequirementsBySpell };
    if (value === 'default') {
      delete masteryRequirementsBySpell[spellId];
    } else {
      masteryRequirementsBySpell[spellId] = Number(value);
    }
    onUpdateSettings({ ...settings, masteryRequirementsBySpell });
  };

  return (
    <section className="space-y-4">
      <header className="flex flex-col gap-3 rounded-xl border border-[var(--arc-border)] bg-[var(--arc-surface)] p-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <div className="flex flex-wrap items-center gap-2">
            <h2 className="font-display text-lg font-bold text-[var(--arc-accent)]">
              Disciplinas de conocimiento
            </h2>
            <span className="text-xs text-[var(--arc-muted)]">
              {KNOWLEDGE_SPELL_METADATA.length} técnicas · progreso separado del combate
            </span>
          </div>
          <p className="mt-1 max-w-3xl text-xs leading-relaxed text-[var(--arc-muted)]">
            La maestría de disciplina la administra el DJ y no se deduce de la posición del hechizo ni
            de la cantidad aprendida. Habilitar una disciplina no añade hechizos al grimorio.
          </p>
        </div>
        <div className="flex flex-wrap items-center gap-2">
          <div className="inline-flex rounded-lg border border-[var(--arc-border)] p-0.5">
            <button
              type="button"
              aria-pressed={treeViewMode === 'graph'}
              onClick={() => setTreeViewMode('graph')}
              className={`min-h-[30px] inline-flex items-center gap-1 rounded-md px-2 text-xs font-semibold ${
                treeViewMode === 'graph'
                  ? 'bg-[var(--arc-action)] text-[var(--arc-action-text)]'
                  : 'text-[var(--arc-muted)] hover:text-[var(--arc-text)]'
              }`}
            >
              <Network className="h-3.5 w-3.5" />
              Mapa
            </button>
            <button
              type="button"
              aria-pressed={treeViewMode === 'list'}
              onClick={() => setTreeViewMode('list')}
              className={`min-h-[30px] inline-flex items-center gap-1 rounded-md px-2 text-xs font-semibold ${
                treeViewMode === 'list'
                  ? 'bg-[var(--arc-action)] text-[var(--arc-action-text)]'
                  : 'text-[var(--arc-muted)] hover:text-[var(--arc-text)]'
              }`}
            >
              <List className="h-3.5 w-3.5" />
              Lista
            </button>
          </div>
          <button
            type="button"
            onClick={onGoToGrimorio}
            className="min-h-[34px] rounded-lg border border-[var(--arc-border)] px-3 text-xs font-semibold text-[var(--arc-text)] hover:bg-[var(--arc-raised)]"
          >
            Ver Grimorio
          </button>
          <button
            type="button"
            disabled={!activeCharacter}
            onClick={() => setGmMode((value) => !value)}
            className={`min-h-[34px] inline-flex items-center gap-1.5 rounded-lg border px-3 text-xs font-semibold transition-colors disabled:opacity-40 ${
              gmMode
                ? 'border-[var(--arc-accent)] bg-[var(--arc-action)] text-[var(--arc-action-text)]'
                : 'border-[var(--arc-border)] text-[var(--arc-accent)] hover:bg-[var(--arc-raised)]'
            }`}
          >
            <KeyRound className="h-3.5 w-3.5" />
            {gmMode ? 'Control del DJ: activo' : 'Control del DJ'}
          </button>
        </div>
      </header>

      {notice && (
        <div
          role="status"
          className="flex items-center justify-between gap-3 rounded-lg border border-[var(--arc-border)] bg-[var(--arc-surface)] px-3 py-2 text-xs text-[var(--arc-text)]"
        >
          <span>{notice}</span>
          <button
            type="button"
            onClick={() => setNotice(null)}
            className="text-[var(--arc-muted)] hover:text-[var(--arc-text)]"
          >
            Cerrar
          </button>
        </div>
      )}

      {gmMode && activeCharacter && (
        <div className="rounded-xl border border-[var(--arc-accent)]/50 bg-[var(--arc-surface)] p-4 text-xs text-[var(--arc-muted)]">
          El DJ puede modificar los requisitos, ajustar maestrías y abrir o cerrar disciplinas.
          Deshabilitar contenido no elimina hechizos ya aprendidos.
        </div>
      )}

      {!activeCharacter && (
        <div className="rounded-xl border border-[var(--arc-border)] bg-[var(--arc-surface)] p-5 text-sm text-[var(--arc-muted)]">
          Seleccioná un personaje para consultar o administrar su progreso.
        </div>
      )}

      <div className="grid gap-4">
        {KNOWLEDGE_DISCIPLINES.map((discipline) => {
          const access = getKnowledgeDisciplineAccess(discipline, activeCharacter, settings);
          const isDisabled = settings.disabledDisciplineIds.includes(discipline.id);
          const isDiscovered = discoveredDisciplines.has(discipline.id);
          const mastery = activeCharacter?.knowledgeMastery?.[discipline.id] || 0;
          const requirements = getKnowledgeRequirements(discipline, settings);
          const orderedBranches = getKnowledgeBranches(discipline, settings);
          const renderSpellNode = (
            spellId: string,
            presentation: 'map' | 'list',
            isCapstone = false
          ) => {
            const spell = spellsById.get(spellId);
            const metadata = metadataBySpellId.get(spellId);
            if (!spell || !metadata) return null;
            return (
              <KnowledgeSpellNode
                key={spell.id}
                spell={spell}
                metadata={metadata}
                character={activeCharacter}
                settings={settings}
                learned={knownSpellIds.has(spell.id)}
                expanded={expandedSpellIds.has(spell.id)}
                isCapstone={isCapstone}
                gmMode={gmMode}
                presentation={presentation}
                onToggleDetails={() =>
                  setExpandedSpellIds((previous) => {
                    const next = new Set(previous);
                    if (next.has(spell.id)) next.delete(spell.id);
                    else next.add(spell.id);
                    return next;
                  })
                }
                onLearnSpell={(id) => setNotice(onLearnSpell(id))}
                onGoToGrimorio={onGoToGrimorio}
                onUpdateSettings={onUpdateSettings}
              />
            );
          };
          const capstoneNode = discipline.capstoneSpellId
            ? renderSpellNode(discipline.capstoneSpellId, 'map', true)
            : null;

          return (
            <article
              key={discipline.id}
              className={`space-y-4 rounded-xl border bg-[var(--arc-surface)] p-4 ${
                isDisabled
                  ? 'border-[var(--arc-border)] opacity-70'
                  : 'border-[var(--arc-border)]'
              }`}
            >
              <div className="flex flex-wrap items-start justify-between gap-3 border-b border-[var(--arc-border)] pb-3">
                <div>
                  <div className="flex flex-wrap items-center gap-2">
                    <h3 className="font-display text-lg font-bold text-[var(--arc-text)]">
                      {discipline.label}
                    </h3>
                    <span className="rounded-full border border-[var(--arc-border)] px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-[var(--arc-muted)]">
                      {DISCIPLINE_KIND_LABELS[discipline.kind]}
                    </span>
                    {!access.accessible && (
                      <span className="inline-flex items-center gap-1 text-[11px] font-semibold text-[#e09b7d]">
                        <Lock className="h-3 w-3" />
                        Bloqueada
                      </span>
                    )}
                  </div>
                  <p className="mt-1 text-xs leading-relaxed text-[var(--arc-muted)]">
                    {discipline.description}
                  </p>
                  <p className="mt-1 text-[11px] text-[var(--arc-muted)]">
                    {access.reason}
                  </p>
                  {requirements.length > 0 && (
                    <p className="mt-1 text-[11px] text-[var(--arc-muted)]">
                      Ruta actual: {requirements.map((requirement) => {
                        const requiredDiscipline = KNOWLEDGE_DISCIPLINES.find(
                          (entry) => entry.id === requirement.disciplineId
                        );
                        return `${requiredDiscipline?.label || requirement.disciplineId} Nv. ${requirement.minimumMastery}`;
                      }).join(' + ')}
                    </p>
                  )}
                  {isDiscovered && (
                    <p className="mt-1 text-[11px] font-semibold text-[#9ad489]">
                      Habilitada manualmente por el DJ; no se aprendieron hechizos.
                    </p>
                  )}
                </div>

                {gmMode && activeCharacter && (
                  <div className="flex flex-wrap items-center gap-2">
                    <label className="flex items-center gap-1.5 text-[11px] text-[var(--arc-muted)]">
                      Maestría
                      <select
                        aria-label={`Maestría de ${discipline.label}`}
                        value={mastery}
                        onChange={(event) =>
                          onSetDisciplineMastery(discipline.id, Number(event.target.value))
                        }
                        className="min-h-[30px] rounded-md border border-[var(--arc-border)] bg-[var(--arc-input)] px-2 text-[var(--arc-text)]"
                      >
                        {[0, 1, 2, 3].map((level) => (
                          <option key={level} value={level}>
                            Nv. {level}
                          </option>
                        ))}
                      </select>
                    </label>
                    <button
                      type="button"
                      disabled={isDisabled}
                      onClick={() => onToggleDisciplineDiscovery(discipline.id, !isDiscovered)}
                      className="min-h-[30px] rounded-md border border-[var(--arc-border)] px-2 text-[11px] font-semibold text-[var(--arc-accent)] hover:bg-[var(--arc-raised)] disabled:opacity-40"
                    >
                      {isDiscovered ? 'Revocar acceso manual' : 'Habilitar manualmente'}
                    </button>
                    <button
                      type="button"
                      onClick={() =>
                        onUpdateSettings({
                          ...settings,
                          disabledDisciplineIds: toggleId(
                            settings.disabledDisciplineIds,
                            discipline.id,
                            !isDisabled
                          ),
                        })
                      }
                      className="min-h-[30px] rounded-md border border-[var(--arc-border)] px-2 text-[11px] font-semibold text-[var(--arc-text)] hover:bg-[var(--arc-raised)]"
                    >
                      {isDisabled ? 'Habilitar disciplina' : 'Deshabilitar disciplina'}
                    </button>
                  </div>
                )}
              </div>

              {gmMode && (
                <div className="space-y-2 rounded-lg border border-[var(--arc-border)] p-3">
                  <p className="font-semibold text-[var(--arc-text)]">Requisitos de descubrimiento</p>
                  {requirements.map((requirement, index) => (
                    <div
                      key={`${discipline.id}-${requirement.disciplineId}-${index}`}
                      className="flex flex-wrap items-center gap-2"
                    >
                      <select
                        aria-label={`Disciplina requerida para ${discipline.label}`}
                        value={requirement.disciplineId}
                        onChange={(event) => {
                          const next = [...requirements];
                          next[index] = { ...requirement, disciplineId: event.target.value };
                          updateDisciplineRequirements(discipline.id, next);
                        }}
                        className="min-h-[30px] rounded-md border border-[var(--arc-border)] bg-[var(--arc-input)] px-2 text-[var(--arc-text)]"
                      >
                        {KNOWLEDGE_DISCIPLINES.filter((entry) => entry.id !== discipline.id).map(
                          (entry) => (
                            <option key={entry.id} value={entry.id}>
                              {entry.label}
                            </option>
                          )
                        )}
                      </select>
                      <span className="text-[var(--arc-muted)]">maestría</span>
                      <select
                        aria-label={`Nivel de maestría requerido para ${discipline.label}`}
                        value={requirement.minimumMastery}
                        onChange={(event) => {
                          const next = [...requirements];
                          next[index] = {
                            ...requirement,
                            minimumMastery: Number(event.target.value),
                          };
                          updateDisciplineRequirements(discipline.id, next);
                        }}
                        className="min-h-[30px] rounded-md border border-[var(--arc-border)] bg-[var(--arc-input)] px-2 text-[var(--arc-text)]"
                      >
                        {[0, 1, 2, 3].map((level) => (
                          <option key={level} value={level}>
                            Nv. {level}
                          </option>
                        ))}
                      </select>
                      <button
                        type="button"
                        aria-label={`Quitar requisito de ${discipline.label}`}
                        onClick={() =>
                          updateDisciplineRequirements(
                            discipline.id,
                            requirements.filter((_, requirementIndex) => requirementIndex !== index)
                          )
                        }
                        className="rounded-md px-2 py-1 text-[11px] text-[#e09b7d] hover:bg-[var(--arc-raised)]"
                      >
                        Quitar
                      </button>
                    </div>
                  ))}
                  <button
                    type="button"
                    onClick={() => {
                      const nextRequirement = KNOWLEDGE_DISCIPLINES.find(
                        (entry) =>
                          entry.id !== discipline.id &&
                          !requirements.some((requirement) => requirement.disciplineId === entry.id)
                      );
                      if (nextRequirement) {
                        updateDisciplineRequirements(discipline.id, [
                          ...requirements,
                          { disciplineId: nextRequirement.id, minimumMastery: 1 },
                        ]);
                      }
                    }}
                    disabled={
                      requirements.length >= KNOWLEDGE_DISCIPLINES.length - 1
                    }
                    className="inline-flex min-h-[28px] items-center gap-1 rounded-md px-2 text-[11px] font-semibold text-[var(--arc-accent)] hover:bg-[var(--arc-raised)] disabled:opacity-40"
                  >
                    <Plus className="h-3 w-3" />
                    Agregar requisito
                  </button>
                  {requirements.length === 0 && (
                    <p className="text-[11px] text-[var(--arc-muted)]">
                      Sin requisitos de maestría.
                    </p>
                  )}
                </div>
              )}

              {treeViewMode === 'graph' && (
                <div className="flex justify-center">
                  <div
                    className={`inline-flex items-center gap-2 rounded-full border px-5 py-2 ${
                      access.accessible
                        ? 'border-[var(--arc-accent)]/70 bg-[var(--arc-raised)]'
                        : 'border-[var(--arc-border)] bg-[var(--arc-surface)]'
                    }`}
                  >
                    <span className="flex h-8 w-8 items-center justify-center rounded-full border border-[var(--arc-accent)] text-[var(--arc-accent)]">
                      <Sparkles className="h-4 w-4" />
                    </span>
                    <span>
                      <span className="block text-sm font-bold text-[var(--arc-text)]">
                        {discipline.label}
                      </span>
                      <span className="block text-[10px] text-[var(--arc-muted)]">
                        {DISCIPLINE_KIND_LABELS[discipline.kind]}
                      </span>
                    </span>
                  </div>
                </div>
              )}

              {treeViewMode === 'graph' && (
                <KnowledgeTreeNetwork
                  branches={orderedBranches}
                  disciplineColor={DISCIPLINE_ICON_COLORS[discipline.id] || '#c9a66b'}
                  capstoneNode={capstoneNode}
                  renderNode={(spellId) => renderSpellNode(spellId, 'map')}
                />
              )}

              {treeViewMode === 'list' && (
                <div className="space-y-4">
                <div className="space-y-4">
                <div className="space-y-4">
                {orderedBranches.map((branch, branchIndex) => (
                  <section
                    key={branch.id}
                    className="space-y-2"
                  >
                    <div className="flex items-center justify-between gap-2">
                      <h4 className="text-xs font-bold uppercase tracking-wide text-[var(--arc-accent)]">
                        {branch.label}
                      </h4>
                      {gmMode && (
                        <div className="flex items-center">
                          <button
                            type="button"
                            disabled={branchIndex === 0}
                            aria-label={`Mover ${branch.label} arriba`}
                            onClick={() => {
                              const next = [...orderedBranches];
                              [next[branchIndex - 1], next[branchIndex]] = [
                                next[branchIndex],
                                next[branchIndex - 1],
                              ];
                              onUpdateSettings({
                                ...settings,
                                branchOrderByDiscipline: {
                                  ...settings.branchOrderByDiscipline,
                                  [discipline.id]: next.map((item) => item.id),
                                },
                              });
                            }}
                            className="rounded p-1 text-[var(--arc-muted)] hover:bg-[var(--arc-raised)] disabled:opacity-30"
                          >
                            <ArrowUp className="h-3 w-3" />
                          </button>
                          <button
                            type="button"
                            disabled={branchIndex === orderedBranches.length - 1}
                            aria-label={`Mover ${branch.label} abajo`}
                            onClick={() => {
                              const next = [...orderedBranches];
                              [next[branchIndex], next[branchIndex + 1]] = [
                                next[branchIndex + 1],
                                next[branchIndex],
                              ];
                              onUpdateSettings({
                                ...settings,
                                branchOrderByDiscipline: {
                                  ...settings.branchOrderByDiscipline,
                                  [discipline.id]: next.map((item) => item.id),
                                },
                              });
                            }}
                            className="rounded p-1 text-[var(--arc-muted)] hover:bg-[var(--arc-raised)] disabled:opacity-30"
                          >
                            <ArrowDown className="h-3 w-3" />
                          </button>
                        </div>
                      )}
                    </div>
                    <div className="space-y-2">
                      {branch.spellIds.map((spellId) => {
                        const spell = spellsById.get(spellId);
                        const metadata = metadataBySpellId.get(spellId);
                        if (!spell || !metadata) return null;

                        const learned = knownSpellIds.has(spell.id);
                        const SpellIcon = SPELL_ICONS[spell.id] || Sparkles;
                        const iconColor =
                          DISCIPLINE_ICON_COLORS[metadata.disciplineId] || '#c9a66b';
                        const spellAccess = getKnowledgeSpellAccess(
                          metadata,
                          activeCharacter,
                          settings
                        );
                        const isSpellDisabled = settings.disabledSpellIds.includes(spell.id);
                        const isExpanded = expandedSpellIds.has(spell.id);
                        const damageDice = spell.damage.dice
                          .filter((die) => die.count > 0)
                          .map((die) => `${die.count}${die.type}`)
                          .join(' + ');

                        return (
                          <div key={spell.id}>
                            <div
                              className={`rounded-lg border p-2.5 ${
                                learned
                                  ? 'border-[#9ad489]/60 bg-[var(--arc-raised)]'
                                  : spellAccess.accessible
                                    ? 'border-[var(--arc-accent)]/60 bg-[var(--arc-raised)]'
                                    : 'border-[var(--arc-border)]'
                              }`}
                            >
                              <div className="flex flex-wrap items-center justify-between gap-2">
                                <div className="flex min-w-0 items-center gap-2">
                                  <span
                                    aria-hidden="true"
                                    className="flex h-7 w-7 shrink-0 items-center justify-center rounded-md border"
                                    style={{
                                      color: iconColor,
                                      borderColor: `${iconColor}66`,
                                      backgroundColor: `${iconColor}14`,
                                    }}
                                  >
                                    <SpellIcon className="h-4 w-4" />
                                  </span>
                                  <span className="font-semibold text-[var(--arc-text)]">
                                    {spell.name}
                                  </span>
                                </div>
                                {treeViewMode === 'list' && learned && (
                                  <span className="inline-flex items-center gap-1 text-[10px] font-semibold text-[#9ad489]">
                                    <Check className="h-3 w-3" />
                                    En grimorio
                                  </span>
                                )}
                                <div className="flex shrink-0 flex-wrap items-center gap-1.5">
                                  <button
                                    type="button"
                                    aria-expanded={isExpanded}
                                    aria-controls={`knowledge-details-${spell.id}`}
                                    onClick={() =>
                                      setExpandedSpellIds((previous) => {
                                        const next = new Set(previous);
                                        if (next.has(spell.id)) next.delete(spell.id);
                                        else next.add(spell.id);
                                        return next;
                                      })
                                    }
                                    className="min-h-[28px] inline-flex items-center gap-1 rounded-md px-2 text-[11px] font-semibold text-[var(--arc-accent)] hover:bg-[var(--arc-surface)]"
                                  >
                                    {isExpanded ? 'Ocultar' : 'Detalles'}
                                    <ChevronDown
                                      className={`h-3 w-3 transition-transform ${
                                        isExpanded ? 'rotate-180' : ''
                                      }`}
                                    />
                                  </button>
                                  {learned ? (
                                    <button
                                      type="button"
                                      onClick={onGoToGrimorio}
                                      className="min-h-[28px] inline-flex items-center gap-1 rounded-md border border-[var(--arc-border)] px-2 text-[11px] font-semibold text-[var(--arc-text)] hover:bg-[var(--arc-surface)]"
                                    >
                                      <BookOpen className="h-3 w-3" />
                                      Grimorio
                                    </button>
                                  ) : (
                                    <button
                                      type="button"
                                      disabled={!spellAccess.accessible}
                                      onClick={() => setNotice(onLearnSpell(spell.id))}
                                      className="min-h-[28px] inline-flex items-center gap-1 rounded-md bg-[var(--arc-action)] px-2 text-[11px] font-semibold text-[var(--arc-action-text)] hover:bg-[var(--arc-action-hover)] disabled:cursor-not-allowed disabled:opacity-40"
                                    >
                                      <Sparkles className="h-3 w-3" />
                                      Aprender
                                    </button>
                                  )}
                                </div>
                              </div>

                              {isExpanded && (
                                <div
                                  id={`knowledge-details-${spell.id}`}
                                  className="mt-2 space-y-2 border-t border-[var(--arc-border)] pt-2"
                                >
                                  <p className="text-xs leading-relaxed text-[var(--arc-muted)]">
                                    {spell.effectDescription}
                                  </p>
                                  <div className="flex flex-wrap gap-x-3 gap-y-1 text-[10px] text-[var(--arc-muted)]">
                                    <span>{spell.manaCost} maná</span>
                                    <span>Maestría requerida: Nv. {spellAccess.requiredMastery}</span>
                                    <span>Duración: {spell.duration}</span>
                                    {damageDice && (
                                      <span>
                                        Daño {spell.damageKind === 'fisico' ? 'físico' : 'mágico'}: {damageDice}
                                        {spell.damage.bonus !== 0 &&
                                          ` ${spell.damage.bonus > 0 ? '+' : '−'} ${Math.abs(spell.damage.bonus)}`}
                                      </span>
                                    )}
                                    {spell.assuredSuccess > 0 && (
                                      <span>Éxitos asegurados: +{spell.assuredSuccess}</span>
                                    )}
                                    {spell.orders.length > 0 && (
                                      <span>Órdenes: {spell.orders.join(', ')}</span>
                                    )}
                                    {spell.statuses.length > 0 && (
                                      <span>Estados: {spell.statuses.join(', ')}</span>
                                    )}
                                    {spell.elementalStatus && (
                                      <span>
                                        Estado elemental: {spell.elementalStatus.kind} ·{' '}
                                        {spell.elementalStatus.stacks} carga(s),{' '}
                                        {spell.elementalStatus.durationTurns} turnos
                                      </span>
                                    )}
                                    {spell.areaConfig?.enabled && (
                                      <span>
                                        Área: {spell.areaConfig.shapeNote || spell.areaConfig.mode}
                                        {spell.areaConfig.maxTargets
                                          ? ` · hasta ${spell.areaConfig.maxTargets} objetivos`
                                          : ''}
                                      </span>
                                    )}
                                    {spell.armorConfig?.isArmor && (
                                      <span>
                                        Armadura: reduce {spell.armorConfig.damageReduction || 0}
                                        {spell.armorConfig.maxHits
                                          ? ` · ${spell.armorConfig.maxHits} impactos`
                                          : ''}
                                      </span>
                                    )}
                                  </div>
                                  {!learned && !spellAccess.accessible && (
                                    <p className="text-[11px] font-medium text-[#e09b7d]">
                                      {spellAccess.reason}
                                    </p>
                                  )}
                                  {learned && isSpellDisabled && (
                                    <p className="text-[11px] text-[var(--arc-muted)]">
                                      El DJ deshabilitó nuevas adquisiciones; el hechizo aprendido se conserva.
                                    </p>
                                  )}
                                  {gmMode && (
                                    <div className="flex flex-wrap items-center gap-2 border-t border-[var(--arc-border)] pt-2">
                                      <label className="flex items-center gap-1 text-[10px] text-[var(--arc-muted)]">
                                        Maestría mínima
                                        <select
                                          aria-label={`Maestría requerida para ${spell.name}`}
                                          value={
                                            settings.masteryRequirementsBySpell[spell.id] === undefined
                                              ? 'default'
                                              : settings.masteryRequirementsBySpell[spell.id]
                                          }
                                          onChange={(event) =>
                                            updateSpellMasteryRequirement(
                                              spell.id,
                                              event.target.value
                                            )
                                          }
                                          className="min-h-[28px] rounded-md border border-[var(--arc-border)] bg-[var(--arc-input)] px-1.5 text-[var(--arc-text)]"
                                        >
                                          <option value="default">
                                            Predet. ({metadata.minimumMastery})
                                          </option>
                                          {[0, 1, 2, 3].map((level) => (
                                            <option key={level} value={level}>
                                              {level}
                                            </option>
                                          ))}
                                        </select>
                                      </label>
                                      <button
                                        type="button"
                                        onClick={() =>
                                          onUpdateSettings({
                                            ...settings,
                                            disabledSpellIds: toggleId(
                                              settings.disabledSpellIds,
                                              spell.id,
                                              !isSpellDisabled
                                            ),
                                          })
                                        }
                                        className="min-h-[28px] rounded-md border border-[var(--arc-border)] px-2 text-[10px] font-semibold text-[var(--arc-text)] hover:bg-[var(--arc-surface)]"
                                      >
                                        {isSpellDisabled ? 'Rehabilitar' : 'Deshabilitar'}
                                      </button>
                                    </div>
                                  )}
                                </div>
                              )}
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  </section>
                ))}
                </div>
                </div>
              </div>
              )}

              {treeViewMode === 'list' && discipline.capstoneSpellId && (
                <section className="rounded-xl border border-[var(--arc-accent)]/50 bg-[var(--arc-raised)] p-4">
                  <h4 className="mb-3 text-center text-xs font-bold uppercase tracking-[0.16em] text-[var(--arc-accent)]">
                    Nodo culminante
                  </h4>
                  <div className="flex justify-center">
                    {renderSpellNode(discipline.capstoneSpellId, 'list', true)}
                  </div>
                </section>
              )}
            </article>
          );
        })}
      </div>
    </section>
  );
}
</file>

<file path="src/components/LogPanel.tsx">
import { useState } from 'react';
import { ArrowRight, BookOpen, Dices, Shield, Swords, Trash2 } from 'lucide-react';
import type { D6RollSummary, DamageRollSummary, LogClashOutcome, LogEntry } from '../types/rpg';
import { STAT_NAMES } from '../utils/dice';
import {
  getCombatMechanic,
  getMechanicsMentionedInLog,
  type CombatMechanicId,
} from '../utils/combatMechanics';
import type { CombatMechanicContext } from './CombatMechanicReader';

interface LogPanelProps {
  logs: LogEntry[];
  onClearLogs: () => void;
  onQuickRoll: (diceCount: number, assured: number) => void;
  onInspectMechanic?: (mechanicId: CombatMechanicId, context: CombatMechanicContext) => void;
}

function DiceRow({ summary, tone }: { summary: D6RollSummary; tone?: 'atk' | 'def' }) {
  const netClass =
    tone === 'atk'
      ? 'text-[var(--arc-atk-accent)]'
      : tone === 'def'
        ? 'text-[var(--arc-def-accent)]'
        : summary.net > 0
          ? 'text-[#a4d67e]'
          : summary.net < 0
            ? 'text-[#e08060]'
            : 'text-[#e2c275]';

  const metaTextClass =
    tone === 'atk'
      ? 'text-[var(--arc-atk-text)] opacity-85'
      : tone === 'def'
        ? 'text-[var(--arc-def-text)] opacity-85'
        : 'text-[var(--arc-muted)]';

  return (
    <div className="space-y-1.5">
      <div className="flex flex-wrap items-center gap-1.5">
        {summary.rolls.map((val, idx) => {
          const style =
            val === 1
              ? 'border-[#7a3020] bg-[#381811] text-[#ff9a7a]'
              : val >= 5
                ? 'border-[#4a7a30] bg-[#1e3818] text-[#c4f2a4]'
                : 'border-[var(--arc-border)] bg-[var(--arc-input)] text-[var(--arc-muted)]';
          return (
            <span
              key={idx}
              className={`font-mono-num inline-flex h-7 w-7 items-center justify-center rounded-md border text-xs font-bold ${style}`}
            >
              {val}
            </span>
          );
        })}
        {summary.assured > 0 && (
          <span className="font-mono-num inline-flex h-7 items-center justify-center rounded-md border border-dashed border-[#8a6a20] bg-[#332810] px-2 text-xs font-bold text-[#d4a843]">
            +{summary.assured} aseg.
          </span>
        )}
        {summary.statusAutoFails && summary.statusAutoFails > 0 && (
          <span
            title={summary.statusPenaltyNotes?.join(' · ') || 'Fallos automáticos por estado'}
            className="font-mono-num inline-flex h-7 items-center justify-center rounded-md border border-dashed border-[#8a3525] bg-[#361611] px-2 text-xs font-bold text-[#ff9a7a]"
          >
            +{summary.statusAutoFails} fallo{summary.statusAutoFails > 1 ? 's' : ''} auto.
          </span>
        )}
      </div>
      <div className={`text-xs font-mono-num ${metaTextClass}`}>
        {summary.breakdown && summary.breakdown.length > 0 && (
          <span className="mr-1.5 opacity-80">
            ({summary.breakdown.map((b) => `${STAT_NAMES[b.stat]} ${b.dice}d6`).join(' + ')}) ·
          </span>
        )}
        <span>{summary.successes} éxito(s)</span>
        {' · '}
        <span>{summary.fails} fallo(s)</span>
        {summary.statusPenaltyNotes && summary.statusPenaltyNotes.length > 0 && (
          <span className="text-[#ff9a7a]"> [{summary.statusPenaltyNotes.join(', ')}]</span>
        )}
        {' · Neto '}
        <strong className={netClass}>{summary.net > 0 ? `+${summary.net}` : summary.net}</strong>
      </div>
    </div>
  );
}

function DamageLine({ damageRoll }: { damageRoll: DamageRollSummary }) {
  return (
    <div className="text-[13px] font-mono-num text-[var(--arc-text)] rounded-lg bg-[var(--arc-input)]/75 px-3 py-2">
      {damageRoll.isCriticalHit && (
        <span className="mr-2 inline-flex items-center rounded bg-[#5e1c14] px-1.5 py-0.5 text-[11px] font-bold uppercase tracking-wide text-[#ffd6c9]">
          CRÍTICO AUTO{damageRoll.criticalReason ? ` · ${damageRoll.criticalReason}` : ''}
        </span>
      )}
      {damageRoll.damageKind && (
        <span
          className={`mr-2 font-semibold ${
            damageRoll.damageKind === 'magico'
              ? 'text-[var(--arc-magic-accent)]'
              : 'text-[var(--arc-phys-accent)]'
          }`}
        >
          [{damageRoll.damageKind === 'magico' ? 'Mágico' : 'Físico'}]
        </span>
      )}
      {damageRoll.isManual
        ? `Total manual: ${damageRoll.rawTotal ?? damageRoll.total}`
        : `${damageRoll.parts.join(' + ')}${damageRoll.bonus ? ` + ${damageRoll.bonus}` : ''} = ${
            damageRoll.rawTotal ?? damageRoll.total
          }`}
      {damageRoll.damageReduction && damageRoll.damageReduction > 0
        ? ` − ${damageRoll.damageReduction} reducción`
        : ''}
      {damageRoll.damageDivisor === 2
        ? ` ÷ 2 (resistencia)`
        : damageRoll.damageDivisor === 4
          ? ` ÷ 4 (resistencia)`
          : damageRoll.damageDivisor === 0
            ? ` → anulado por efecto`
            : ''}
      {(damageRoll.damageReduction && damageRoll.damageReduction > 0) ||
      (damageRoll.damageDivisor !== undefined && damageRoll.damageDivisor !== 1)
        ? ` = ${damageRoll.total}`
        : ''}
      {damageRoll.notes ? ` (${damageRoll.notes})` : ''}
      {damageRoll.burnStacksApplied && damageRoll.burnStacksApplied > 0 ? (
        <span className="ml-2 font-semibold text-[#ff935c]">
          [+{damageRoll.burnStacksApplied} Quemadura 1d4 · 2t]
        </span>
      ) : null}
    </div>
  );
}

function getClashVerdict(
  outcome?: LogClashOutcome,
  atkNet?: number,
  defNet?: number
): { label: string; toneClass: string } {
  if (outcome === 'defender_wins') {
    return { label: 'Bloqueado / Esquivado', toneClass: 'text-[var(--arc-def-accent)]' };
  }
  if (outcome === 'counterspell_success') {
    return { label: 'Hechizo anulado', toneClass: 'text-[var(--arc-def-accent)]' };
  }
  if (outcome === 'counterspell_fail') {
    return { label: 'Hechizo sostenido', toneClass: 'text-[var(--arc-atk-accent)]' };
  }
  if (outcome === 'tie_verify_damage') {
    return { label: 'Empate · Verificar daño', toneClass: 'text-[var(--arc-atk-accent)]' };
  }
  if (outcome === 'attacker_wins') {
    return { label: 'Impacta', toneClass: 'text-[var(--arc-atk-accent)]' };
  }
  if (typeof atkNet === 'number' && typeof defNet === 'number') {
    if (defNet > atkNet) {
      return { label: 'Bloqueado / Esquivado', toneClass: 'text-[var(--arc-def-accent)]' };
    }
    if (atkNet === defNet) {
      return { label: 'Empate · Verificar daño', toneClass: 'text-[var(--arc-atk-accent)]' };
    }
    return { label: 'Impacta', toneClass: 'text-[var(--arc-atk-accent)]' };
  }
  return { label: 'Enfrentamiento', toneClass: 'text-[var(--arc-accent)]' };
}

function MechanicLogLinks({
  entry,
  onInspectMechanic,
}: {
  entry: LogEntry;
  onInspectMechanic?: LogPanelProps['onInspectMechanic'];
}) {
  if (!onInspectMechanic) return null;
  const mentioned = getMechanicsMentionedInLog(
    [
      entry.title,
      entry.summaryText,
      entry.damageRoll?.notes,
      entry.clash?.attackerAction,
      entry.clash?.defenderAction,
    ]
      .filter(Boolean)
      .join(' ')
  );
  if (mentioned.length === 0) return null;

  return (
    <div className="flex flex-wrap items-center gap-1.5 pt-1">
      <span className="text-[11px] text-[var(--arc-muted)]">Consultar:</span>
      {mentioned.map((mechanicId) => (
        <button
          key={mechanicId}
          type="button"
          onClick={() =>
            onInspectMechanic(mechanicId, { source: 'history', logEntry: entry })
          }
          className="min-h-[28px] inline-flex items-center gap-1 rounded-md border border-[var(--arc-border)] bg-[var(--arc-surface)] px-2 text-[11px] font-semibold text-[var(--arc-accent)] hover:bg-[var(--arc-raised)]"
        >
          <BookOpen className="h-3 w-3" />
          {getCombatMechanic(mechanicId)?.name || 'Mecánica'}
        </button>
      ))}
    </div>
  );
}

export function LogPanel({ logs, onClearLogs, onQuickRoll, onInspectMechanic }: LogPanelProps) {
  const [quickDice, setQuickDice] = useState(2);
  const [quickAssured, setQuickAssured] = useState(0);

  return (
    <section className="rounded-xl border border-[var(--arc-border)] bg-[var(--arc-surface)] p-4 sm:p-5 space-y-4">
      <div className="flex flex-wrap items-center justify-between gap-2 border-b border-[var(--arc-border)] pb-3.5">
        <div>
          <h2 className="font-display text-lg sm:text-xl font-bold text-[var(--arc-accent)]">
            Historial y Dados Rápidos
          </h2>
          <p className="text-[13px] text-[var(--arc-muted)] mt-0.5">
            Registro cronológico de casteos, ataques, defensas y daños
          </p>
        </div>

        <button
          type="button"
          onClick={onClearLogs}
          className="min-h-[34px] inline-flex items-center gap-1.5 rounded-lg bg-transparent px-2.5 text-xs font-medium text-[var(--arc-muted)] hover:bg-[#361912] hover:text-[#e88a70] whitespace-nowrap shrink-0 transition-colors"
        >
          <Trash2 className="h-3.5 w-3.5" />
          Limpiar historial
        </button>
      </div>

      {/* Tirador rápido integrado (sin recuadro anidado) */}
      <div className="flex flex-wrap items-center justify-between gap-3 border-b border-[var(--arc-border)] pb-3.5">
        <div className="flex flex-wrap items-center gap-4 text-xs">
          <div className="flex items-center gap-1">
            <span className="text-[var(--arc-muted)] mr-1">Dados d6:</span>
            <button
              type="button"
              onClick={() => setQuickDice((n) => Math.max(1, n - 1))}
              className="min-h-[30px] w-7 rounded-md bg-transparent text-[var(--arc-text)] font-semibold hover:bg-[var(--arc-raised)] transition-colors"
            >
              −
            </button>
            <span className="font-mono-num w-6 text-center font-bold text-[var(--arc-accent)]">
              {quickDice}
            </span>
            <button
              type="button"
              onClick={() => setQuickDice((n) => Math.min(20, n + 1))}
              className="min-h-[30px] w-7 rounded-md bg-transparent text-[var(--arc-text)] font-semibold hover:bg-[var(--arc-raised)] transition-colors"
            >
              +
            </button>
          </div>

          <div className="flex items-center gap-1">
            <span className="text-[var(--arc-muted)] mr-1">Asegurados:</span>
            <button
              type="button"
              onClick={() => setQuickAssured((n) => Math.max(0, n - 1))}
              className="min-h-[30px] w-7 rounded-md bg-transparent text-[var(--arc-text)] font-semibold hover:bg-[var(--arc-raised)] transition-colors"
            >
              −
            </button>
            <span className="font-mono-num w-6 text-center font-bold text-[var(--arc-accent)]">
              {quickAssured}
            </span>
            <button
              type="button"
              onClick={() => setQuickAssured((n) => Math.min(10, n + 1))}
              className="min-h-[30px] w-7 rounded-md bg-transparent text-[var(--arc-text)] font-semibold hover:bg-[var(--arc-raised)] transition-colors"
            >
              +
            </button>
          </div>
        </div>

        <button
          type="button"
          onClick={() => onQuickRoll(quickDice, quickAssured)}
          className="min-h-[38px] inline-flex items-center gap-1.5 rounded-lg bg-[var(--arc-action)] px-4 text-xs font-semibold text-[var(--arc-action-text)] hover:bg-[var(--arc-action-hover)] shadow-sm whitespace-nowrap shrink-0 transition-colors"
        >
          <Dices className="h-3.5 w-3.5" />
          Tirar {quickDice}d6
        </button>
      </div>

      {/* Entradas del log */}
      {logs.length === 0 ? (
        <div className="rounded-lg bg-[var(--arc-surface-alt)] p-6 text-center text-[13px] text-[var(--arc-muted)]">
          Aún no se realizaron tiradas ni acciones de combate.
        </div>
      ) : (
        <div className="space-y-3 max-h-[560px] overflow-y-auto pr-1">
          {logs.map((entry) => {
            const clash = entry.clash;
            const isSplitDuel = Boolean(entry.attackRoll && entry.defenseRoll);

            // 1. Duelo completo (Atacante izquierda cálida vs Defensor derecha fría)
            if (isSplitDuel && entry.attackRoll && entry.defenseRoll) {
              const verdict = getClashVerdict(
                clash?.outcome,
                entry.attackRoll.net,
                entry.defenseRoll.net
              );
              const atkName = clash?.attackerName || 'Atacante';
              const defName = clash?.defenderName || 'Defensor';
              const dmgKind = clash?.damageKind || entry.damageRoll?.damageKind;

              return (
                <article
                  key={entry.id}
                  className="rounded-xl border border-[var(--arc-border)] bg-[var(--arc-surface-alt)] overflow-hidden"
                >
                  {/* Barra superior con veredicto y participantes */}
                  <div className="flex flex-wrap items-center justify-between gap-2 border-b border-[var(--arc-border)] bg-[var(--arc-surface)] px-3.5 py-2.5">
                    <div className="flex flex-wrap items-center gap-x-2 gap-y-0.5 text-xs">
                      <span className={`font-bold uppercase tracking-wide ${verdict.toneClass}`}>
                        {verdict.label}
                      </span>
                      <span className="text-[var(--arc-border-strong)]">·</span>
                      <span className="inline-flex items-center gap-1 font-semibold text-[var(--arc-atk-accent)]">
                        <Swords className="h-3 w-3 shrink-0" />
                        {atkName}
                      </span>
                      <ArrowRight className="h-3 w-3 text-[var(--arc-muted)] shrink-0" />
                      <span className="inline-flex items-center gap-1 font-semibold text-[var(--arc-def-accent)]">
                        <Shield className="h-3 w-3 shrink-0" />
                        {defName}
                      </span>
                      {dmgKind && (
                        <>
                          <span className="text-[var(--arc-border-strong)]">·</span>
                          <span
                            className={`font-semibold ${
                              dmgKind === 'magico'
                                ? 'text-[var(--arc-magic-accent)]'
                                : 'text-[var(--arc-phys-accent)]'
                            }`}
                          >
                            {dmgKind === 'magico' ? 'Mágico' : 'Físico'}
                          </span>
                        </>
                      )}
                    </div>
                    <span className="font-mono-num text-xs text-[var(--arc-muted)]">
                      {entry.timestamp}
                    </span>
                  </div>

                  {/* Dos columnas: Atacante (cálido) | Defensor (frío) */}
                  <div className="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-[var(--arc-border)]">
                    <div className="bg-[var(--arc-atk-bg)] p-3.5 space-y-2">
                      <div>
                        <div className="flex items-center justify-between gap-2">
                          <span className="inline-flex items-center gap-1 text-[11px] font-bold uppercase tracking-wider text-[var(--arc-atk-accent)]">
                            <Swords className="h-3 w-3 shrink-0" />
                            Ataca · {atkName}
                          </span>
                          <span className="font-mono-num text-sm font-bold text-[var(--arc-atk-accent)]">
                            {entry.attackRoll.net > 0
                              ? `+${entry.attackRoll.net}`
                              : entry.attackRoll.net}
                          </span>
                        </div>
                        {clash?.attackerAction && (
                          <div className="text-[13px] font-semibold text-[var(--arc-atk-text)] mt-0.5">
                            {clash.attackerAction}
                          </div>
                        )}
                      </div>
                      <DiceRow summary={entry.attackRoll} tone="atk" />
                    </div>

                    <div className="bg-[var(--arc-def-bg)] p-3.5 space-y-2">
                      <div>
                        <div className="flex items-center justify-between gap-2">
                          <span className="inline-flex items-center gap-1 text-[11px] font-bold uppercase tracking-wider text-[var(--arc-def-accent)]">
                            <Shield className="h-3 w-3 shrink-0" />
                            Defiende · {defName}
                          </span>
                          <span className="font-mono-num text-sm font-bold text-[var(--arc-def-accent)]">
                            {entry.defenseRoll.net > 0
                              ? `+${entry.defenseRoll.net}`
                              : entry.defenseRoll.net}
                          </span>
                        </div>
                        {clash?.defenderAction && (
                          <div className="text-[13px] font-semibold text-[var(--arc-def-text)] mt-0.5">
                            {clash.defenderAction}
                          </div>
                        )}
                      </div>
                      <DiceRow summary={entry.defenseRoll} tone="def" />
                    </div>
                  </div>

                  {/* Pie con daño y resumen */}
                  <div className="border-t border-[var(--arc-border)] px-3.5 py-2.5 space-y-1.5">
                    {entry.damageRoll && <DamageLine damageRoll={entry.damageRoll} />}
                    <p className="text-[13px] text-[var(--arc-text)] opacity-90 leading-relaxed">
                      {entry.summaryText}
                    </p>
                    {entry.manaNote && (
                      <p className="text-xs text-[var(--arc-magic-accent)]">{entry.manaNote}</p>
                    )}
                    {entry.masteryNote && (
                      <p className="text-xs font-medium text-[var(--arc-accent)]">
                        {entry.masteryNote}
                      </p>
                    )}
                    <MechanicLogLinks entry={entry} onInspectMechanic={onInspectMechanic} />
                  </div>
                </article>
              );
            }

            // 2. Entradas de rol individual (Ataque lanzado / Impacto directo / Protección / Prueba de defensa)
            const isSingleAttackRole =
              clash?.outcome === 'pending_defense' ||
              clash?.outcome === 'direct_hit' ||
              clash?.outcome === 'attacker_wins' ||
              (entry.kind === 'attack' && Boolean(entry.attackRoll));
            const isSingleDefenseRole =
              clash?.outcome === 'protection' ||
              clash?.outcome === 'defense_test' ||
              (entry.kind === 'defense' && !entry.attackRoll);

            if (isSingleAttackRole || isSingleDefenseRole) {
              const isAtk = isSingleAttackRole;
              const dmgKind = clash?.damageKind || entry.damageRoll?.damageKind;

              return (
                <article
                  key={entry.id}
                  className={`rounded-xl border p-4 space-y-2.5 ${
                    isAtk
                      ? 'border-[var(--arc-atk-border)] bg-[var(--arc-atk-bg)]'
                      : 'border-[var(--arc-def-border)] bg-[var(--arc-def-bg)]'
                  }`}
                >
                  <div className="flex flex-wrap items-center justify-between gap-2">
                    <div className="flex flex-wrap items-center gap-2 text-xs">
                      <span
                        className={`inline-flex items-center gap-1 font-bold uppercase tracking-wider ${
                          isAtk ? 'text-[var(--arc-atk-accent)]' : 'text-[var(--arc-def-accent)]'
                        }`}
                      >
                        {isAtk ? (
                          <Swords className="h-3.5 w-3.5 shrink-0" />
                        ) : (
                          <Shield className="h-3.5 w-3.5 shrink-0" />
                        )}
                        {isAtk ? 'Ataca' : 'Defiende'}
                      </span>

                      {clash?.attackerName && clash?.defenderName && (
                        <span className="inline-flex items-center gap-1.5 font-semibold">
                          <span className="text-[var(--arc-atk-accent)]">{clash.attackerName}</span>
                          <ArrowRight className="h-3 w-3 text-[var(--arc-muted)] shrink-0" />
                          <span className="text-[var(--arc-def-accent)]">{clash.defenderName}</span>
                        </span>
                      )}

                      {dmgKind && (
                        <span
                          className={`font-semibold ${
                            dmgKind === 'magico'
                              ? 'text-[var(--arc-magic-accent)]'
                              : 'text-[var(--arc-phys-accent)]'
                          }`}
                        >
                          · {dmgKind === 'magico' ? 'Mágico' : 'Físico'}
                        </span>
                      )}
                    </div>

                    <span className="font-mono-num text-xs text-[var(--arc-muted)]">
                      {entry.timestamp}
                    </span>
                  </div>

                  <h3
                    className={`text-[15px] font-bold ${
                      isAtk ? 'text-[var(--arc-atk-text)]' : 'text-[var(--arc-def-text)]'
                    }`}
                  >
                    {entry.title}
                  </h3>

                  {entry.attackRoll && <DiceRow summary={entry.attackRoll} tone="atk" />}
                  {entry.defenseRoll && <DiceRow summary={entry.defenseRoll} tone="def" />}
                  {entry.damageRoll && <DamageLine damageRoll={entry.damageRoll} />}

                  <p
                    className={`text-[13px] leading-relaxed ${
                      isAtk ? 'text-[var(--arc-atk-text)]' : 'text-[var(--arc-def-text)]'
                    } opacity-90`}
                  >
                    {entry.summaryText}
                  </p>

                  {entry.manaNote && (
                    <p className="text-xs text-[var(--arc-magic-accent)]">{entry.manaNote}</p>
                  )}
                  {entry.masteryNote && (
                    <p className="text-xs font-medium text-[var(--arc-accent)]">
                      {entry.masteryNote}
                    </p>
                  )}
                  <MechanicLogLinks entry={entry} onInspectMechanic={onInspectMechanic} />
                </article>
              );
            }

            // 3. Resto de entradas (casteos, curaciones, eventos, tiradas rápidas)
            const isMagicalEntry =
              Boolean(entry.isMagical) || entry.damageRoll?.damageKind === 'magico';
            const isPhysicalEntry =
              !isMagicalEntry &&
              (entry.damageRoll?.damageKind === 'fisico' ||
                (entry.isMagical === false && entry.kind === 'cast'));

            return (
              <article
                key={entry.id}
                className={`rounded-xl border p-4 space-y-2.5 ${
                  isMagicalEntry
                    ? 'border-[var(--arc-magic-border)] bg-[var(--arc-magic-bg)]'
                    : isPhysicalEntry
                      ? 'border-[var(--arc-phys-border)] bg-[var(--arc-phys-bg)]'
                      : 'border-[var(--arc-border)] bg-[var(--arc-surface-alt)]'
                }`}
              >
                <div className="flex items-baseline justify-between gap-2">
                  <h3
                    className={`text-[15px] font-bold ${
                      isMagicalEntry
                        ? 'text-[var(--arc-magic-accent)]'
                        : isPhysicalEntry
                          ? 'text-[var(--arc-phys-accent)]'
                          : 'text-[var(--arc-accent)]'
                    }`}
                  >
                    {entry.title}
                  </h3>
                  <span className="font-mono-num text-xs text-[var(--arc-muted)]">
                    {entry.timestamp}
                  </span>
                </div>

                {entry.castRoll && (
                  <div className="space-y-1">
                    <div className="text-xs font-semibold text-[#8fb56a]">Tirada de casteo</div>
                    <DiceRow summary={entry.castRoll} />
                  </div>
                )}

                {entry.damageRoll && <DamageLine damageRoll={entry.damageRoll} />}

                <p className="text-[13px] text-[var(--arc-text)] opacity-90 leading-relaxed">
                  {entry.summaryText}
                </p>

                {entry.manaNote && (
                  <p className="text-xs text-[var(--arc-magic-accent)]">{entry.manaNote}</p>
                )}

                {entry.masteryNote && (
                  <p className="text-xs font-medium text-[var(--arc-accent)]">
                    {entry.masteryNote}
                  </p>
                )}
                <MechanicLogLinks entry={entry} onInspectMechanic={onInspectMechanic} />
              </article>
            );
          })}
        </div>
      )}
    </section>
  );
}
