        <div class="form-group">
          <label>Efecto</label>
          <div class="effect-tabs">
            <button data-type="damage" class="active" id="tabDamage"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2.5 14.5 8l5.8-2.2-2.2 5.8 5.4 2.4-5.4 2.4 2.2 5.8-5.8-2.2L12 23.5l-2.5-5.5-5.8 2.2 2.2-5.8L.5 12l5.4-2.4-2.2-5.8L9.5 6z"/></svg> Daño</button>
            <button data-type="heal" id="tabHeal"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 4.8a5.5 5.5 0 0 0-7.8 0L12 5.9l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.3 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z"/><path d="M3.5 12h4l2-3 3.2 6 2-3h5.8"/></svg> Curación</button>
            <button data-type="effect" id="tabEffect"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 2 1.8 7.2L21 12l-7.2 1.8L12 21l-1.8-7.2L3 12l7.2-2.8L12 2Z"/><path d="m19 2 .7 2.3L22 5l-2.3.7L19 8l-.7-2.3L16 5l2.3-.7L19 2Z"/></svg> Efecto</button>
          </div>

          <div id="diceSection">
            <label style="font-size:.75rem;color:var(--text-dim);display:block;margin-bottom:6px" id="diceLabel">Dados de daño</label>
