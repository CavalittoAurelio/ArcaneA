                    <span
                      key={idx}
                      className={`h-2 w-6 rounded-full transition-colors ${
                        isAvailable ? 'bg-[var(--arc-accent)]' : 'bg-[var(--arc-raised)]'
                      }`}
                    />
                  );
                })}
              </div>
              {activeTurnStatus.used > activeTurnStatus.max && (
                <span className="font-mono-num text-xs text-[#ffd28a]">
