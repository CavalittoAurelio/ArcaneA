<file path="src/components/SpellInspector.tsx">
import { useEffect, useMemo, useState, type ReactNode } from 'react';
import {
  ArrowLeft,
  ArrowRight,
  Award,
  BookOpen,
  Clock3,
  Dices,
  Flame,
  Heart,
  Link2,
  Lock,
  MapPin,
  Sparkles,
  Target,
  X,
  Zap,
} from 'lucide-react';
import type { Character, FormulaConfig, Spell } from '../types/rpg';
import {
  AREA_MODE_LABELS,
  ELEMENTAL_STATUS_META,
  SPELL_CATEGORY_LABELS,
  STAT_NAMES,
  SYNERGY_LABELS,
  formatSpellDependencyLine,
  getCharacterStatDice,
  getEffectiveDefenseManaCost,
  getEffectiveSpellDamageDice,
  getEffectiveSpellDamageKind,
  getSpellCastRequirement,
  getSpellCategory,
  getSpellMasteryStatus,
  isSpellMagical,
  spellSupportsMastery,
} from '../utils/dice';
import { SpellCategoryIcon } from './SpellCategoryIcon';

export interface SpellInspectorAction {
  label: string;
  onClick: () => void;
  disabled?: boolean;
  reason?: string;
}

interface SpellInspectorProps {
  spell: Spell;
  spells: Spell[];
  activeCharacter?: Character;
  formula: FormulaConfig;
  presentation?: 'dialog' | 'embedded';
  onClose?: () => void;
  contextLabel?: string;
  compatibility?: { label: string; detail?: string; compatible: boolean };
  dependencyStatus?: { met: boolean; reason?: string };
  archivePrerequisiteStatus?: { name: string; learned: boolean };
  actions?: SpellInspectorAction[];
  onTestSpell?: (spell: Spell) => void;
}

function formatDice(
  spell: Spell,
  dice = spell.damage.dice,
  bonus = spell.damage.bonus
): string {
  const diceText = dice
    .filter((die) => die.count > 0)
    .map((die) => `${die.count}${die.type}`)
    .join(' + ');
  if (!diceText) return bonus ? `${bonus > 0 ? '+' : ''}${bonus}` : '';
  if (!bonus) return diceText;
  return `${diceText} ${bonus > 0 ? '+' : '−'} ${Math.abs(bonus)}`;
}

function InfoRow({
  label,
  children,
}: {
  label: string;
  children: ReactNode;
}) {
  return (
    <div className="flex flex-col gap-0.5 sm:flex-row sm:items-start sm:gap-3">
      <dt className="shrink-0 text-[11px] font-semibold uppercase tracking-wide text-[var(--arc-muted)] sm:w-36">
        {label}
      </dt>
      <dd className="min-w-0 text-sm text-[var(--arc-text)]">{children}</dd>
    </div>
  );
}

export function SpellInspector({
  spell,
  spells,
  activeCharacter,
  formula,
  presentation = 'dialog',
  onClose,
  contextLabel,
  compatibility,
  dependencyStatus,
  archivePrerequisiteStatus,
  actions = [],
  onTestSpell,
}: SpellInspectorProps) {
  const [currentSpell, setCurrentSpell] = useState(spell);
  const [history, setHistory] = useState<Spell[]>([]);
  const isEmbedded = presentation === 'embedded';
  const category = getSpellCategory(currentSpell);
  const magical =
    currentSpell.effectType === 'damage'
      ? getEffectiveSpellDamageKind(currentSpell) === 'magico'
      : isSpellMagical(currentSpell);
  const mastery = getSpellMasteryStatus(
    activeCharacter?.spellMastery?.[currentSpell.id] || 0,
    formula
  );
  const damageDice = getEffectiveSpellDamageDice(currentSpell, mastery);
  const effectiveMana = getEffectiveDefenseManaCost(activeCharacter, currentSpell);
  const castRequirement = getSpellCastRequirement(currentSpell);
  const castDice =
    currentSpell.castStat === 'none'
      ? 0
      : currentSpell.castStat === 'manual'
        ? currentSpell.manualCastDice
        : getCharacterStatDice(activeCharacter, currentSpell.castStat, formula);
  const combatDice = currentSpell.combatStats.reduce(
    (total, stat) => total + getCharacterStatDice(activeCharacter, stat, formula),
    0
  );
  const elementalMeta = currentSpell.elementalStatus
    ? ELEMENTAL_STATUS_META[currentSpell.elementalStatus.kind]
    : undefined;
  const learned = Boolean(
    activeCharacter &&
      (activeCharacter.knownSpells.includes(currentSpell.id) ||
        (currentSpell.catalogTemplateId &&
          activeCharacter.knownSpells.some((id) =>
            spells.some(
              (knownSpell) =>
                knownSpell.id === id &&
                knownSpell.catalogTemplateId === currentSpell.catalogTemplateId
            )
          )))
  );

  const relatedSpells = useMemo(() => {
    const related = new Map<string, { spell: Spell; reason: string }>();
    const add = (candidate: Spell | undefined, reason: string) => {
      if (!candidate || candidate.id === currentSpell.id || related.has(candidate.id)) return;
      related.set(candidate.id, { spell: candidate, reason });
    };
    const dependency = currentSpell.dependency?.enabled
      ? currentSpell.dependency
      : undefined;
    if (dependency) {
      add(
        spells.find(
          (candidate) =>
            candidate.id === dependency.requiredSpellId ||
            candidate.catalogTemplateId === dependency.requiredSpellId ||
            candidate.name === dependency.requiredName
        ),
        'Requisito de activación'
      );
    }
    for (const candidate of spells) {
      if (
        candidate.dependency?.enabled &&
        (candidate.dependency.requiredSpellId === currentSpell.id ||
          candidate.dependency.requiredSpellId === currentSpell.catalogTemplateId)
      ) {
        add(candidate,         'Habilita la activación de este hechizo');
      }
      if (
        currentSpell.catalogChainGroup &&
        candidate.catalogChainGroup === currentSpell.catalogChainGroup
      ) {
        add(candidate, 'Misma familia del Archivo');
      }
      if (
        currentSpell.synergyReaction &&
        currentSpell.synergyReaction !== 'none' &&
        candidate.synergyReaction === currentSpell.synergyReaction
      ) {
        add(candidate, 'Sinergia relacionada');
      }
    }
    return [...related.values()];
  }, [currentSpell, spells]);

  useEffect(() => {
    if (isEmbedded) {
      setCurrentSpell(spell);
      setHistory([]);
      return;
    }
  }, [isEmbedded, spell]);

  useEffect(() => {
    if (isEmbedded) return;
    const closeOnEscape = (event: KeyboardEvent) => {
      if (event.key === 'Escape') onClose?.();
    };
    window.addEventListener('keydown', closeOnEscape);
    return () => window.removeEventListener('keydown', closeOnEscape);
  }, [isEmbedded, onClose]);

  const navigateToSpell = (nextSpell: Spell) => {
    setHistory((previous) => [...previous, currentSpell]);
    setCurrentSpell(nextSpell);
  };

  const effectSummary =
    currentSpell.effectType === 'damage'
      ? formatDice(currentSpell, damageDice)
      : currentSpell.effectType === 'heal'
        ? formatDice(currentSpell)
        : '';
  const effectLabel =
    currentSpell.effectType === 'damage'
      ? 'Daño'
      : currentSpell.effectType === 'heal'
        ? 'Curación'
        : currentSpell.armorConfig?.isArmor
          ? 'Protección'
          : currentSpell.effectType === 'defense'
            ? 'Defensa'
            : 'Efecto';
  const currentActions = currentSpell.id === spell.id ? actions : [];
  const currentTestCallback = currentSpell.id === spell.id ? onTestSpell : undefined;
  const currentDependencyStatus =
    currentSpell.id === spell.id ? dependencyStatus : undefined;
  const explicitElement =
    currentSpell.armorConfig?.element || elementalMeta?.name;

  return (
    <div
      className={
        isEmbedded
          ? 'min-w-0 overflow-hidden rounded-xl border border-[var(--arc-border)] bg-[var(--arc-surface)]'
          : 'fixed inset-0 z-[80] flex items-end justify-center bg-black/70 p-0 backdrop-blur-sm sm:items-center sm:p-4'
      }
      onMouseDown={
        isEmbedded
          ? undefined
          : (event) => {
              if (event.target === event.currentTarget) onClose?.();
            }
      }
    >
      <section
        role={isEmbedded ? undefined : 'dialog'}
        aria-modal={isEmbedded ? undefined : true}
        aria-labelledby="spell-inspector-title"
        className={
          isEmbedded
            ? 'w-full overflow-hidden'
            : 'max-h-[94vh] w-full max-w-3xl overflow-hidden rounded-t-2xl border border-[var(--arc-border)] bg-[var(--arc-surface)] shadow-2xl sm:rounded-2xl'
        }
      >
        <header className="flex items-start gap-3 border-b border-[var(--arc-border)] px-4 py-4 sm:px-6">
          {history.length > 0 && (
            <button
              type="button"
              onClick={() => {
                const previous = history[history.length - 1];
                setHistory((items) => items.slice(0, -1));
                setCurrentSpell(previous);
              }}
              aria-label="Volver al hechizo anterior"
              className="mt-1 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-[var(--arc-muted)] hover:bg-[var(--arc-raised)] hover:text-[var(--arc-text)]"
            >
              <ArrowLeft className="h-4 w-4" />
            </button>
          )}
          <div className="min-w-0 flex-1">
            <div className="flex flex-wrap items-center gap-2 text-xs">
              <span className="inline-flex items-center gap-1 font-semibold text-[var(--arc-accent)]">
                <SpellCategoryIcon category={category} className="h-3.5 w-3.5" />
                {SPELL_CATEGORY_LABELS[category]}
              </span>
              <span className={magical ? 'text-[var(--arc-magic-accent)]' : 'text-[var(--arc-phys-accent)]'}>
                {magical ? 'Mágico' : 'Físico'}
              </span>
              {currentSpell.catalogChainGroup && (
                <span className="text-[var(--arc-muted)]">{currentSpell.catalogChainGroup}</span>
              )}
              {explicitElement && (
                <span className="rounded-full border border-[var(--arc-border)] px-2 py-0.5 text-[var(--arc-text)]">
                  {explicitElement}
                </span>
              )}
              {learned && (
                <span className="rounded-full bg-[#9ad489]/10 px-2 py-0.5 text-[#9ad489]">
                  Aprendido
                </span>
              )}
            </div>
            <h2
              id="spell-inspector-title"
              className={`mt-1 font-display text-xl font-bold sm:text-2xl ${
                magical ? 'text-[var(--arc-magic-accent)]' : 'text-[var(--arc-phys-accent)]'
              }`}
            >
              {currentSpell.name}
            </h2>
            {contextLabel && (
              <p className="mt-0.5 text-xs text-[var(--arc-muted)]">{contextLabel}</p>
            )}
          </div>
          {!isEmbedded && (
            <button
              type="button"
              onClick={() => onClose?.()}
              aria-label="Cerrar ficha del hechizo"
              className="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-[var(--arc-muted)] hover:bg-[var(--arc-raised)] hover:text-[var(--arc-text)]"
            >
              <X className="h-4 w-4" />
            </button>
          )}
        </header>

        <div
          className={
            isEmbedded
              ? 'space-y-5 px-4 py-4 sm:px-5 sm:py-5'
              : 'max-h-[calc(94vh-150px)] space-y-5 overflow-y-auto px-4 py-4 sm:max-h-[calc(90vh-150px)] sm:px-6 sm:py-5'
          }
        >
          <div className="grid gap-2 sm:grid-cols-3">
            <div className="flex items-center gap-2 rounded-xl border border-[var(--arc-border)] bg-[var(--arc-surface-alt)] px-3 py-2.5">
              <Zap className="h-4 w-4 text-[var(--arc-accent)]" />
              <div>
                <p className="text-[10px] uppercase tracking-wide text-[var(--arc-muted)]">Maná</p>
                <p className="font-mono-num text-sm font-bold text-[var(--arc-text)]">
                  {activeCharacter && effectiveMana.cost !== currentSpell.manaCost
                    ? `${effectiveMana.cost} (base ${currentSpell.manaCost})`
                    : currentSpell.manaCost}
                </p>
              </div>
            </div>
            {effectSummary && (
              <div className="flex items-center gap-2 rounded-xl border border-[var(--arc-border)] bg-[var(--arc-surface-alt)] px-3 py-2.5">
                {currentSpell.effectType === 'heal' ? (
                  <Heart className="h-4 w-4 text-[#8fd2a1]" />
                ) : (
                  <Dices className="h-4 w-4 text-[var(--arc-accent)]" />
                )}
                <div>
                  <p className="text-[10px] uppercase tracking-wide text-[var(--arc-muted)]">{effectLabel}</p>
                  <p className="font-mono-num text-base font-bold text-[var(--arc-text)]">{effectSummary}</p>
                </div>
              </div>
            )}
            {currentSpell.duration && (
              <div className="flex items-center gap-2 rounded-xl border border-[var(--arc-border)] bg-[var(--arc-surface-alt)] px-3 py-2.5">
                <Clock3 className="h-4 w-4 text-[var(--arc-accent)]" />
                <div>
                  <p className="text-[10px] uppercase tracking-wide text-[var(--arc-muted)]">Duración</p>
                  <p className="text-sm font-semibold text-[var(--arc-text)]">{currentSpell.duration}</p>
                </div>
              </div>
            )}
          </div>

          {currentSpell.effectDescription && (
            <section>
              <h3 className="mb-1.5 text-xs font-bold uppercase tracking-wider text-[var(--arc-muted)]">
                Descripción
              </h3>
              <p className="text-sm leading-relaxed text-[var(--arc-text)]">
                {currentSpell.effectDescription}
              </p>
            </section>
          )}

          <section className="space-y-2.5">
            <h3 className="text-xs font-bold uppercase tracking-wider text-[var(--arc-muted)]">
              Mecánica
            </h3>
            <dl className="space-y-2.5">
              <InfoRow label="Tipo">{SPELL_CATEGORY_LABELS[category]} · {magical ? 'Mágico' : 'Físico'}</InfoRow>
              {currentSpell.castStat !== 'none' && (
                <InfoRow label="Dados de lanzamiento">
                  <span className="font-mono-num font-semibold">
                    {currentSpell.castStat === 'manual'
                      ? currentSpell.manualCastDice
                      : castDice}d6
                  </span>
                  {' · '}
                  {currentSpell.castStat === 'manual'
                    ? 'Manual'
                    : STAT_NAMES[currentSpell.castStat]}
                  {activeCharacter && currentSpell.castStat !== 'manual' && (
                    <span className="ml-1 text-xs text-[var(--arc-muted)]">
                      (personaje: {castDice}d6)
                    </span>
                  )}
                </InfoRow>
              )}
              {currentSpell.combatStats.length > 0 && (
                <InfoRow label="Tirada de combate">
                  <span className="font-mono-num font-semibold">{combatDice}d6</span>
                  {' · '}
                  {currentSpell.combatStats.map((stat) => STAT_NAMES[stat]).join(' + ')}
                </InfoRow>
              )}
              {castRequirement !== 'none' && (
                <InfoRow label="Lanzamiento">
                  {castRequirement === 'prepare'
                    ? 'Requiere casteo previo'
                    : `Condicional${currentSpell.castCondition ? `: ${currentSpell.castCondition}` : ''}`}
                </InfoRow>
              )}
              {(currentSpell.assuredSuccess > 0 || mastery.bonusAssured > 0) && (
                <InfoRow label="Éxitos asegurados">
                  +{currentSpell.assuredSuccess}
                  {mastery.bonusAssured > 0 && ` + ${mastery.bonusAssured} por maestría`}
                </InfoRow>
              )}
              {(currentSpell.effectType === 'damage' || currentSpell.effectType === 'heal') &&
                currentSpell.damage.notes && (
                  <InfoRow label="Nota de daño">{currentSpell.damage.notes}</InfoRow>
                )}
              {spellSupportsMastery(currentSpell) && activeCharacter && (
                <InfoRow label="Maestría">
                  <span className="inline-flex items-center gap-1.5">
                    <Award className="h-3.5 w-3.5 text-[var(--arc-accent)]" />
                    Nv. {mastery.level} · {mastery.successes}
                    {!mastery.isMaxLevel && `/${mastery.nextThreshold}`} éxitos
                  </span>
                  {mastery.dieUpgradeSteps > 0 && (
                    <span className="ml-1 text-xs text-[var(--arc-muted)]">
                      · mejora {mastery.dieUpgradeSteps} dado(s)
                    </span>
                  )}
                </InfoRow>
              )}
              {currentSpell.orders.length > 0 && (
                <InfoRow label="Órdenes">{currentSpell.orders.join(' · ')}</InfoRow>
              )}
            </dl>
          </section>

          {(currentSpell.statuses.length > 0 ||
            elementalMeta ||
            currentSpell.armorConfig?.isArmor ||
            (currentSpell.maxHits ?? 0) > 0 ||
            currentSpell.collateral?.enabled ||
            currentSpell.dispelConfig?.enabled) && (
            <section className="space-y-2.5">
              <h3 className="text-xs font-bold uppercase tracking-wider text-[var(--arc-muted)]">
                Efectos y consecuencias
              </h3>
              <dl className="space-y-2.5">
                {currentSpell.statuses.length > 0 && (
                  <InfoRow label="Estados">
                    <div className="flex flex-wrap gap-1.5">
                      {currentSpell.statuses.map((status) => (
                        <span key={status} className="rounded-full border border-[var(--arc-border)] bg-[var(--arc-surface-alt)] px-2 py-0.5 text-xs">
                          {status}
                          {currentSpell.statusParams?.[status]?.autoFails
                            ? ` · ${currentSpell.statusParams[status].autoFails} fallo(s)`
                            : ''}
                          {currentSpell.statusParams?.[status]?.untilHit ? ' · hasta recibir un golpe' : ''}
                        </span>
                      ))}
                    </div>
                  </InfoRow>
                )}
                {elementalMeta && currentSpell.elementalStatus && (
                  <InfoRow label="Efecto elemental">
                    <span className="inline-flex items-center gap-1.5">
                      <Flame className="h-3.5 w-3.5 text-[var(--arc-accent)]" />
                      {elementalMeta.name} · {currentSpell.elementalStatus.stacks} carga(s) ·{' '}
                      {currentSpell.elementalStatus.durationTurns} turnos · {elementalMeta.triggerLabel}
                    </span>
                    <p className="mt-0.5 text-xs text-[var(--arc-muted)]">{elementalMeta.description}</p>
                  </InfoRow>
                )}
                {currentSpell.armorConfig?.isArmor && (
                  <InfoRow label="Armadura">
                    {currentSpell.armorConfig.element || 'Arcano'} · reducción{' '}
                    {currentSpell.armorConfig.damageReduction ?? 0}
                    {currentSpell.armorConfig.damageDivisor === 0
                      ? ' · anula el daño'
                      : currentSpell.armorConfig.damageDivisor && currentSpell.armorConfig.damageDivisor > 1
                        ? ` · daño ÷${currentSpell.armorConfig.damageDivisor}`
                        : ''}
                    {(currentSpell.armorConfig.maxHits ?? currentSpell.maxHits ?? 0) > 0 &&
                      ` · ${currentSpell.armorConfig.maxHits ?? currentSpell.maxHits} golpes`}
                  </InfoRow>
                )}
                {!currentSpell.armorConfig?.isArmor && (currentSpell.maxHits ?? 0) > 0 && (
                  <InfoRow label="Resistencia">{currentSpell.maxHits} golpes</InfoRow>
                )}
                {currentSpell.collateral?.enabled && currentSpell.collateral && (
                  <InfoRow label="Daño colateral">
                    {currentSpell.collateral.label || 'Efecto colateral'} ·{' '}
                    {currentSpell.collateral.mode === 'fixed'
                      ? currentSpell.collateral.fixedAmount ?? 0
                      : formatDice(
                          currentSpell,
                          currentSpell.collateral.dice || [],
                          currentSpell.collateral.bonus || 0
                        )}
                    {currentSpell.collateral.durationType === 'turns' &&
                      ` · ${currentSpell.collateral.durationTurns || 1} turnos`}
                  </InfoRow>
                )}
                {currentSpell.dispelConfig?.enabled && (
                  <InfoRow label="Disipación">
                    {currentSpell.dispelConfig.scope.replace(/_/g, ' ')}
                    {currentSpell.dispelConfig.maxEffects
                      ? ` · máximo ${currentSpell.dispelConfig.maxEffects}`
                      : ' · todos los coincidentes'}
                    {currentSpell.dispelConfig.requiresInfluenceCheck
                      ? ' · requiere tirada de Influencia'
                      : ' · directa'}
                  </InfoRow>
                )}
              </dl>
            </section>
          )}

          {(currentSpell.areaConfig?.enabled ||
            currentSpell.dependency?.enabled ||
            currentSpell.synergyReaction ||
            currentSpell.damageKind ||
            compatibility ||
            dependencyStatus) && (
            <section className="space-y-2.5">
              <h3 className="text-xs font-bold uppercase tracking-wider text-[var(--arc-muted)]">
                Alcance e interacciones
              </h3>
              <dl className="space-y-2.5">
                {currentSpell.areaConfig?.enabled && (
                  <InfoRow label="Alcance">
                    <span className="inline-flex items-start gap-1.5">
                      <MapPin className="mt-0.5 h-3.5 w-3.5 text-[var(--arc-accent)]" />
                      {AREA_MODE_LABELS[currentSpell.areaConfig.mode]}
                      {currentSpell.areaConfig.maxTargets
                        ? ` · máximo ${currentSpell.areaConfig.maxTargets}`
                        : ''}
                      {currentSpell.areaConfig.shapeNote
                        ? ` · ${currentSpell.areaConfig.shapeNote}`
                        : ''}
                      {currentSpell.areaConfig.requiredStatusName
                        ? ` · requiere ${currentSpell.areaConfig.requiredStatusName}`
                        : ''}
                    </span>
                  </InfoRow>
                )}
                {currentSpell.dependency?.enabled && (
                  <InfoRow label="Requisito de activación">
                    <span className="inline-flex items-center gap-1.5">
                      <Link2 className="h-3.5 w-3.5 text-[var(--arc-accent)]" />
                      {formatSpellDependencyLine(currentSpell.dependency)}
                    </span>
                    {currentDependencyStatus && (
                      <p className={`mt-1 text-xs ${currentDependencyStatus.met ? 'text-[#9ad489]' : 'text-[#e6c07b]'}`}>
                        {currentDependencyStatus.met
                          ? 'Condición cumplida; hechizo habilitado.'
                          : currentDependencyStatus.reason || 'Falta cumplir el requisito de activación.'}
                      </p>
                    )}
                  </InfoRow>
                )}
                {currentSpell.synergyReaction && currentSpell.synergyReaction !== 'none' && (
                  <InfoRow label="Sinergia">
                    <span className="inline-flex items-center gap-1.5">
                      <Sparkles className="h-3.5 w-3.5 text-[var(--arc-accent)]" />
                      {SYNERGY_LABELS[currentSpell.synergyReaction]}
                      {currentSpell.synergyConsumeStacks === 'all'
                        ? ' · consume todas las cargas'
                        : typeof currentSpell.synergyConsumeStacks === 'number'
                          ? ` · consume ${currentSpell.synergyConsumeStacks} carga(s)`
                          : ''}
                    </span>
                  </InfoRow>
                )}
                {currentSpell.damageKind && currentSpell.effectType === 'damage' && (
                  <InfoRow label="Naturaleza del daño">{currentSpell.damageKind === 'magico' ? 'Mágico' : 'Físico'}</InfoRow>
                )}
                {compatibility && (
                  <InfoRow label="Compatibilidad">
                    <span className={compatibility.compatible ? 'text-[#9ad489]' : 'text-[#e6c07b]'}>
                      {compatibility.label}
                    </span>
                    {compatibility.detail && (
                      <p className="mt-0.5 text-xs text-[var(--arc-muted)]">{compatibility.detail}</p>
                    )}
                  </InfoRow>
                )}
              </dl>
            </section>
          )}

          {activeCharacter && (
            <section className="rounded-xl border border-[var(--arc-border)] bg-[var(--arc-surface-alt)] px-3.5 py-3">
              <h3 className="mb-1.5 text-xs font-bold uppercase tracking-wider text-[var(--arc-muted)]">
                Para {activeCharacter.name}
              </h3>
              <div className="flex flex-wrap items-center gap-2 text-xs">
                <span className={`inline-flex items-center gap-1 rounded-full px-2 py-1 ${
                  learned ? 'bg-[#9ad489]/10 text-[#9ad489]' : 'bg-[var(--arc-raised)] text-[var(--arc-muted)]'
                }`}>
                  <BookOpen className="h-3 w-3" />
                  {learned ? 'Aprendido' : 'No aprendido'}
                </span>
                <span className="inline-flex items-center gap-1 rounded-full bg-[var(--arc-raised)] px-2 py-1 font-mono-num text-[var(--arc-text)]">
                  <Zap className="h-3 w-3 text-[var(--arc-accent)]" />
                  Costo efectivo: {effectiveMana.cost} maná
                </span>
                {spellSupportsMastery(currentSpell) && (
                  <span className="inline-flex items-center gap-1 rounded-full bg-[var(--arc-raised)] px-2 py-1 text-[var(--arc-text)]">
                    <Award className="h-3 w-3 text-[var(--arc-accent)]" />
                    Maestría Nv. {mastery.level}
                  </span>
                )}
                {currentSpell.dependency?.enabled && !currentDependencyStatus && (
                  <span className="inline-flex items-center gap-1 text-[var(--arc-muted)]">
                    <Lock className="h-3 w-3" />
                    Se verifica al ejecutar en combate
                  </span>
                )}
              </div>
            </section>
          )}

          {archivePrerequisiteStatus && currentSpell.id === spell.id && (
            <section className="rounded-xl border border-[var(--arc-border)] bg-[var(--arc-surface-alt)] px-3.5 py-3">
              <h3 className="mb-1.5 text-xs font-bold uppercase tracking-wider text-[var(--arc-muted)]">
                Requisito de aprendizaje del Archivo
              </h3>
              <p className="text-xs leading-relaxed text-[var(--arc-text)]">
                {archivePrerequisiteStatus.learned
                  ? `Ya aprendiste «${archivePrerequisiteStatus.name}». Para activar este hechizo en combate, ese requisito aún debe estar activo sobre el lanzador.`
                  : `Primero necesitás aprender «${archivePrerequisiteStatus.name}» en el Archivo. Aprenderlo no lo activa automáticamente en combate.`}
              </p>
            </section>
          )}

          {relatedSpells.length > 0 && (
            <section>
              <h3 className="mb-2 text-xs font-bold uppercase tracking-wider text-[var(--arc-muted)]">
                Hechizos relacionados
              </h3>
              <div className="grid gap-1.5 sm:grid-cols-2">
                {relatedSpells.map(({ spell: related, reason }) => (
                  <button
                    key={related.id}
                    type="button"
                    onClick={() => navigateToSpell(related)}
                    className="flex min-w-0 items-center gap-2 rounded-lg border border-[var(--arc-border)] bg-[var(--arc-surface-alt)] px-3 py-2 text-left hover:border-[var(--arc-accent)]/50"
                  >
                    <Target className="h-3.5 w-3.5 shrink-0 text-[var(--arc-accent)]" />
                    <span className="min-w-0 flex-1">
                      <span className="block truncate text-xs font-semibold text-[var(--arc-text)]">{related.name}</span>
                      <span className="block truncate text-[10px] text-[var(--arc-muted)]">{reason}</span>
                    </span>
                    <ArrowRight className="h-3.5 w-3.5 shrink-0 text-[var(--arc-muted)]" />
                  </button>
                ))}
              </div>
            </section>
          )}
        </div>

        {(currentActions.length > 0 || currentTestCallback) && (
          <footer className="flex flex-wrap items-center justify-end gap-2 border-t border-[var(--arc-border)] px-4 py-3 sm:px-6">
            {currentTestCallback && (
              <button
                type="button"
                onClick={() => currentTestCallback(currentSpell)}
                className="min-h-[36px] inline-flex items-center gap-1.5 rounded-lg border border-[var(--arc-border)] px-3 text-xs font-semibold text-[var(--arc-text)] hover:bg-[var(--arc-raised)]"
              >
                <Dices className="h-3.5 w-3.5" />
                Probar
              </button>
            )}
            {currentActions.map((action) => (
              <button
                key={action.label}
                type="button"
                onClick={() => {
                  if (action.disabled) return;
                  onClose?.();
                  action.onClick();
                }}
                disabled={action.disabled}
                title={action.reason}
                className="min-h-[36px] inline-flex items-center gap-1.5 rounded-lg bg-[var(--arc-action)] px-3 text-xs font-semibold text-[var(--arc-action-text)] hover:bg-[var(--arc-action-hover)] disabled:cursor-not-allowed disabled:opacity-45"
              >
                <Zap className="h-3.5 w-3.5" />
                {action.label}
              </button>
            ))}
          </footer>
        )}
      </section>
    </div>
  );
}
</file>

<file path="src/components/ThemeCustomizer.tsx">
import { useEffect, useState } from 'react';
import {
  Check,
  LayoutGrid,
  Palette,
  Plus,
  RotateCcw,
  Save,
  Sparkles,
  Trash2,
  X,
} from 'lucide-react';
import type { GrimorioThemeConfig, SavedCustomTheme, ThemeColors } from '../types/rpg';
import {
  DEFAULT_THEME_CONFIG,
  THEME_COLOR_FIELDS,
  THEME_PRESETS,
  normalizeHexColor,
} from '../utils/themes';
import { generateId } from '../utils/dice';

interface ThemeCustomizerProps {
  theme: GrimorioThemeConfig;
  customizeLayoutMode: boolean;
  isDefaultLayout: boolean;
  onChangeTheme: (next: GrimorioThemeConfig) => void;
  onToggleLayoutMode: () => void;
  onResetLayout: () => void;
  onClose?: () => void;
}

function areColorsEqual(a: ThemeColors, b: ThemeColors): boolean {
  return (Object.keys(a) as Array<keyof ThemeColors>).every(
    (k) => a[k].toLowerCase() === b[k].toLowerCase()
  );
}

function HexColorControl({
  label,
  hint,
  value,
  onChange,
}: {
  label: string;
  hint: string;
  value: string;
  onChange: (nextHex: string) => void;
}) {
  const [draft, setDraft] = useState(value);

  useEffect(() => {
    setDraft(value);
  }, [value]);

  const handleTextChange = (raw: string) => {
    const cleaned = raw.startsWith('#') ? raw : `#${raw}`;
    setDraft(cleaned);
    if (/^#[0-9a-fA-F]{6}$/.test(cleaned.trim())) {
      onChange(cleaned.trim().toLowerCase());
    }
  };

  const handleBlur = () => {
    const normalized = normalizeHexColor(draft, value);
    setDraft(normalized);
    if (normalized !== value) {
      onChange(normalized);
    }
  };

  return (
    <div className="flex items-center justify-between gap-2.5 rounded-lg bg-[var(--arc-surface-alt)] px-3 py-2.5">
      <div className="min-w-0">
        <div className="text-xs font-semibold text-[var(--arc-text)] truncate">{label}</div>
        <div className="text-xs text-[var(--arc-muted)] truncate">{hint}</div>
      </div>

      <div className="flex items-center gap-1.5 shrink-0">
        <input
          type="color"
          value={normalizeHexColor(value, '#15100b')}
          onChange={(e) => {
            const next = e.target.value.toLowerCase();
            setDraft(next);
            onChange(next);
          }}
          aria-label={`Selector visual para ${label}`}
          className="h-8 w-8 cursor-pointer rounded border border-[var(--arc-border)] bg-transparent p-0.5"
        />
        <input
          type="text"
          value={draft}
          onChange={(e) => handleTextChange(e.target.value)}
          onBlur={handleBlur}
          maxLength={7}
          spellCheck={false}
          aria-label={`Código hex para ${label}`}
          className="font-mono-num w-[82px] min-h-[34px] rounded border border-[var(--arc-border)] bg-[var(--arc-input)] px-2 text-xs text-[var(--arc-text)] uppercase focus:outline-none focus:border-[var(--arc-accent)]"
        />
      </div>
    </div>
  );
}

export function ThemeCustomizer({
  theme,
  customizeLayoutMode,
  isDefaultLayout,
  onChangeTheme,
  onToggleLayoutMode,
  onResetLayout,
  onClose,
}: ThemeCustomizerProps) {
  const savedCustomThemes = theme.savedCustomThemes || [];
  const activePreset = THEME_PRESETS.find((p) => p.id === theme.presetId);
  const activeSavedTheme = savedCustomThemes.find((t) => t.id === theme.presetId);

  const [showHexEditor, setShowHexEditor] = useState(
    () => !activePreset && !activeSavedTheme
  );
  const [customThemeName, setCustomThemeName] = useState(
    () => activeSavedTheme?.name || 'Mi tema personalizado'
  );
  const [confirmDeleteId, setConfirmDeleteId] = useState<string | null>(null);
  const [savedNotice, setSavedNotice] = useState<string | null>(null);

  useEffect(() => {
    if (activeSavedTheme) {
      setCustomThemeName(activeSavedTheme.name);
    } else if (theme.presetId === 'custom_draft') {
      setCustomThemeName((prev) =>
        prev.trim() ? prev : `Mi tema ${savedCustomThemes.length + 1}`
      );
    }
  }, [activeSavedTheme?.id, activeSavedTheme?.name, theme.presetId, savedCustomThemes.length]);

  useEffect(() => {
    if (!savedNotice) return;
    const timer = window.setTimeout(() => setSavedNotice(null), 2400);
    return () => window.clearTimeout(timer);
  }, [savedNotice]);

  const isCustomModified = activePreset
    ? !areColorsEqual(activePreset.colors, theme.colors)
    : activeSavedTheme
      ? !areColorsEqual(activeSavedTheme.colors, theme.colors)
      : true;

  const isSavedThemeNameChanged = Boolean(
    activeSavedTheme &&
      customThemeName.trim() &&
      customThemeName.trim() !== activeSavedTheme.name
  );

  const handleSelectPreset = (presetId: string) => {
    const preset = THEME_PRESETS.find((p) => p.id === presetId);
    if (!preset) return;
    setConfirmDeleteId(null);
    onChangeTheme({
      presetId: preset.id,
      colors: { ...preset.colors },
      savedCustomThemes,
    });
  };

  const handleSelectSavedCustom = (saved: SavedCustomTheme) => {
    setConfirmDeleteId(null);
    setCustomThemeName(saved.name);
    onChangeTheme({
      presetId: saved.id,
      colors: { ...saved.colors },
      savedCustomThemes,
    });
  };

  const handleStartNewCustom = () => {
    setConfirmDeleteId(null);
    setShowHexEditor(true);
    setCustomThemeName(
      savedCustomThemes.length === 0
        ? 'Mi tema personalizado'
        : `Mi tema personalizado ${savedCustomThemes.length + 1}`
    );
    onChangeTheme({
      presetId: 'custom_draft',
      colors: { ...theme.colors },
      savedCustomThemes,
    });
  };

  const handleUpdateColor = (key: keyof ThemeColors, hex: string) => {
    onChangeTheme({
      ...theme,
      colors: {
        ...theme.colors,
        [key]: hex,
      },
      savedCustomThemes,
    });
  };

  const handleSaveAsNewCustom = () => {
    const cleanName =
      customThemeName.trim() ||
      (savedCustomThemes.length === 0
        ? 'Mi tema personalizado'
        : `Mi tema personalizado ${savedCustomThemes.length + 1}`);
    const newTheme: SavedCustomTheme = {
      id: generateId('theme_'),
      name: cleanName,
      colors: { ...theme.colors },
      updatedAt: new Date().toISOString(),
    };
    const nextSaved = [...savedCustomThemes, newTheme];
    setCustomThemeName(cleanName);
    onChangeTheme({
      presetId: newTheme.id,
      colors: { ...newTheme.colors },
      savedCustomThemes: nextSaved,
    });
    setSavedNotice(`«${cleanName}» guardado permanentemente`);
  };

  const handleUpdateActiveSavedCustom = () => {
    if (!activeSavedTheme) return;
    const cleanName = customThemeName.trim() || activeSavedTheme.name;
    const nextSaved = savedCustomThemes.map((t) =>
      t.id === activeSavedTheme.id
        ? {
            ...t,
            name: cleanName,
            colors: { ...theme.colors },
            updatedAt: new Date().toISOString(),
          }
        : t
    );
    setCustomThemeName(cleanName);
    onChangeTheme({
      presetId: activeSavedTheme.id,
      colors: { ...theme.colors },
      savedCustomThemes: nextSaved,
    });
    setSavedNotice(`Cambios guardados en «${cleanName}»`);
  };

  const handleDeleteSavedCustom = (id: string) => {
    const nextSaved = savedCustomThemes.filter((t) => t.id !== id);
    setConfirmDeleteId(null);
    if (theme.presetId === id) {
      onChangeTheme({
        presetId: DEFAULT_THEME_CONFIG.presetId,
        colors: { ...DEFAULT_THEME_CONFIG.colors },
        savedCustomThemes: nextSaved,
      });
    } else {
      onChangeTheme({
        ...theme,
        savedCustomThemes: nextSaved,
      });
    }
  };

  const handleResetTheme = () => {
    if (activePreset && isCustomModified) {
      onChangeTheme({
        presetId: activePreset.id,
        colors: { ...activePreset.colors },
        savedCustomThemes,
      });
    } else if (activeSavedTheme && isCustomModified) {
      onChangeTheme({
        presetId: activeSavedTheme.id,
        colors: { ...activeSavedTheme.colors },
        savedCustomThemes,
      });
      setCustomThemeName(activeSavedTheme.name);
    } else {
      onChangeTheme({
        presetId: DEFAULT_THEME_CONFIG.presetId,
        colors: { ...DEFAULT_THEME_CONFIG.colors },
        savedCustomThemes,
      });
    }
  };

  return (
    <section className="rounded-xl border border-[var(--arc-border)] bg-[var(--arc-surface)] p-4 sm:p-5 space-y-4">
      <div className="flex flex-wrap items-center justify-between gap-3 border-b border-[var(--arc-border)] pb-3.5">
        <div>
          <h2 className="font-display text-base sm:text-lg font-bold text-[var(--arc-accent)] flex items-center gap-2">
            <Palette className="h-4 w-4 shrink-0" />
            Personalizar Grimorio, Cajas y Temas
          </h2>
          <p className="text-[13px] text-[var(--arc-muted)] mt-0.5">
            Elegí un tema base, creá y guardá tus propios temas 100% personalizados por código hex y organizá las cajas del tablero.
          </p>
        </div>

        <div className="flex flex-wrap items-center gap-1.5">
          <button
            type="button"
            onClick={onToggleLayoutMode}
            className={`min-h-[36px] inline-flex items-center gap-1.5 rounded-lg px-3 text-xs font-semibold whitespace-nowrap shrink-0 transition-colors ${
              customizeLayoutMode
                ? 'bg-[var(--arc-action)] text-[var(--arc-action-text)]'
                : 'bg-transparent text-[var(--arc-text)] hover:bg-[var(--arc-raised)]'
            }`}
          >
            <LayoutGrid className="h-3.5 w-3.5" />
            {customizeLayoutMode ? 'Terminar de mover cajas' : 'Mover cajas de lugar'}
          </button>

          {!isDefaultLayout && (
            <button
              type="button"
              onClick={onResetLayout}
              className="min-h-[36px] inline-flex items-center gap-1.5 rounded-lg bg-transparent px-2.5 text-xs font-medium text-[var(--arc-muted)] hover:bg-[var(--arc-raised)] hover:text-[var(--arc-text)] whitespace-nowrap shrink-0 transition-colors"
            >
              <RotateCcw className="h-3.5 w-3.5" />
              Restaurar cajas
            </button>
          )}

          {onClose && (
            <button
              type="button"
              onClick={onClose}
              aria-label="Cerrar panel de personalización"
              className="min-h-[36px] w-9 inline-flex items-center justify-center rounded-lg bg-transparent text-[var(--arc-muted)] hover:bg-[var(--arc-raised)] hover:text-[var(--arc-text)] transition-colors"
            >
              <X className="h-4 w-4" />
            </button>
          )}
        </div>
      </div>

      {/* Paletas / Modos predefinidos + Temas 100% personalizados guardados */}
      <div className="space-y-3">
        <div className="flex flex-wrap items-center justify-between gap-2">
          <span className="text-xs font-semibold text-[var(--arc-text)]">
            Modos y temas del grimorio
          </span>
          <div className="flex flex-wrap items-center gap-1.5">
            <button
              type="button"
              onClick={() => setShowHexEditor((v) => !v)}
              className={`min-h-[34px] inline-flex items-center gap-1.5 rounded-lg px-3 text-xs font-semibold whitespace-nowrap shrink-0 transition-colors ${
                showHexEditor
                  ? 'bg-[var(--arc-raised)] text-[var(--arc-accent)]'
                  : 'bg-transparent text-[var(--arc-muted)] hover:bg-[var(--arc-raised)] hover:text-[var(--arc-text)]'
              }`}
            >
              <Palette className="h-3.5 w-3.5" />
              {showHexEditor ? 'Ocultar editor Hex' : 'Personalizar colores (Hex)'}
            </button>

            <button
              type="button"
              onClick={handleResetTheme}
              className="min-h-[34px] inline-flex items-center gap-1 rounded-lg bg-transparent px-2.5 text-xs text-[var(--arc-muted)] hover:bg-[var(--arc-raised)] hover:text-[var(--arc-text)] whitespace-nowrap shrink-0 transition-colors"
            >
              <RotateCcw className="h-3.5 w-3.5" />
              {activeSavedTheme && isCustomModified
                ? 'Volver al guardado'
                : isCustomModified
                  ? 'Volver al base del tema'
                  : 'Tema clásico'}
            </button>
          </div>
        </div>

        <div className="grid gap-2.5 sm:grid-cols-2 lg:grid-cols-3">
          {THEME_PRESETS.map((preset) => {
            const isSelected = theme.presetId === preset.id;
            return (
              <button
                key={preset.id}
                type="button"
                onClick={() => handleSelectPreset(preset.id)}
                className={`text-left rounded-lg border p-3 transition-colors space-y-2 ${
                  isSelected
                    ? 'border-[var(--arc-accent)] bg-[var(--arc-raised)]'
                    : 'border-transparent bg-[var(--arc-surface-alt)] hover:bg-[var(--arc-raised)]/60'
                }`}
              >
                <div className="flex items-center justify-between gap-2">
                  <span className="text-xs font-bold text-[var(--arc-text)] truncate">
                    {preset.name}
                  </span>
                  {isSelected && (
                    <span className="inline-flex items-center gap-1 text-xs font-semibold text-[var(--arc-accent)] shrink-0">
                      <Check className="h-3.5 w-3.5" />
                      {isCustomModified ? 'Editado' : 'Activo'}
                    </span>
                  )}
                </div>

                <p className="text-xs text-[var(--arc-muted)] line-clamp-2">
                  {preset.description}
                </p>

                <div className="flex items-center gap-1.5 pt-0.5" aria-hidden="true">
                  {[
                    preset.colors.canvas,
                    preset.colors.surface,
                    preset.colors.accent,
                    preset.colors.physicalAccent,
                    preset.colors.magicAccent,
                  ].map((hex, i) => (
                    <span
                      key={i}
                      className="h-4 w-6 rounded border border-black/25"
                      style={{ backgroundColor: hex }}
                    />
                  ))}
                </div>
              </button>
            );
          })}
        </div>

        {/* Sección de temas 100% personalizados guardados por el usuario */}
        <div className="space-y-2 pt-2 border-t border-[var(--arc-border)]/70">
          <div className="flex flex-wrap items-center justify-between gap-2">
            <div className="flex items-center gap-1.5">
              <Sparkles className="h-3.5 w-3.5 text-[var(--arc-accent)] shrink-0" />
              <span className="text-xs font-semibold text-[var(--arc-text)]">
                Tus temas 100% personalizados
              </span>
              <span className="font-mono-num text-xs text-[var(--arc-muted)]">
                ({savedCustomThemes.length})
              </span>
            </div>
            <span className="text-xs text-[var(--arc-muted)]">
              Se conservan al cambiar de tema y solo se borran si vos lo elegís
            </span>
          </div>

          <div className="grid gap-2.5 sm:grid-cols-2 lg:grid-cols-3">
            {savedCustomThemes.map((saved) => {
              const isSelected = theme.presetId === saved.id;
              const isConfirming = confirmDeleteId === saved.id;
              return (
                <div
                  key={saved.id}
                  className={`rounded-lg border p-3 transition-colors space-y-2 ${
                    isSelected
                      ? 'border-[var(--arc-accent)] bg-[var(--arc-raised)]'
                      : 'border-[var(--arc-border)]/70 bg-[var(--arc-surface-alt)] hover:bg-[var(--arc-raised)]/60'
                  }`}
                >
                  <div className="flex items-start justify-between gap-2">
                    <button
                      type="button"
                      onClick={() => handleSelectSavedCustom(saved)}
                      className="min-w-0 flex-1 text-left"
                    >
                      <div className="flex items-center gap-1.5">
                        <span className="text-xs font-bold text-[var(--arc-text)] truncate">
                          {saved.name}
                        </span>
                      </div>
                      <p className="text-[11px] text-[var(--arc-muted)] mt-0.5">
                        100% personalizado · Guardado
                      </p>
                    </button>

                    <div className="flex items-center gap-1 shrink-0">
                      {isSelected && !isConfirming && (
                        <span className="inline-flex items-center gap-1 text-xs font-semibold text-[var(--arc-accent)] mr-1">
                          <Check className="h-3.5 w-3.5" />
                          {isCustomModified ? 'Editado' : 'Activo'}
                        </span>
                      )}

                      {isConfirming ? (
                        <div className="inline-flex items-center gap-1">
                          <button
                            type="button"
                            onClick={() => handleDeleteSavedCustom(saved.id)}
                            className="min-h-[26px] rounded px-2 text-[11px] font-semibold bg-[var(--arc-cat-damage-bg)] text-[var(--arc-cat-damage-accent)] border border-[var(--arc-cat-damage-border)] hover:brightness-110 transition-colors"
                          >
                            Borrar
                          </button>
                          <button
                            type="button"
                            onClick={() => setConfirmDeleteId(null)}
                            className="min-h-[26px] rounded px-2 text-[11px] text-[var(--arc-muted)] hover:bg-[var(--arc-raised)] hover:text-[var(--arc-text)] transition-colors"
                          >
                            No
                          </button>
                        </div>
                      ) : (
                        <button
                          type="button"
                          onClick={() => setConfirmDeleteId(saved.id)}
                          aria-label={`Borrar tema personalizado ${saved.name}`}
                          title="Borrar tema personalizado"
                          className="min-h-[28px] w-7 inline-flex items-center justify-center rounded text-[var(--arc-muted)] hover:bg-[var(--arc-cat-damage-bg)] hover:text-[var(--arc-cat-damage-accent)] transition-colors"
                        >
                          <Trash2 className="h-3.5 w-3.5" />
                        </button>
                      )}
                    </div>
                  </div>

                  <button
                    type="button"
                    onClick={() => handleSelectSavedCustom(saved)}
                    className="w-full flex items-center justify-between gap-2 pt-0.5 text-left"
                  >
                    <div className="flex items-center gap-1.5" aria-hidden="true">
                      {[
                        saved.colors.canvas,
                        saved.colors.surface,
                        saved.colors.accent,
                        saved.colors.physicalAccent,
                        saved.colors.magicAccent,
                      ].map((hex, i) => (
                        <span
                          key={i}
                          className="h-4 w-6 rounded border border-black/25"
                          style={{ backgroundColor: hex }}
                        />
                      ))}
                    </div>
                    <span className="text-[11px] font-medium text-[var(--arc-muted)]">
                      {isSelected ? 'En uso' : 'Aplicar'}
                    </span>
                  </button>
                </div>
              );
            })}

            {/* Tarjeta para crear un nuevo tema 100% personalizado */}
            <button
              type="button"
              onClick={handleStartNewCustom}
              className={`text-left rounded-lg border border-dashed p-3 transition-colors flex flex-col justify-between gap-2 min-h-[96px] ${
                theme.presetId === 'custom_draft'
                  ? 'border-[var(--arc-accent)] bg-[var(--arc-raised)]/80'
                  : 'border-[var(--arc-border)] bg-[var(--arc-surface-alt)]/70 hover:border-[var(--arc-accent)] hover:bg-[var(--arc-raised)]/50'
              }`}
            >
              <div className="flex items-center justify-between gap-2">
                <span className="inline-flex items-center gap-1.5 text-xs font-bold text-[var(--arc-accent)]">
                  <Plus className="h-3.5 w-3.5" />
                  Nuevo tema 100% personalizado
                </span>
                {theme.presetId === 'custom_draft' && (
                  <span className="text-[11px] font-semibold text-[var(--arc-accent)]">
                    En edición
                  </span>
                )}
              </div>
              <p className="text-xs text-[var(--arc-muted)]">
                Elegí cada color en Hex y guardalo con nombre propio para volver cuando quieras.
              </p>
            </button>
          </div>
        </div>
      </div>

      {/* Editor de colores individuales con código Hex + Guardado permanente */}
      {showHexEditor && (
        <div className="space-y-3 border-t border-[var(--arc-border)] pt-3.5">
          <div className="flex flex-wrap items-center justify-between gap-2">
            <span className="text-xs font-semibold text-[var(--arc-accent)]">
              Editor 100% personalizado (selector o código #HEX)
            </span>
            {savedNotice ? (
              <span className="inline-flex items-center gap-1 text-xs font-semibold text-[var(--arc-cat-heal-accent)]">
                <Check className="h-3.5 w-3.5" />
                {savedNotice}
              </span>
            ) : (
              <span className="text-xs text-[var(--arc-muted)]">
                {activeSavedTheme
                  ? `Editando «${activeSavedTheme.name}»`
                  : 'Ajustá los 14 colores y guardá tu tema para conservarlo'}
              </span>
            )}
          </div>

          {/* Barra de nombre y guardado del tema personalizado */}
          <div className="flex flex-wrap items-center gap-2 rounded-lg border border-[var(--arc-border)] bg-[var(--arc-surface-alt)] p-3">
            <input
              type="text"
              value={customThemeName}
              onChange={(e) => setCustomThemeName(e.target.value)}
              placeholder="Nombre de tu tema personalizado (ej: Obsidiana Violeta)"
              aria-label="Nombre del tema personalizado"
              maxLength={40}
              className="flex-1 min-w-[200px] min-h-[36px] rounded-lg border border-[var(--arc-border)] bg-[var(--arc-input)] px-3 text-xs text-[var(--arc-text)] placeholder:text-[var(--arc-muted)] focus:border-[var(--arc-accent)] focus:outline-none"
            />

            {activeSavedTheme ? (
              <div className="flex flex-wrap items-center gap-1.5">
                <button
                  type="button"
                  onClick={handleUpdateActiveSavedCustom}
                  disabled={!isCustomModified && !isSavedThemeNameChanged}
                  className="min-h-[36px] inline-flex items-center gap-1.5 rounded-lg bg-[var(--arc-action)] px-3 text-xs font-semibold text-[var(--arc-action-text)] hover:bg-[var(--arc-action-hover)] disabled:opacity-45 disabled:cursor-not-allowed whitespace-nowrap shrink-0 transition-colors"
                >
                  <Save className="h-3.5 w-3.5" />
                  Guardar cambios
                </button>
                <button
                  type="button"
                  onClick={handleSaveAsNewCustom}
                  className="min-h-[36px] inline-flex items-center gap-1.5 rounded-lg bg-[var(--arc-raised)] px-3 text-xs font-semibold text-[var(--arc-text)] hover:brightness-110 whitespace-nowrap shrink-0 transition-colors"
                >
                  <Plus className="h-3.5 w-3.5" />
                  Guardar como nuevo
                </button>
              </div>
            ) : (
              <button
                type="button"
                onClick={handleSaveAsNewCustom}
                className="min-h-[36px] inline-flex items-center gap-1.5 rounded-lg bg-[var(--arc-action)] px-3.5 text-xs font-semibold text-[var(--arc-action-text)] hover:bg-[var(--arc-action-hover)] whitespace-nowrap shrink-0 transition-colors"
              >
                <Save className="h-3.5 w-3.5" />
                Guardar tema personalizado
              </button>
            )}
          </div>

          <div className="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
            {THEME_COLOR_FIELDS.map((field) => (
              <HexColorControl
                key={field.key}
                label={field.label}
                hint={field.hint}
                value={theme.colors[field.key]}
                onChange={(hex) => handleUpdateColor(field.key, hex)}
              />
            ))}
          </div>
        </div>
      )}
    </section>
  );
}
</file>

<file path="src/components/WeaponArsenal.tsx">
import { useState } from 'react';
import { Flame, Lock, Plus, RotateCcw, Shield, Sparkles, Swords, Trash2 } from 'lucide-react';
import type { Character, CharacterWeapon, FormulaConfig, StatKey } from '../types/rpg';
import {
  IMBUE_ELEMENTS,
  STAT_NAMES,
  WEAPON_PRESETS,
  type AggregatedStatusEffects,
  getCharacterStatDice,
  getHighestCharacterStat,
  getWeaponDamageFormula,
} from '../utils/dice';

interface WeaponArsenalProps {
  activeCharacter: Character | undefined;
  formula: FormulaConfig;
  isAttackLethal: boolean;
  actionsRemaining?: number;
  activeStatusEffects?: AggregatedStatusEffects;
  onRecoverDisarmedWeapon?: () => void;
  onAddWeapon: (presetId: string) => void;
  onRemoveWeapon: (weaponId: string) => void;
  onRestoreWeapon: (weaponId: string) => void;
  onImbueWeapon: (
    weaponId: string,
    element: string,
    manaCost: number,
    disintegratesAfterAttack: boolean
  ) => void;
  onClearImbuement: (weaponId: string) => void;
  onAttackWithWeapon: (weapon: CharacterWeapon, attackStat: StatKey) => void;
  onExpandShield: (weapon: CharacterWeapon, manaToSpend: number) => void;
}

const CATEGORY_LABELS: Record<CharacterWeapon['category'], string> = {
  melee: 'Cuerpo a cuerpo',
  ranged: 'A distancia',
  natural: 'Natural / Desarmado',
  catalyst: 'Catalizador mágico',
};

export function WeaponArsenal({
  activeCharacter,
  formula,
  isAttackLethal,
  actionsRemaining,
  activeStatusEffects,
  onRecoverDisarmedWeapon,
  onAddWeapon,
  onRemoveWeapon,
  onRestoreWeapon,
  onImbueWeapon,
  onClearImbuement,
  onAttackWithWeapon,
  onExpandShield,
}: WeaponArsenalProps) {
  const outOfTurnActions = typeof actionsRemaining === 'number' && actionsRemaining <= 0;
  const isDisarmed = Boolean(activeStatusEffects?.disarmed);
  const cannotAttackByStatus = Boolean(activeStatusEffects?.cannotAttack);
  const [selectedPresetId, setSelectedPresetId] = useState<string>(WEAPON_PRESETS[0].id);
  const [imbuingWeaponId, setImbuingWeaponId] = useState<string | null>(null);
  const [imbueElement, setImbueElement] = useState<string>('Fuego');
  const [customElement, setCustomElement] = useState<string>('');
  const [imbueManaCost, setImbueManaCost] = useState<number>(1);
  const [disintegrates, setDisintegrates] = useState<boolean>(true);
  const [shieldManaInputs, setShieldManaInputs] = useState<Record<string, number>>({});
  const [weaponStatOverrides, setWeaponStatOverrides] = useState<
    Record<string, StatKey | 'highest'>
  >({});

  if (!activeCharacter) return null;

  const weapons = activeCharacter.weapons || [];
  const highestStatInfo = getHighestCharacterStat(activeCharacter, formula);
  const highestTiedLabel = highestStatInfo.tiedStats.map((k) => STAT_NAMES[k]).join(' / ');
  const meleePresets = WEAPON_PRESETS.filter((p) => p.category === 'melee');
  const rangedPresets = WEAPON_PRESETS.filter((p) => p.category === 'ranged');
  const naturalPresets = WEAPON_PRESETS.filter((p) => p.category === 'natural');
  const catalystPresets = WEAPON_PRESETS.filter((p) => p.category === 'catalyst');

  const selectedPreset = WEAPON_PRESETS.find((p) => p.id === selectedPresetId);

  const openImbueForm = (weapon: CharacterWeapon) => {
    if (imbuingWeaponId === weapon.id) {
      setImbuingWeaponId(null);
      return;
    }
    setImbuingWeaponId(weapon.id);
    setDisintegrates(!weapon.isNatural && !weapon.isMagicalCatalyst);
    setImbueManaCost(1);
  };

  const handleConfirmImbue = (weaponId: string) => {
    const finalElement =
      imbueElement === '__custom__' ? customElement.trim() || 'Elemento Arcano' : imbueElement;
    onImbueWeapon(weaponId, finalElement, Math.max(0, imbueManaCost), disintegrates);
    setImbuingWeaponId(null);
    setCustomElement('');
  };

  const getWeaponStatChoice = (weapon: CharacterWeapon): StatKey | 'highest' => {
    if (weaponStatOverrides[weapon.id]) return weaponStatOverrides[weapon.id];
    return weapon.isMagicalCatalyst ? 'highest' : 'fisico';
  };

  return (
    <section className="rounded-xl border border-[var(--arc-border)] bg-[var(--arc-surface)] p-4 sm:p-5 space-y-4">
      <div className="flex flex-wrap items-center justify-between gap-2 border-b border-[var(--arc-border)] pb-3.5">
        <div>
          <h2 className="font-display text-lg sm:text-xl font-bold text-[var(--arc-accent)]">
            Armas, Catalizadores e Imbuición
          </h2>
          <p className="text-[13px] text-[var(--arc-muted)] mt-0.5">
            Imbuir convierte el daño en <strong className="text-[var(--arc-text)]">mágico</strong>. Las
            armas comunes imbuidas se desintegran tras <strong className="text-[var(--arc-text)]">1 ataque</strong>{' '}
            (acierte o falle).
          </p>
        </div>
      </div>

      {isDisarmed && (
        <div className="flex flex-wrap items-center justify-between gap-2 rounded-lg border border-[#7a3f28] bg-[#2a150e] px-3.5 py-2.5 text-xs text-[#ffd2be]">
          <span className="inline-flex items-center gap-1.5 font-medium">
            <Lock className="h-3.5 w-3.5 text-[#ff9a76] shrink-0" />
            <span>
              <strong>Desarmado:</strong> {activeCharacter.name} soltó su arma/escudo y no puede
              usarlos hasta gastar 1 acción en su turno para recuperarlos (armas naturales siguen
              disponibles).
            </span>
          </span>
          {onRecoverDisarmedWeapon && (
            <button
              type="button"
              disabled={outOfTurnActions || Boolean(activeStatusEffects?.cannotAct)}
              onClick={onRecoverDisarmedWeapon}
              title={
                outOfTurnActions
                  ? 'Sin acciones restantes en este turno'
                  : activeStatusEffects?.cannotAct
                    ? `Bloqueado por ${activeStatusEffects.cannotActReasons.join(', ')}`
                    : 'Gastar 1 acción de tu turno para recuperar tu arma y escudo'
              }
              className="min-h-[32px] inline-flex items-center gap-1.5 rounded-md bg-[#7c4820] px-3 text-xs font-semibold text-[#fff2de] hover:bg-[#945829] disabled:opacity-40 disabled:cursor-not-allowed whitespace-nowrap shrink-0 transition-colors"
            >
              <RotateCcw className="h-3.5 w-3.5" />
              Recuperar arma/escudo (1 acción)
            </button>
          )}
        </div>
      )}

      {/* Selector para agregar armas o catalizadores (sin recuadro anidado) */}
      <div className="space-y-2 border-b border-[var(--arc-border)] pb-4">
        <div className="flex flex-wrap gap-2">
          <select
            value={selectedPresetId}
            onChange={(e) => setSelectedPresetId(e.target.value)}
            aria-label="Seleccionar categoría de arma o catalizador"
            className="w-full sm:w-auto sm:flex-1 min-h-[40px] rounded-lg border border-[var(--arc-border)] bg-[var(--arc-input)] px-3 text-xs text-[var(--arc-text)]"
          >
            <optgroup label="Armas cuerpo a cuerpo">
              {meleePresets.map((p) => (
                <option key={p.id} value={p.id}>
                  {p.name} ({p.dice.map((d) => `${d.count}${d.type}`).join('+')})
                </option>
              ))}
            </optgroup>
            <optgroup label="Armas a distancia">
              {rangedPresets.map((p) => (
                <option key={p.id} value={p.id}>
                  {p.name} ({p.dice.map((d) => `${d.count}${d.type}`).join('+')})
                </option>
              ))}
            </optgroup>
            <optgroup label="Naturales / Desarmado">
              {naturalPresets.map((p) => (
                <option key={p.id} value={p.id}>
                  {p.name} ({p.dice.map((d) => `${d.count}${d.type}`).join('+')})
                </option>
              ))}
            </optgroup>
            <optgroup label="Catalizadores mágicos (armas especiales)">
              {catalystPresets.map((p) => (
                <option key={p.id} value={p.id}>
                  {p.name}
                  {p.dice.length > 0
                    ? ` (${p.dice.map((d) => `${d.count}${d.type}`).join('+')} + Inf + Man)`
                    : ' (Escudo / Rodela)'}
                </option>
              ))}
            </optgroup>
          </select>

          <button
            type="button"
            onClick={() => onAddWeapon(selectedPresetId)}
            className="min-h-[40px] w-full sm:w-auto inline-flex items-center justify-center gap-1.5 rounded-lg bg-[var(--arc-action)] px-4 text-xs font-semibold text-[var(--arc-action-text)] hover:bg-[var(--arc-action-hover)] shadow-sm whitespace-nowrap shrink-0 transition-colors"
          >
            <Plus className="h-4 w-4" />
            Equipar a {activeCharacter.name}
          </button>
        </div>

        {selectedPreset && (
          <p className="text-xs text-[var(--arc-muted)]">{selectedPreset.description}</p>
        )}
      </div>

      {/* Lista de armas equipadas */}
      {weapons.length === 0 ? (
        <div className="rounded-lg bg-[var(--arc-surface-alt)] p-5 text-center text-[13px] text-[var(--arc-muted)]">
          {activeCharacter.name} no tiene armas ni catalizadores equipados todavía. Elegí uno arriba
          para atacar o imbuir elementos.
        </div>
      ) : (
        <div className="space-y-3">
          {weapons.map((weapon) => {
            const dmgInfo = getWeaponDamageFormula(weapon, activeCharacter);
            const statChoice = getWeaponStatChoice(weapon);
            const attackStat: StatKey =
              statChoice === 'highest' ? highestStatInfo.stat : statChoice;
            const attackDice =
              statChoice === 'highest'
                ? highestStatInfo.dice
                : getCharacterStatDice(activeCharacter, attackStat, formula);
            const isShield = weapon.catalystKind === 'shield';
            const shieldMana = shieldManaInputs[weapon.id] ?? 1;
            const isImbueOpen = imbuingWeaponId === weapon.id;

            const isMagicalWeapon =
              !weapon.destroyed && (dmgInfo.damageKind === 'magico' || weapon.isMagicalCatalyst);

            return (
              <article
                key={weapon.id}
                className={`rounded-xl border p-4 space-y-3 ${
                  weapon.destroyed
                    ? 'border-[#5a2c22] bg-[#1e1210] opacity-75'
                    : isMagicalWeapon
                      ? 'border-[var(--arc-magic-border)] bg-[var(--arc-magic-bg)]'
                      : 'border-[var(--arc-phys-border)] bg-[var(--arc-phys-bg)]'
                }`}
              >
                <div className="flex flex-wrap items-start justify-between gap-2">
                  <div className="min-w-0 flex-1">
                    <div className="flex flex-wrap items-center gap-2">
                      <h3
                        className={`text-base font-bold break-words ${
                          isMagicalWeapon
                            ? 'text-[var(--arc-magic-accent)]'
                            : 'text-[var(--arc-phys-accent)]'
                        }`}
                      >
                        {weapon.name}
                      </h3>
                      <span className="text-xs text-[var(--arc-muted)]">
                        · {CATEGORY_LABELS[weapon.category]}
                      </span>
                      {!weapon.destroyed && !isShield && (
                        <span
                          className={`text-xs font-semibold ${
                            dmgInfo.damageKind === 'magico'
                              ? 'text-[var(--arc-magic-accent)]'
                              : 'text-[var(--arc-phys-accent)]'
                          }`}
                        >
                          · Daño {dmgInfo.damageKind === 'magico' ? 'Mágico' : 'Físico'}
                        </span>
                      )}
                    </div>

                    {weapon.destroyed ? (
                      <p className="mt-1 text-[13px] text-[#f09a82]">
                        Desintegrada: {weapon.destroyedReason || 'consumida tras el ataque imbuido'}.
                      </p>
                    ) : isShield ? (
                      <p className="mt-1 text-[13px] text-[var(--arc-magic-text)] leading-relaxed">
                        Reduce en <strong className="font-mono-num">1</strong> el costo de maná de
                        hechizos de protección/defensa. Se expande según el maná que gastes.
                      </p>
                    ) : (
                      <div
                        className={`mt-1 flex flex-wrap gap-x-4 gap-y-1 text-[13px] font-mono-num ${
                          isMagicalWeapon
                            ? 'text-[var(--arc-magic-text)]'
                            : 'text-[var(--arc-phys-text)]'
                        }`}
                      >
                        <span>Daño: {dmgInfo.text}</span>
                        <span>
                          Ataque: {attackDice}d6 (
                          {statChoice === 'highest'
                            ? `Mayor: ${highestTiedLabel}`
                            : STAT_NAMES[attackStat]}
                          )
                        </span>
                      </div>
                    )}

                    {!weapon.destroyed && weapon.imbued && (
                      <div className="mt-2 flex flex-wrap items-center gap-2 text-xs">
                        <span className="inline-flex items-center gap-1 rounded-md bg-[var(--arc-magic-raised)] px-2.5 py-0.5 font-semibold text-[var(--arc-magic-text)]">
                          <Flame className="h-3.5 w-3.5 text-[var(--arc-magic-accent)]" />
                          Imbuida: {weapon.imbued.element} (1 ataque)
                        </span>
                        {weapon.imbued.disintegratesAfterAttack && (
                          <span className="text-xs text-[#f09a82]">
                            Se desintegra al atacar (acierte o falle)
                          </span>
                        )}
                      </div>
                    )}
                  </div>

                  <div className="flex items-center gap-1">
                    {weapon.destroyed && (
                      <button
                        type="button"
                        onClick={() => onRestoreWeapon(weapon.id)}
                        title="Reponer arma nueva"
                        className="min-h-[34px] inline-flex items-center gap-1 rounded-lg bg-transparent px-2.5 text-xs font-medium text-[var(--arc-text)] hover:bg-[var(--arc-raised)] transition-colors"
                      >
                        <RotateCcw className="h-3.5 w-3.5" />
                        Reponer
                      </button>
                    )}
                    <button
                      type="button"
                      onClick={() => onRemoveWeapon(weapon.id)}
                      title="Quitar arma"
                      aria-label={`Quitar ${weapon.name}`}
                      className="min-h-[34px] w-8 inline-flex items-center justify-center rounded-lg bg-transparent text-[var(--arc-muted)] hover:bg-[#361912] hover:text-[#e88a70] transition-colors"
                    >
                      <Trash2 className="h-4 w-4" />
                    </button>
                  </div>
                </div>

                {/* Controles específicos de Escudo Catalizador */}
                {!weapon.destroyed && isShield && (
                  <div className="flex flex-wrap items-center gap-2 border-t border-[var(--arc-magic-border)]/60 pt-3 text-xs">
                    <Shield className="h-4 w-4 text-[var(--arc-magic-accent)] shrink-0" />
                    {isDisarmed ? (
                      <span className="inline-flex items-center gap-1.5 font-semibold text-[#ffb89e]">
                        <Lock className="h-3.5 w-3.5 shrink-0" />
                        Escudo soltado (Desarmado): sin bono de defensa ni expansión hasta
                        recuperarlo.
                      </span>
                    ) : (
                      <>
                        <span className="text-[var(--arc-magic-text)]">Expandir rodela (maná):</span>
                        <input
                          type="number"
                          min={1}
                          max={Math.max(1, activeCharacter.mana.max)}
                          value={shieldMana}
                          onChange={(e) =>
                            setShieldManaInputs((prev) => ({
                              ...prev,
                              [weapon.id]: Math.max(1, parseInt(e.target.value, 10) || 1),
                            }))
                          }
                          aria-label="Maná para expandir rodela"
                          className="font-mono-num w-16 min-h-[34px] rounded-md border border-[var(--arc-magic-border)] bg-[var(--arc-input)] px-2 text-center text-xs text-[var(--arc-text)]"
                        />
                        <button
                          type="button"
                          onClick={() => onExpandShield(weapon, shieldMana)}
                          className="min-h-[38px] rounded-lg bg-[var(--arc-action)] px-3.5 text-xs font-semibold text-[var(--arc-action-text)] hover:bg-[var(--arc-action-hover)] shadow-sm transition-colors"
                        >
                          Expandir ({shieldMana} maná)
                        </button>
                      </>
                    )}
                  </div>
                )}

                {/* Controles de Imbuir / Atacar */}
                {!weapon.destroyed && !isShield && (() => {
                  const weaponBlockedByDisarm = isDisarmed && !weapon.isNatural;
                  const attackDisabled =
                    outOfTurnActions || cannotAttackByStatus || weaponBlockedByDisarm;
                  const disabledTitle = weaponBlockedByDisarm
                    ? 'Desarmado: gastá 1 acción en tu turno para recuperar el arma'
                    : cannotAttackByStatus
                      ? `No podés atacar (${activeStatusEffects?.cannotAttackReasons.join(', ')})`
                      : outOfTurnActions
                        ? 'Sin acciones restantes este turno — activá Hechizo Veloz o pasá el turno'
                        : undefined;
                  return (
                  <div className="flex flex-wrap items-center gap-2 border-t border-white/10 pt-3">
                    <select
                      value={statChoice}
                      onChange={(e) =>
                        setWeaponStatOverrides((prev) => ({
                          ...prev,
                          [weapon.id]: e.target.value as StatKey | 'highest',
                        }))
                      }
                      aria-label={`Atributo de ataque para ${weapon.name}`}
                      className="min-h-[38px] rounded-lg border border-[var(--arc-border)] bg-[var(--arc-input)] px-2.5 text-xs text-[var(--arc-text)]"
                    >
                      {weapon.isMagicalCatalyst && (
                        <option value="highest">
                          Mayor del PJ ({highestStatInfo.dice}d6 · {highestTiedLabel})
                        </option>
                      )}
                      <option value="fisico">Con Físico</option>
                      <option value="manipulacion">Con Manipulación</option>
                      <option value="influencia">Con Influencia</option>
                    </select>

                    <button
                      type="button"
                      disabled={attackDisabled}
                      title={disabledTitle}
                      onClick={() => onAttackWithWeapon(weapon, attackStat)}
                      className="min-h-[40px] inline-flex items-center gap-1.5 rounded-lg bg-[var(--arc-action)] px-4 text-xs font-semibold text-[var(--arc-action-text)] hover:bg-[var(--arc-action-hover)] disabled:opacity-40 disabled:cursor-not-allowed shadow-sm whitespace-nowrap shrink-0 transition-colors"
                    >
                      {weaponBlockedByDisarm || cannotAttackByStatus ? (
                        <Lock className="h-3.5 w-3.5" />
                      ) : (
                        <Swords className="h-3.5 w-3.5" />
                      )}
                      {weaponBlockedByDisarm
                        ? 'Soltada (Desarmado)'
                        : cannotAttackByStatus
                          ? `Bloqueado (${activeStatusEffects?.cannotAttackReasons[0]})`
                          : `Atacar (${isAttackLethal ? 'Letal' : 'No letal'})`}
                    </button>

                    {!weapon.imbued ? (
                      <button
                        type="button"
                        disabled={weaponBlockedByDisarm}
                        onClick={() => openImbueForm(weapon)}
                        className="min-h-[38px] inline-flex items-center gap-1.5 rounded-lg bg-transparent px-3 text-xs font-semibold text-[var(--arc-accent)] hover:bg-[var(--arc-raised)] disabled:opacity-40 disabled:cursor-not-allowed whitespace-nowrap shrink-0 transition-colors"
                      >
                        <Sparkles className="h-3.5 w-3.5" />
                        Imbuir elemento
                      </button>
                    ) : (
                      <button
                        type="button"
                        onClick={() => onClearImbuement(weapon.id)}
                        className="min-h-[38px] rounded-lg bg-transparent px-2.5 text-xs font-medium text-[var(--arc-muted)] hover:bg-[var(--arc-raised)] hover:text-[var(--arc-text)] transition-colors"
                      >
                        Quitar imbuición
                      </button>
                    )}
                  </div>
                  );
                })()}

                {/* Formulario inline para imbuir el arma (divisor sutil, sin recuadro extra) */}
                {isImbueOpen && !weapon.destroyed && (
                  <div className="border-t border-[var(--arc-border)] pt-3 space-y-2.5">
                    <div className="grid gap-2.5 sm:grid-cols-12">
                      <div className="sm:col-span-7">
                        <label className="block text-xs font-semibold text-[var(--arc-muted)] mb-1">
                          Elemento o propiedad a imbuir
                        </label>
                        <select
                          value={imbueElement}
                          onChange={(e) => setImbueElement(e.target.value)}
                          className="w-full min-h-[38px] rounded-md border border-[var(--arc-border)] bg-[var(--arc-input)] px-2.5 text-xs text-[var(--arc-text)]"
                        >
                          {IMBUE_ELEMENTS.map((el) => (
                            <option key={el} value={el}>
                              {el}
                            </option>
                          ))}
                          <option value="__custom__">Otro (personalizado)...</option>
                        </select>
                      </div>

                      <div className="sm:col-span-5">
                        <label className="block text-xs font-semibold text-[var(--arc-muted)] mb-1">
                          Maná al imbuir
                        </label>
                        <input
                          type="number"
                          min={0}
                          max={20}
                          value={imbueManaCost}
                          onChange={(e) =>
                            setImbueManaCost(Math.max(0, parseInt(e.target.value, 10) || 0))
                          }
                          className="font-mono-num w-full min-h-[38px] rounded-md border border-[var(--arc-border)] bg-[var(--arc-input)] px-2.5 text-xs text-[var(--arc-text)]"
                        />
                      </div>
                    </div>

                    {imbueElement === '__custom__' && (
                      <input
                        type="text"
                        value={customElement}
                        onChange={(e) => setCustomElement(e.target.value)}
                        placeholder="Ej: Ácido, Sangre, Cristal, Gravedad..."
                        className="w-full min-h-[38px] rounded-md border border-[var(--arc-border)] bg-[var(--arc-input)] px-2.5 text-xs text-[var(--arc-text)]"
                      />
                    )}

                    <label className="inline-flex items-center gap-2 text-xs text-[var(--arc-text)] opacity-90 cursor-pointer">
                      <input
                        type="checkbox"
                        checked={disintegrates}
                        onChange={(e) => setDisintegrates(e.target.checked)}
                        className="h-3.5 w-3.5 accent-[var(--arc-accent)]"
                      />
                      <span>
                        Se desintegra tras 1 ataque (p. ej. se derrite/oxida sin importar si acierta)
                      </span>
                    </label>

                    <div className="flex flex-wrap gap-2">
                      <button
                        type="button"
                        onClick={() => handleConfirmImbue(weapon.id)}
                        className="min-h-[38px] rounded-lg bg-[var(--arc-action)] px-3.5 text-xs font-semibold text-[var(--arc-action-text)] hover:bg-[var(--arc-action-hover)] shadow-sm transition-colors"
                      >
                        Confirmar imbuición
                      </button>
                      <button
                        type="button"
                        onClick={() => setImbuingWeaponId(null)}
                        className="min-h-[38px] rounded-lg bg-transparent px-3 text-xs text-[var(--arc-muted)] hover:bg-[var(--arc-raised)] hover:text-[var(--arc-text)] transition-colors"
                      >
                        Cancelar
                      </button>
                    </div>
                  </div>
                )}
              </article>
            );
          })}
        </div>
      )}
    </section>
  );
}
