                                    >
                                      <X className="h-3.5 w-3.5" />
                                      Cancelar
                                    </button>
                                  </div>
                                </div>
                              )}
                            </div>
                          );
                        })}
                      </div>
                    )}
                  </div>
                );
              })}
            </div>
          )}
        </div>
      )}

      {/* VISTA 2: APLICAR ESTADO MANUAL */}
      {subTab === 'apply' && (
        <div className="space-y-4">
          {combatants.length === 0 ? (
