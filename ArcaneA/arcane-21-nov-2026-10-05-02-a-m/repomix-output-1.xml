              className="min-h-[42px] flex-1 sm:flex-none rounded-lg border border-[var(--arc-border)] bg-[var(--arc-input)] px-3 text-xs text-[var(--arc-text)]"
            >
              <option value="mage">Mago (valor inicial 0 · Nv. 1)</option>
