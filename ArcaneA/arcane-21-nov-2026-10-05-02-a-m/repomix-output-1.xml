  formula: FormulaConfig
): string {
  if (spell.effectType === 'damage' || spell.effectType === 'heal') {
    const mastery = character
      ? getSpellMasteryStatus(character.spellMastery?.[spell.id] || 0, formula)
      : undefined;
    const effectiveDice =
      spell.effectType === 'damage' && mastery
        ? getEffectiveSpellDamageDice(spell, mastery)
        : spell.damage.dice;
    const diceStr = effectiveDice.map((d) => `${d.count}${d.type}`).join(' + ');
    const bonusStr = spell.damage.bonus ? ` + ${spell.damage.bonus}` : '';
    const full = `${diceStr}${bonusStr}`.trim();
    if (full) {
      return spell.damageMode === 'manual' ? `${full} (man.)` : full;
    }
    return spell.damageMode === 'manual' ? 'Manual' : '—';
  }
  if (spell.armorConfig?.isArmor) {
    const red = spell.armorConfig.damageReduction ?? 0;
    const div =
      spell.armorConfig.damageDivisor === 2
        ? ' · ÷2'
        : spell.armorConfig.damageDivisor === 4
          ? ' · ÷4'
          : spell.armorConfig.damageDivisor === 0
            ? ' · Anula'
            : '';
    const hits = spell.armorConfig.maxHits ?? spell.maxHits ?? 0;
    const hitsTxt = hits > 0 ? ` · ${hits}g` : '';
    return `Red. +${red}${div}${hitsTxt}`;
  }
  if ((spell.maxHits ?? 0) > 0) {
    return `${spell.maxHits} ${spell.maxHits === 1 ? 'golpe' : 'golpes'}`;
  }
  if (spell.id === 'basic_proteccion') {
    return '-3 mág / -5 fís';
  }
  if (spell.id === 'basic_reforzar_hechizo') {
    return 'Daño ×2 (mayor)';
  }
  if (spell.id === 'basic_hechizo_veloz') {
    return '2 acciones';
  }
  if (spell.id === 'basic_elevar_limite') {
    return '3 acciones';
  }
  if (spell.statuses && spell.statuses.length > 0) {
    return spell.statuses.join(' / ');
  }
  return '—';
}

function formatCompactRollDice(
  spell: Spell,
  character: Character | undefined,
  formula: FormulaConfig
): string {
  if (!character) return '—';
  const mastery = getSpellMasteryStatus(character.spellMastery?.[spell.id] || 0, formula);
  const assured =
    spell.assuredSuccess + (spellSupportsMastery(spell) ? mastery.bonusAssured : 0);
  if (spell.effectType === 'damage' || spell.effectType === 'defense') {
    const stats = spell.combatStats.length > 0 ? spell.combatStats : ['fisico' as const];
    const totalDice = stats.reduce(
      (acc, st) => acc + getCharacterStatDice(character, st, formula),
      0
    );
    return `${totalDice}d6${assured > 0 ? ` +${assured}` : ''}`;
  }
  if (spell.id === 'basic_interrumpir_circulo') {
    const totalDice =
      getCharacterStatDice(character, 'influencia', formula) +
      getCharacterStatDice(character, 'manipulacion', formula);
    return `${totalDice}d6${assured > 0 ? ` +${assured}` : ''}`;
  }
  if (
    (spell.statuses && spell.statuses.length > 0) ||
    (spell.effectType === 'effect' && getEffectiveEffectSubType(spell) === 'debuff')
  ) {
    const infDice = getCharacterStatDice(character, 'influencia', formula);
    return `${infDice}d6 Inf`;
  }
  if (spell.castStat !== 'none') {
    const dice =
      spell.castStat === 'manual'
        ? spell.manualCastDice
        : getCharacterStatDice(character, spell.castStat, formula);
    return `${dice}d6${assured > 0 ? ` +${assured}` : ''}`;
  }
  return 'Auto';
}

export function QuickCastPanel({
  spells,
  activeCharacter,
  combatants,
  characters,
  selectedTargetId,
  onSelectTarget,
  formula,
  spellOrder,
  manaMode,
  isAttackLethal,
  onToggleLethal,
  onCastSpell,
  onAttackSpell,
  onDefendTestSpell,
  onHealSpell,
  onApplyStatusSpell,
  onTestSpell,
  autoPassSecondsLeft = null,
  onAdvanceTurn,
  onToggleFavoriteSpell,
}: QuickCastPanelProps) {
  const [originFilter, setOriginFilter] = useState<QuickOriginFilter>('all');
  const [roleFilter, setRoleFilter] = useState<QuickRoleFilter>('all');
  const [onlyAffordable, setOnlyAffordable] = useState(false);
  const [query, setQuery] = useState('');
  const [favoritesOnly, setFavoritesOnly] = useState(false);
  const [personalTagFilter, setPersonalTagFilter] = useState('');
  const [inspectedSpell, setInspectedSpell] = useState<{
    spell: Spell;
    actions: SpellInspectorAction[];
    dependencyStatus?: { met: boolean; reason?: string };
  } | null>(null);

  const knownIds = new Set(activeCharacter?.knownSpells || []);
  const activeCombatant = combatants.find((cb) => cb.characterId === activeCharacter?.id);
  const activeStatusEffects = getCombatantStatusEffects(activeCombatant, activeCharacter);
  const turnStatus = getCombatantTurnActionStatus(activeCombatant);
  const outOfTurnActions = Boolean(activeCombatant && turnStatus.remaining <= 0);
  const preparedSpellMap = new Map(
    (activeCombatant?.preparedSpells || []).map((p) => [p.spellId, p])
  );
  const preparedSpellIds = new Set(preparedSpellMap.keys());
  const potentialTargets = combatants.filter((cb) => cb.characterId !== activeCharacter?.id);

  const orderIndexMap = new Map(spellOrder.map((id, idx) => [id, idx]));

  const knownSpells = spells
    .filter((s) => knownIds.has(s.id))
    .sort((a, b) => {
      const idxA = orderIndexMap.get(a.id);
      const idxB = orderIndexMap.get(b.id);
      if (idxA !== undefined && idxB !== undefined) return idxA - idxB;
      if (idxA !== undefined) return -1;
      if (idxB !== undefined) return 1;
      if (!a.isBasic && b.isBasic) return -1;
      if (a.isBasic && !b.isBasic) return 1;
      return a.name.localeCompare(b.name);
    });

  const getEffectiveMana = (spell: Spell): { cost: number; isPrepared: boolean; shieldDiscount: number } => {
    const isPrepared = spell.effectType === 'damage' && preparedSpellIds.has(spell.id);
    if (isPrepared) return { cost: 0, isPrepared: true, shieldDiscount: 0 };
    const defMana = getEffectiveDefenseManaCost(
      activeCharacter,
      spell,
      activeStatusEffects.disarmed
    );
    return { cost: defMana.cost, isPrepared: false, shieldDiscount: defMana.discount };
  };

  const currentMana = activeCharacter?.mana.current ?? 0;

  const customCount = knownSpells.filter((s) => !s.isBasic).length;
  const baseCount = knownSpells.length - customCount;

  const affordableCount = knownSpells.filter((s) => {
    const { cost } = getEffectiveMana(s);
    return cost <= currentMana;
  }).length;

  const normalizedQuery = query.trim().toLowerCase();

  const filteredSpells = knownSpells.filter((s) => {
    if (originFilter === 'base' && !s.isBasic) return false;
    if (originFilter === 'custom' && s.isBasic) return false;

    if (roleFilter !== 'all') {
      if (getSpellCategory(s) !== roleFilter) return false;
    }
    if (favoritesOnly && !(activeCharacter?.favoriteSpellIds || []).includes(s.id)) return false;
    if (
      personalTagFilter &&
      !(activeCharacter?.personalSpellTags?.[s.id] || []).includes(personalTagFilter)
    ) return false;

    if (onlyAffordable) {
      const { cost } = getEffectiveMana(s);
      if (cost > currentMana) return false;
    }

    if (normalizedQuery && !s.name.toLowerCase().includes(normalizedQuery)) {
      return false;
    }

    return true;
  });

  return (
    <section className="rounded-xl border border-[var(--arc-border)] bg-[var(--arc-surface)] p-4 sm:p-5 space-y-3.5">
      {/* Encabezado limpio con datos clave del personaje */}
      <div className="flex flex-wrap items-start justify-between gap-3 border-b border-[var(--arc-border)] pb-3">
        <div>
          <h2 className="font-display text-lg sm:text-xl font-bold text-[var(--arc-accent)] flex items-center gap-2">
            <Zap className="h-5 w-5 shrink-0" />
            Casteo rápido — {activeCharacter?.name || 'Personaje'}
          </h2>
          <p className="text-[13px] text-[var(--arc-muted)] mt-0.5 font-mono-num">
            {activeCharacter ? (
              <>
                Maná {activeCharacter.mana.current}/{activeCharacter.mana.max}
                {activeCombatant && (
                  <>
                    {' · '}Acciones {turnStatus.remaining}/{turnStatus.max}
                  </>
                )}
                {' · '}
                {affordableCount}/{knownSpells.length} lanzables ahora
              </>
            ) : (
              'Seleccioná un personaje en la barra superior.'
            )}
          </p>
        </div>

        {/* Selector rápido de objetivo y Letal / No letal */}
        {activeCharacter && (
          <div className="flex flex-wrap items-center gap-2">
            {potentialTargets.length > 0 && (
              <select
                value={selectedTargetId}
                onChange={(e) => onSelectTarget(e.target.value)}
                aria-label="Objetivo de ataque rápido"
                className="min-h-[36px] max-w-[200px] rounded-lg border border-[var(--arc-border)] bg-[var(--arc-input)] px-2.5 text-xs text-[var(--arc-text)]"
              >
                {potentialTargets.map((cb) => {
                  const targetChar = characters.find((c) => c.id === cb.characterId);
                  if (!targetChar) return null;
                  return (
                    <option key={cb.id} value={cb.id}>
                      Obj: {targetChar.name} (PV {targetChar.hp.current}/{targetChar.hp.max})
                    </option>
                  );
                })}
              </select>
            )}

            <div
              className="inline-flex rounded-lg bg-[var(--arc-input)] p-0.5"
              role="group"
              aria-label="Tipo de golpe en casteo rápido"
            >
              <button
                type="button"
                onClick={() => onToggleLethal(false)}
                className={`min-h-[32px] rounded-md px-2.5 text-xs font-semibold whitespace-nowrap shrink-0 transition-colors ${
                  !isAttackLethal
                    ? 'bg-[var(--arc-raised)] text-[var(--arc-accent)]'
                    : 'text-[var(--arc-muted)] hover:text-[var(--arc-text)]'
                }`}
              >
                No letal
              </button>
              <button
                type="button"
                onClick={() => onToggleLethal(true)}
                className={`min-h-[32px] rounded-md px-2.5 text-xs font-semibold whitespace-nowrap shrink-0 transition-colors ${
                  isAttackLethal
                    ? 'bg-[#7a2e1f] text-[#ffe1d8]'
                    : 'text-[var(--arc-muted)] hover:text-[var(--arc-text)]'
                }`}
              >
                Letal
              </button>
            </div>
          </div>
        )}
      </div>

      {activeCombatant && activeStatusEffects.summaryTags.length > 0 && (
        <div className="flex flex-wrap items-center gap-1.5 rounded-lg border border-[#723b26] bg-[#26140d] px-3 py-2 text-xs text-[#ffd2be]">
          <span className="font-bold text-[#ff9f7c]">Estados activos:</span>
          {activeStatusEffects.summaryTags.map((tag) => (
            <span
              key={tag}
              className="rounded bg-black/30 px-2 py-0.5 text-[11px] font-semibold text-[#ffe0d1]"
            >
              {tag}
            </span>
          ))}
        </div>
      )}

      {outOfTurnActions && activeCharacter && (
        <div className="flex flex-wrap items-center justify-between gap-2 rounded-lg bg-[#33220c] px-3 py-2 text-xs text-[#ffd28a]">
          <span>
            {autoPassSecondsLeft !== null ? (
              <>
                Acciones agotadas ({turnStatus.used}/{turnStatus.max}) · pasando turno en{' '}
                <strong className="font-mono-num text-white">{autoPassSecondsLeft}s</strong>
                {!turnStatus.hasHechizoVeloz
                  ? ' (podés activar Hechizo Veloz antes de que pase).'
                  : '.'}
              </>
            ) : (
              <>
                Sin acciones restantes este turno ({turnStatus.used}/{turnStatus.max}). Activá{' '}
                <strong>
                  {!turnStatus.hasHechizoVeloz
                    ? 'Hechizo Veloz'
                    : !turnStatus.hasElevarLimite
                      ? 'Elevar el Límite'
                      : 'otro turno'}
                </strong>{' '}
                o pasá el turno.
              </>
            )}
          </span>
          {onAdvanceTurn && (
            <button
              type="button"
              onClick={onAdvanceTurn}
              className="min-h-[30px] inline-flex items-center gap-1 rounded-md bg-[var(--arc-action)] px-2.5 text-xs font-semibold text-[var(--arc-action-text)] hover:bg-[var(--arc-action-hover)] whitespace-nowrap shrink-0 transition-colors"
            >
              <SkipForward className="h-3.5 w-3.5" />
              Pasar turno
            </button>
          )}
        </div>
      )}

      {/* Filtros compactos */}
      <div className="space-y-2">
        <div className="flex flex-wrap items-center justify-between gap-2">
          <div className="flex flex-wrap items-center gap-1.5">
            {/* Propios vs Base */}
            <div className="inline-flex p-0.5 rounded-lg bg-[var(--arc-input)]">
              {(
                [
                  { id: 'all', label: `Todo (${knownSpells.length})` },
                  { id: 'custom', label: `Propios (${customCount})` },
                  { id: 'base', label: `Base (${baseCount})` },
                ] as const
              ).map((opt) => (
                <button
                  key={opt.id}
                  type="button"
                  onClick={() => setOriginFilter(opt.id)}
                  className={`min-h-[30px] px-2.5 text-xs font-semibold rounded-md whitespace-nowrap shrink-0 transition-colors ${
                    originFilter === opt.id
                      ? 'bg-[var(--arc-raised)] text-[var(--arc-accent)]'
                      : 'text-[var(--arc-muted)] hover:text-[var(--arc-text)]'
                  }`}
                >
                  {opt.label}
                </button>
              ))}
            </div>

            <button
              type="button"
              onClick={() => setOnlyAffordable((v) => !v)}
              className={`min-h-[32px] inline-flex items-center gap-1.5 rounded-lg px-2.5 text-xs font-semibold whitespace-nowrap shrink-0 transition-colors ${
                onlyAffordable
                  ? 'bg-[var(--arc-action)] text-[var(--arc-action-text)]'
                  : 'bg-[var(--arc-input)] text-[var(--arc-muted)] hover:text-[var(--arc-text)]'
              }`}
            >
              Solo con maná ({affordableCount})
            </button>
            <button
              type="button"
              onClick={() => setFavoritesOnly((value) => !value)}
              className={`min-h-[32px] inline-flex items-center gap-1.5 rounded-lg px-2.5 text-xs font-semibold whitespace-nowrap transition-colors ${
                favoritesOnly
                  ? 'bg-[var(--arc-action)] text-[var(--arc-action-text)]'
                  : 'bg-[var(--arc-input)] text-[var(--arc-muted)] hover:text-[var(--arc-text)]'
              }`}
            >
              <Star className={`h-3.5 w-3.5 ${favoritesOnly ? 'fill-current' : ''}`} />
              Favoritos ({knownSpells.filter((spell) => activeCharacter?.favoriteSpellIds?.includes(spell.id)).length})
            </button>
            {(activeCharacter?.personalSpellTagNames || []).length > 0 && (
              <select
                aria-label="Filtrar por etiqueta personal"
                value={personalTagFilter}
                onChange={(event) => setPersonalTagFilter(event.target.value)}
                className="min-h-[32px] max-w-[170px] rounded-lg border border-[var(--arc-border)] bg-[var(--arc-input)] px-2 text-xs text-[var(--arc-text)]"
              >
                <option value="">Todas las etiquetas</option>
                {activeCharacter?.personalSpellTagNames?.map((tag) => (
                  <option key={tag} value={tag}>{tag}</option>
                ))}
              </select>
            )}
          </div>

          {/* Buscador rápido */}
          <div className="relative flex-1 min-w-[160px] max-w-[240px]">
            <Search
              className="pointer-events-none absolute left-2.5 top-1/2 -translate-y-1/2 h-3.5 w-3.5 text-[var(--arc-muted)]"
              aria-hidden="true"
            />
            <input
              type="text"
              value={query}
              onChange={(e) => setQuery(e.target.value)}
              placeholder="Buscar hechizo..."
              aria-label="Buscar hechizo en casteo rápido"
              className="w-full min-h-[32px] rounded-lg border border-[var(--arc-border)] bg-[var(--arc-input)] pl-8 pr-2.5 text-xs text-[var(--arc-text)] placeholder:text-[var(--arc-muted)]"
            />
          </div>
        </div>

        {/* Filtro por categoría (6 categorías separadas por color e icono) */}
        <div className="flex flex-wrap items-center gap-1">
          {ROLE_FILTER_OPTIONS.map((opt) => (
            <button
              key={opt.value}
              type="button"
              onClick={() => setRoleFilter(opt.value)}
              className={`min-h-[30px] inline-flex items-center gap-1.5 rounded-md px-2.5 text-xs font-semibold whitespace-nowrap shrink-0 transition-colors ${
                roleFilter === opt.value
                  ? opt.value === 'all'
                    ? 'bg-[var(--arc-raised)] text-[var(--arc-accent)]'
                    : CAT_ACTIVE_FILTER_CLASSES[opt.value]
                  : 'text-[var(--arc-muted)] hover:bg-[var(--arc-surface-alt)] hover:text-[var(--arc-text)]'
              }`}
            >
              {opt.value !== 'all' && (
                <SpellCategoryIcon category={opt.value} className="h-3.5 w-3.5" />
              )}
              {opt.label}
            </button>
          ))}
        </div>
      </div>

      {/* Tabla / Lista compacta: solo Nombre, Tipo, Daño, Maná, Tirada y Acción */}
      {!activeCharacter ? (
        <p className="py-6 text-center text-sm text-[var(--arc-muted)]">
          Creá o seleccioná un personaje para usar el casteo rápido.
        </p>
      ) : filteredSpells.length === 0 ? (
        <div className="rounded-lg border border-[var(--arc-border)] bg-[var(--arc-surface-alt)] px-4 py-6 text-center space-y-1.5">
          <p className="text-sm font-semibold text-[var(--arc-text)]">
            No hay hechizos que coincidan con este filtro.
          </p>
          <p className="text-xs text-[var(--arc-muted)]">
            {onlyAffordable
              ? `Maná actual de ${activeCharacter.name}: ${currentMana}/${activeCharacter.mana.max}. Desactivá "Solo con maná" para ver todos los conocidos.`
              : 'Agregá hechizos conocidos desde el Grimorio o limpiá la búsqueda.'}
          </p>
        </div>
      ) : (
        <div className="rounded-lg border border-[var(--arc-border)] bg-[var(--arc-surface-alt)] overflow-hidden">
          {/* Encabezado de columnas en escritorio */}
          <div className="hidden sm:grid sm:grid-cols-12 items-center gap-2 border-b border-[var(--arc-border)] bg-[var(--arc-surface)] px-3.5 py-2 text-[11px] font-bold uppercase tracking-wider text-[var(--arc-muted)]">
            <div className="col-span-4">Hechizo · Tipo</div>
            <div className="col-span-3">Daño / Efecto</div>
            <div className="col-span-2 text-right">Maná · Dados</div>
            <div className="col-span-3 text-right">Acción</div>
          </div>

          <ul className="divide-y divide-[var(--arc-border)]">
            {filteredSpells.map((spell) => {
              const isMagical = isSpellMagical(spell);
              const dmgKind = getEffectiveSpellDamageKind(spell);
              const isSonic = isSonicSpell(spell);
              const isFire = isFireDamageSpell(spell);
              const effectSub =
                spell.effectType === 'effect' ? getEffectiveEffectSubType(spell) : null;
              const { cost: effectiveMana, isPrepared, shieldDiscount } = getEffectiveMana(spell);
              const preparedEntry = preparedSpellMap.get(spell.id);
              const lacksMana = manaMode === 'auto' && effectiveMana > currentMana;
              const canCast = spellAllowsDirectCastButton(spell);
              const castReq = getSpellCastRequirement(spell);
              const requiresPrepareFirst =
                spell.effectType === 'damage' && castReq === 'prepare' && !isPrepared;
              const consumesAction = spellConsumesTurnAction(spell);
              const blockedByTurn = outOfTurnActions && consumesAction;

              const damageText = formatCompactDamage(spell, activeCharacter, formula);
              const rollDiceText = formatCompactRollDice(spell, activeCharacter, formula);

              const spellCat = getSpellCategory(spell);
              const roleLabel = SPELL_CATEGORY_LABELS[spellCat];

              const isElevarBlocked =
                spell.id === 'basic_elevar_limite' && !turnStatus.hasHechizoVeloz;
              const isElevarActive =
                spell.id === 'basic_elevar_limite' && turnStatus.hasElevarLimite;
              const isVelozActive =
                spell.id === 'basic_hechizo_veloz' && turnStatus.hasHechizoVeloz;
              const isTurnBuffLocked = isElevarBlocked || isElevarActive || isVelozActive;

              const depCheck = evaluateSpellDependency({
                spell,
                casterCharacterId: activeCharacter?.id,
                combatants,
                characters,
                targetCombatantId: selectedTargetId,
              });
              const blockedByDependency = depCheck.hasDependency && !depCheck.met;

              let statusBlockReason: string | null = null;
              if (activeCombatant) {
                if (activeStatusEffects.cannotAct) {
                  statusBlockReason = `Impedido (${activeStatusEffects.cannotActReasons.join(', ')})`;
                } else if (spell.effectType === 'damage' && activeStatusEffects.cannotAttack) {
                  statusBlockReason = `No podés atacar (${activeStatusEffects.cannotAttackReasons.join(', ')})`;
                } else if (spell.effectType === 'defense' && activeStatusEffects.cannotDefend) {
                  statusBlockReason = `No podés defender (${activeStatusEffects.cannotDefendReasons.join(', ')})`;
                } else if (isMagical && activeStatusEffects.cannotCastMagic) {
                  statusBlockReason = `Silenciado (${activeStatusEffects.cannotCastMagicReasons.join(', ')})`;
                } else if (
                  turnStatus.isSlowed &&
                  (spell.id === 'basic_hechizo_veloz' || spell.id === 'basic_elevar_limite')
                ) {
                  statusBlockReason = 'Ralentizado (máx. 1 acción)';
                }
              }
              const blockedByStatus = Boolean(statusBlockReason);
              const hardBlocked = blockedByDependency || blockedByStatus;
              const hardBlockReason =
                statusBlockReason || depCheck.missingReason || `Falta: ${depCheck.requiredName}`;

              const typeIsMagic = spell.effectType === 'damage' ? dmgKind === 'magico' : isMagical;
              const typeLabel = typeIsMagic
                ? isSonic
                  ? 'Mágico (Sónico)'
                  : 'Mágico'
                : 'Físico';
              const actionBlockedReason = hardBlocked
                ? hardBlockReason
                : lacksMana
                  ? `Maná insuficiente (${currentMana}/${activeCharacter?.mana.max ?? 0}).`
                  : isTurnBuffLocked
                    ? isElevarBlocked
                      ? 'Requiere Hechizo Veloz activo primero.'
                      : 'Ya está activo este turno.'
                    : blockedByTurn
                      ? 'Sin acciones restantes este turno.'
                      : undefined;
              const inspectActions: SpellInspectorAction[] = hardBlocked
                ? [
                    {
                      label: 'Bloqueado',
                      disabled: true,
                      reason: actionBlockedReason,
                      onClick: () => undefined,
                    },
                  ]
                : spell.effectType === 'damage'
                  ? requiresPrepareFirst
                    ? [
                        {
                          label: 'Castear y preparar',
                          disabled: lacksMana || blockedByTurn,
                          reason: actionBlockedReason,
                          onClick: () => onCastSpell(spell),
                        },
                      ]
                    : [
                        ...(canCast && !isPrepared
                          ? [
                              {
                                label: 'Castear',
                                disabled: lacksMana || blockedByTurn,
                                reason: actionBlockedReason,
                                onClick: () => onCastSpell(spell),
                              },
                            ]
                          : []),
                        {
                          label: 'Atacar',
                          disabled: lacksMana || blockedByTurn,
                          reason: actionBlockedReason,
                          onClick: () => onAttackSpell(spell),
                        },
                      ]
                  : spell.effectType === 'defense'
                    ? [
                        {
                          label: 'Defender',
                          onClick: () => onDefendTestSpell(spell),
                        },
                      ]
                    : spell.effectType === 'heal'
                      ? [
                          {
                            label: 'Curar',
                            disabled: lacksMana || blockedByTurn,
                            reason: actionBlockedReason,
                            onClick: () => onHealSpell(spell),
                          },
                        ]
                      : [
                          {
                            label:
                              spell.statuses.length > 0
                                ? 'Aplicar estado'
                                : effectSub === 'debuff'
                                  ? 'Aplicar efecto'
                                  : 'Activar',
                            disabled:
                              lacksMana ||
                              blockedByTurn ||
                              (!spell.statuses.length && isTurnBuffLocked),
                            reason: actionBlockedReason,
                            onClick: () =>
                              spell.statuses.length > 0 || effectSub === 'debuff'
                                ? onApplyStatusSpell(spell)
                                : onCastSpell(spell),
                          },
                        ];

              return (
                <li
                  key={spell.id}
                  className={`px-3.5 py-2.5 transition-colors hover:bg-[var(--arc-surface)]/70 ${
                    lacksMana || blockedByTurn || hardBlocked ? 'opacity-65' : ''
                  }`}
                >
                  <div className="grid grid-cols-1 sm:grid-cols-12 items-center gap-2">
                    {/* Columna 1: Nombre + Categoría (emblema + color) + Tipo (Mágico/Físico) */}
                    <div className="sm:col-span-4 min-w-0">
                      <div className="flex items-center gap-1.5 min-w-0">
                        <span className={CAT_BADGE_CLASSES[spellCat]}>
                          <SpellCategoryIcon category={spellCat} className="h-4 w-4" />
                        </span>
                        <span
                          className={`text-sm font-bold truncate ${CAT_BADGE_CLASSES[spellCat]}`}
                        >
                          {spell.name}
                        </span>
                        <button
                          type="button"
                          onClick={() =>
                            setInspectedSpell({
                              spell,
                              actions: inspectActions,
                              dependencyStatus: depCheck.hasDependency
                                ? {
                                    met: depCheck.met,
                                    reason: depCheck.missingReason,
                                  }
                                : undefined,
                            })
                          }
                          aria-label={`Consultar ficha de ${spell.name}`}
                          title="Consultar ficha completa"
                          className="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded text-[var(--arc-muted)] hover:bg-[var(--arc-raised)] hover:text-[var(--arc-accent)]"
                        >
                          <Eye className="h-3.5 w-3.5" />
                        </button>
                        <button
                          type="button"
                          onClick={() => onToggleFavoriteSpell(spell.id)}
                          aria-label={
                            activeCharacter?.favoriteSpellIds?.includes(spell.id)
                              ? `Quitar ${spell.name} de favoritos`
                              : `Marcar ${spell.name} como favorito`
                          }
                          aria-pressed={activeCharacter?.favoriteSpellIds?.includes(spell.id) || false}
                          className={`inline-flex h-6 w-6 shrink-0 items-center justify-center rounded ${
                            activeCharacter?.favoriteSpellIds?.includes(spell.id)
                              ? 'text-[var(--arc-accent)]'
                              : 'text-[var(--arc-muted)] hover:text-[var(--arc-text)]'
                          }`}
                        >
                          <Star className={`h-3.5 w-3.5 ${
                            activeCharacter?.favoriteSpellIds?.includes(spell.id) ? 'fill-current' : ''
                          }`} />
                        </button>
                        {isFire && (
                          <Flame
                            className="h-3.5 w-3.5 shrink-0 text-[#ff935c]"
                            aria-label="Daño de fuego"
                          />
                        )}
                      </div>
                      <div className="flex flex-wrap items-center gap-x-1.5 text-xs text-[var(--arc-muted)] mt-0.5">
                        <span className={`font-semibold ${CAT_BADGE_CLASSES[spellCat]}`}>
                          {roleLabel}
                        </span>
                        <span aria-hidden="true">·</span>
                        <span
                          className={
                            typeIsMagic
                              ? 'font-medium text-[var(--arc-magic-text)]'
                              : 'font-medium text-[var(--arc-phys-text)]'
                          }
                        >
                          {typeLabel}
                        </span>
                        {isPrepared && (
                          <>
                            <span aria-hidden="true">·</span>
                            <span className="font-semibold text-[var(--arc-accent)] font-mono-num">
                              Preparado
                              {typeof preparedEntry?.remainingTurns === 'number'
                                ? ` (${preparedEntry.remainingTurns}/${
                                    preparedEntry.durationTurns || preparedEntry.remainingTurns
                                  }t)`
                                : ''}
                            </span>
                          </>
                        )}
                        {spell.areaConfig?.enabled && (
                          <>
                            <span aria-hidden="true">·</span>
                            <span className="font-semibold text-[#9fd2ff]">
                              {formatSpellAreaSummary(spell.areaConfig)}
                            </span>
                          </>
                        )}
                      </div>
                      {blockedByStatus && (
                        <div className="mt-1 inline-flex items-center gap-1 text-xs font-semibold text-[#ff9a76]">
                          <Lock className="h-3 w-3 shrink-0" />
                          <span>{statusBlockReason}</span>
                        </div>
                      )}
                      {!blockedByStatus && blockedByDependency && (
                        <div className="mt-1 inline-flex items-center gap-1 text-xs font-semibold text-[#f3b562]">
                          <Lock className="h-3 w-3 shrink-0" />
                          <span>{depCheck.missingReason || `Falta: ${depCheck.requiredName}`}</span>
                        </div>
                      )}
                      {depCheck.hasDependency && depCheck.met && (
                        <div className="mt-1 inline-flex items-center gap-1 text-xs text-[#8ee0a4]">
                          <Link2 className="h-3 w-3 shrink-0" />
                          <span>
                            Condición cumplida · {formatSpellDependencyLine(spell.dependency)}
                          </span>
                        </div>
                      )}
                    </div>

                    {/* Columna 2: Daño / Valor clave */}
                    <div className="sm:col-span-3 flex items-center justify-between sm:block">
                      <span className="text-xs text-[var(--arc-muted)] sm:hidden">Daño / Efecto</span>
                      <span
                        className={`font-mono-num text-sm font-bold ${
                          spell.effectType === 'damage'
                            ? 'text-[var(--arc-text)]'
                            : spell.effectType === 'heal'
                              ? 'text-[#8ee0a4]'
                              : 'text-[var(--arc-muted)] font-medium text-xs'
                        }`}
                      >
                        {damageText}
                      </span>
                    </div>

                    {/* Columna 3: Costo de maná y dados de tirada */}
                    <div className="sm:col-span-2 flex items-center justify-between sm:block sm:text-right font-mono-num">
                      <span
                        className={`text-xs font-bold ${
                          lacksMana
                            ? 'text-[#f08b72]'
                            : isPrepared
                              ? 'text-[var(--arc-accent)]'
                              : 'text-[var(--arc-text)]'
                        }`}
                      >
                        {isPrepared
                          ? '0 maná'
                          : shieldDiscount > 0
                            ? `${effectiveMana}m (-${shieldDiscount})`
                            : `${effectiveMana} maná`}
                      </span>
                      <div className="text-xs text-[var(--arc-muted)]">{rollDiceText}</div>
                    </div>

                    {/* Columna 4: Botón directo de lanzamiento */}
                    <div className="sm:col-span-3 flex flex-wrap items-center justify-end gap-1.5">
                      {hardBlocked ? (
                        <button
                          type="button"
                          disabled
                          title={hardBlockReason}
                          className="min-h-[34px] inline-flex items-center gap-1.5 rounded-lg bg-[var(--arc-raised)] px-3 text-xs font-semibold text-[#f3b562] opacity-85 cursor-not-allowed whitespace-nowrap shrink-0"
                        >
                          <Lock className="h-3.5 w-3.5 shrink-0" />
                          Bloqueado
                        </button>
                      ) : (
                        <>
                          {spell.effectType === 'damage' && (
                            <>
                              {requiresPrepareFirst ? (
                                <button
                                  type="button"
                                  disabled={lacksMana || blockedByTurn}
                                  onClick={() => onCastSpell(spell)}
                                  title={
                                    blockedByTurn
                                      ? 'Sin acciones restantes este turno — activá Hechizo Veloz o pasá el turno'
                                      : 'Castear y preparar hechizo (gasta 1 acción)'
                                  }
                                  className="min-h-[34px] inline-flex items-center gap-1.5 rounded-lg bg-[var(--arc-action)] px-3 text-xs font-semibold text-[var(--arc-action-text)] hover:bg-[var(--arc-action-hover)] disabled:opacity-40 disabled:cursor-not-allowed whitespace-nowrap shrink-0 transition-colors"
                                >
                                  <Sparkles className="h-3.5 w-3.5" />
                                  Castear
                                </button>
                              ) : (
                                <>
                                  {canCast && !isPrepared && (
                                    <button
                                      type="button"
                                      disabled={lacksMana || blockedByTurn}
                                      onClick={() => onCastSpell(spell)}
                                      title={
                                        blockedByTurn
                                          ? 'Sin acciones restantes este turno'
                                          : 'Declarar casteo (gasta 1 acción)'
                                      }
                                      className="min-h-[34px] inline-flex items-center gap-1 rounded-md bg-transparent px-2 text-xs font-semibold text-[var(--arc-muted)] hover:bg-[var(--arc-raised)] hover:text-[var(--arc-text)] disabled:opacity-40 disabled:cursor-not-allowed whitespace-nowrap shrink-0 transition-colors"
                                    >
                                      <Sparkles className="h-3.5 w-3.5" />
                                      Castear
                                    </button>
                                  )}
                                  <button
                                    type="button"
                                    disabled={lacksMana || blockedByTurn}
                                    onClick={() => onAttackSpell(spell)}
                                    title={
                                      blockedByTurn
                                        ? 'Sin acciones restantes este turno — activá Hechizo Veloz o pasá el turno'
                                        : undefined
                                    }
                                    className="min-h-[34px] inline-flex items-center gap-1.5 rounded-lg bg-[var(--arc-action)] px-3 text-xs font-semibold text-[var(--arc-action-text)] hover:bg-[var(--arc-action-hover)] disabled:opacity-40 disabled:cursor-not-allowed whitespace-nowrap shrink-0 transition-colors"
                                  >
                                    <Swords className="h-3.5 w-3.5" />
                                    Atacar
                                  </button>
                                </>
                              )}
                            </>
                          )}

                          {spell.effectType === 'defense' && (
                            <button
                              type="button"
                              onClick={() => onDefendTestSpell(spell)}
                              className="min-h-[34px] inline-flex items-center gap-1.5 rounded-lg bg-[var(--arc-def-raised)] border border-[var(--arc-def-border)] px-3 text-xs font-semibold text-[var(--arc-def-text)] hover:brightness-110 whitespace-nowrap shrink-0 transition-all"
                            >
                              <Shield className="h-3.5 w-3.5 text-[var(--arc-def-accent)]" />
                              Defender
                            </button>
                          )}

                          {spell.effectType === 'heal' && (
                            <button
                              type="button"
                              disabled={lacksMana || blockedByTurn}
                              onClick={() => onHealSpell(spell)}
                              title={blockedByTurn ? 'Sin acciones restantes este turno' : undefined}
                              className="min-h-[34px] inline-flex items-center gap-1.5 rounded-lg bg-[var(--arc-action)] px-3 text-xs font-semibold text-[var(--arc-action-text)] hover:bg-[var(--arc-action-hover)] disabled:opacity-40 disabled:cursor-not-allowed whitespace-nowrap shrink-0 transition-colors"
                            >
                              <HeartPulse className="h-3.5 w-3.5" />
                              Curar
                            </button>
                          )}

                          {spell.effectType === 'effect' &&
                            (!spell.statuses || spell.statuses.length === 0) && (
                              <button
                                type="button"
                                disabled={lacksMana || isTurnBuffLocked || blockedByTurn}
                                onClick={() =>
                                  effectSub === 'debuff'
                                    ? onApplyStatusSpell(spell)
                                    : onCastSpell(spell)
                                }
                                title={
                                  isElevarBlocked
                                    ? 'Requiere Hechizo Veloz activo primero'
                                    : isElevarActive || isVelozActive
                                      ? 'Ya activo este turno'
                                      : blockedByTurn
                                        ? 'Sin acciones restantes este turno'
                                        : undefined
                                }
                                className={`min-h-[34px] inline-flex items-center gap-1.5 rounded-lg px-3 text-xs font-semibold whitespace-nowrap shrink-0 transition-colors ${
                                  lacksMana || isTurnBuffLocked || blockedByTurn
                                    ? 'bg-[var(--arc-raised)] text-[var(--arc-muted)] opacity-50 cursor-not-allowed'
                                    : effectSub === 'debuff'
                                      ? 'bg-[#b85a3a] text-white hover:bg-[#cc6644]'
                                      : 'bg-[var(--arc-action)] text-[var(--arc-action-text)] hover:bg-[var(--arc-action-hover)]'
                                }`}
                              >
                                {isElevarBlocked ? (
                                  <Lock className="h-3.5 w-3.5" />
                                ) : spell.armorConfig?.isArmor ? (
                                  <ShieldPlus className="h-3.5 w-3.5" />
                                ) : (
                                  <Sparkles className="h-3.5 w-3.5" />
                                )}
                                {isElevarActive || isVelozActive
                                  ? 'Activo'
                                  : isElevarBlocked
                                    ? 'Bloqueado'
                                    : effectSub === 'debuff'
                                      ? 'Aplicar'
                                      : 'Activar'}
                              </button>
                            )}

                          {spell.statuses &&
                            spell.statuses.length > 0 &&
                            spell.effectType !== 'damage' && (
                              <button
                                type="button"
                                disabled={lacksMana || blockedByTurn}
                                onClick={() => onApplyStatusSpell(spell)}
                                title={blockedByTurn ? 'Sin acciones restantes este turno' : undefined}
                                className="min-h-[34px] inline-flex items-center gap-1.5 rounded-lg bg-[#b85a3a] px-3 text-xs font-semibold text-white hover:bg-[#cc6644] disabled:opacity-40 disabled:cursor-not-allowed whitespace-nowrap shrink-0 transition-colors"
                              >
                                <Dices className="h-3.5 w-3.5" />
                                Aplicar
                              </button>
                            )}
                        </>
                      )}
                    </div>
                  </div>
                </li>
              );
            })}
          </ul>
        </div>
      )}
      {inspectedSpell && (
        <SpellInspector
          key={inspectedSpell.spell.id}
          spell={inspectedSpell.spell}
          spells={spells}
          activeCharacter={activeCharacter}
          formula={formula}
          contextLabel="Casteo rápido · acciones sujetas al estado y reglas actuales"
          dependencyStatus={inspectedSpell.dependencyStatus}
          actions={inspectedSpell.actions}
          onTestSpell={onTestSpell}
          onClose={() => setInspectedSpell(null)}
        />
      )}
    </section>
  );
}
</file>

<file path="src/components/SpellBookList.tsx">
import { useMemo, useRef, useState } from 'react';
import {
  ArrowDown,
  ArrowUp,
  ArrowUpDown,
  Award,
  CheckSquare,
  ChevronDown,
  Copy,
  Download,
  Edit3,
  Eye,
  Flame,
  GripVertical,
  LayoutGrid,
  LayoutList,
  Link2,
  MoreHorizontal,
  Plus,
  RotateCcw,
  Search,
  Share2,
  Star,
  Tag,
  Square,
  Timer,
  Trash2,
  Upload,
  X,
} from 'lucide-react';
import type { Character, FormulaConfig, Spell, SpellEffectType } from '../types/rpg';
import {
  STAT_NAMES,
  characterHasNatureCanalizado,
  formatCollateralValue,
  formatSpellDependencyLine,
  formatTurnDuration,
  getCharacterStatDice,
  getEffectiveDefenseManaCost,
  getEffectiveEffectSubType,
  getEffectiveSpellDamageDice,
  getEffectiveSpellDamageKind,
  getSpellCastRequirement,
  getSpellCategory,
  getSpellMasteryStatus,
  isFireDamageSpell,
  isSonicSpell,
  isSpellMagical,
  parseDurationTurns,
  spellSupportsMastery,
  type SpellCategory,
} from '../utils/dice';
import { SpellCategoryIcon } from './SpellCategoryIcon';
import { SpellInspector } from './SpellInspector';

interface SpellBookListProps {
  spells: Spell[];
  activeCharacter: Character | undefined;
  characters: Character[];
  formula: FormulaConfig;
  spellOrder: string[];
  editorOpen?: boolean;
  onReorderSpells: (newOrder: string[]) => void;
  onResetSpellOrder: () => void;
  onNewSpell?: () => void;
  onEditSpell: (spell: Spell) => void;
  onDuplicateSpell: (spell: Spell) => void;
  onDeleteSpell: (spellId: string) => void;
  onToggleKnown: (spellId: string) => void;
  onUpdateCharacter: (updated: Character) => void;
  onAdjustSpellMastery: (spellId: string, delta: number) => void;
  onResetSpellMastery?: (spellId: string) => void;
  lastMasteryReset?: {
    spellId: string;
    spellName: string;
    previousSuccesses: number;
    previousLevel: number;
  } | null;
  onRevertSpellMastery?: () => void;
  onDismissMasteryReset?: () => void;
  customExportCount?: number;
  onExportCustomSpells?: () => { ok: boolean; count: number; message: string };
  onExportSelectedSpells?: (spellIds: string[]) => { ok: boolean; count: number; message: string };
  onImportCustomSpells?: (jsonText: string) => { ok: boolean; message: string };
  onRestoreBasics: () => void;
  onOpenCharacterBuilder?: () => void;
  onTestSpell?: (spell: Spell) => void;
}

type SpellFilterValue = 'all' | SpellCategory;
type SpellOriginFilter = 'all' | 'base' | 'custom';
type ManaFilterValue = 'all' | 'low' | 'mid' | 'high';
type NatureFilterValue = 'all' | 'magico' | 'fisico';
type ViewDensity = 'detailed' | 'compact';

const FILTER_OPTIONS: Array<{ value: SpellFilterValue; label: string }> = [
  { value: 'all', label: 'Todos' },
  { value: 'damage', label: 'Ataque' },
  { value: 'defense', label: 'Defensa' },
  { value: 'heal', label: 'Curación' },
  { value: 'buff', label: 'Buffs' },
  { value: 'debuff', label: 'Debuffs' },
  { value: 'effect', label: 'Efectos' },
];

const CATEGORY_META: Record<
  SpellCategory,
  { label: string; shortLabel: string; bg: string; border: string; accent: string; text: string }
> = {
  damage: {
    label: 'Ataque',
    shortLabel: 'Ataque',
    bg: 'var(--arc-cat-damage-bg)',
    border: 'var(--arc-cat-damage-border)',
    accent: 'var(--arc-cat-damage-accent)',
    text: 'var(--arc-cat-damage-text)',
  },
  defense: {
    label: 'Defensa',
    shortLabel: 'Defensa',
    bg: 'var(--arc-cat-defense-bg)',
    border: 'var(--arc-cat-defense-border)',
    accent: 'var(--arc-cat-defense-accent)',
    text: 'var(--arc-cat-defense-text)',
  },
  heal: {
    label: 'Curación',
    shortLabel: 'Curación',
    bg: 'var(--arc-cat-heal-bg)',
    border: 'var(--arc-cat-heal-border)',
    accent: 'var(--arc-cat-heal-accent)',
    text: 'var(--arc-cat-heal-text)',
  },
  buff: {
    label: 'Buff',
    shortLabel: 'Buff',
    bg: 'var(--arc-cat-buff-bg)',
    border: 'var(--arc-cat-buff-border)',
    accent: 'var(--arc-cat-buff-accent)',
    text: 'var(--arc-cat-buff-text)',
  },
  debuff: {
    label: 'Debuff',
    shortLabel: 'Debuff',
    bg: 'var(--arc-cat-debuff-bg)',
    border: 'var(--arc-cat-debuff-border)',
    accent: 'var(--arc-cat-debuff-accent)',
    text: 'var(--arc-cat-debuff-text)',
  },
  effect: {
    label: 'Efecto',
    shortLabel: 'Efecto',
    bg: 'var(--arc-cat-effect-bg)',
    border: 'var(--arc-cat-effect-border)',
    accent: 'var(--arc-cat-effect-accent)',
    text: 'var(--arc-cat-effect-text)',
  },
};

const CATEGORY_ORDER: SpellCategory[] = [
  'damage',
  'defense',
  'heal',
  'buff',
  'debuff',
  'effect',
];

const TYPE_LABELS: Record<SpellEffectType, string> = {
  damage: 'Ataque / Daño',
  defense: 'Defensa',
  heal: 'Curación',
  effect: 'Efecto',
};

export function SpellBookList({
  spells,
  activeCharacter,
  characters,
  formula,
  spellOrder,
  editorOpen = false,
  onReorderSpells,
  onResetSpellOrder,
  onNewSpell,
  onEditSpell,
  onDuplicateSpell,
  onDeleteSpell,
  onToggleKnown,
  onUpdateCharacter,
  onAdjustSpellMastery,
  onResetSpellMastery,
  lastMasteryReset,
  onRevertSpellMastery,
  onDismissMasteryReset,
  customExportCount = 0,
  onExportCustomSpells,
  onExportSelectedSpells,
  onImportCustomSpells,
  onRestoreBasics,
  onOpenCharacterBuilder,
  onTestSpell,
}: SpellBookListProps) {
  const importFileRef = useRef<HTMLInputElement>(null);
  const [searchQuery, setSearchQuery] = useState('');
  const [originFilter, setOriginFilter] = useState<SpellOriginFilter>('all');
  const [filter, setFilter] = useState<SpellFilterValue>('all');
  const [manaFilter, setManaFilter] = useState<ManaFilterValue>('all');
  const [natureFilter, setNatureFilter] = useState<NatureFilterValue>('all');
  const [viewDensity, setViewDensity] = useState<ViewDensity>('detailed');
  const [scope, setScope] = useState<'known' | 'library'>('known');
  const [showOtherOwners, setShowOtherOwners] = useState(false);
  const [reorderMode, setReorderMode] = useState(false);
  const [selectExportMode, setSelectExportMode] = useState(false);
  const [selectedSpellIds, setSelectedSpellIds] = useState<string[]>([]);
  const [draggedSpellId, setDraggedSpellId] = useState<string | null>(null);
  const [dragOverSpellId, setDragOverSpellId] = useState<string | null>(null);
  const [confirmResetSpellId, setConfirmResetSpellId] = useState<string | null>(null);
  const [expandedCompactSpellIds, setExpandedCompactSpellIds] = useState<Set<string>>(new Set());
  const [openCompactMenuSpellId, setOpenCompactMenuSpellId] = useState<string | null>(null);
  const [favoritesOnly, setFavoritesOnly] = useState(false);
  const [selectedPersonalTag, setSelectedPersonalTag] = useState('');
  const [tagEditorSpellId, setTagEditorSpellId] = useState<string | null>(null);
  const [newPersonalTag, setNewPersonalTag] = useState('');
  const [renamingPersonalTag, setRenamingPersonalTag] = useState<string | null>(null);
  const [renamedPersonalTag, setRenamedPersonalTag] = useState('');
  const [transferNotice, setTransferNotice] = useState<{ ok: boolean; message: string } | null>(
    null
  );
  const [inspectedSpell, setInspectedSpell] = useState<Spell | null>(null);

  const selectedSpellSet = useMemo(() => new Set(selectedSpellIds), [selectedSpellIds]);

  const toggleSelectSpell = (spellId: string) => {
    setSelectedSpellIds((prev) =>
      prev.includes(spellId) ? prev.filter((id) => id !== spellId) : [...prev, spellId]
    );
  };

  const knownIds = useMemo(
    () => new Set(activeCharacter?.knownSpells || []),
    [activeCharacter?.knownSpells]
  );

  const hasNatureCanalizado = useMemo(
    () => characterHasNatureCanalizado(activeCharacter, spells),
    [activeCharacter, spells]
  );

  const libraryForActive = useMemo(
    () =>
      spells.filter((s) => {
        if (s.isAdaptableTemplate) return false;
        if (
          !showOtherOwners &&
          s.id === 'basic_ataque_canalizado' &&
          hasNatureCanalizado &&
          !knownIds.has(s.id)
        ) {
          return false;
        }
        return (
          showOtherOwners ||
          s.isBasic ||
          !s.ownerCharacterId ||
          s.ownerCharacterId === activeCharacter?.id
        );
      }),
    [spells, showOtherOwners, activeCharacter?.id, hasNatureCanalizado, knownIds]
  );

  const orderIndexMap = useMemo(
    () => new Map(spellOrder.map((id, idx) => [id, idx])),
    [spellOrder]
  );
  const hasCustomOrder = spellOrder.length > 0;
  const favoriteIds = useMemo(
    () => new Set(activeCharacter?.favoriteSpellIds || []),
    [activeCharacter?.favoriteSpellIds]
  );
  const personalTagNames = activeCharacter?.personalSpellTagNames || [];
  const sortMode = activeCharacter?.spellSortMode || 'custom';

  const updateActiveCharacter = (update: (character: Character) => Character) => {
    if (activeCharacter) onUpdateCharacter(update(activeCharacter));
  };

  const scopeSpells = useMemo(() => {
    const compareDefault = (a: Spell, b: Spell) => {
      if (a.isBasic && !b.isBasic) return -1;
      if (!a.isBasic && b.isBasic) return 1;
      return a.name.localeCompare(b.name);
    };

    const compareWithCustom = (a: Spell, b: Spell) => {
      const idxA = orderIndexMap.get(a.id);
      const idxB = orderIndexMap.get(b.id);
      if (idxA !== undefined && idxB !== undefined) return idxA - idxB;
      if (idxA !== undefined) return -1;
      if (idxB !== undefined) return 1;
      return compareDefault(a, b);
    };

    const result = spells
      .filter((s) => {
        if (scope === 'known') return knownIds.has(s.id);
        if (
          !showOtherOwners &&
          s.id === 'basic_ataque_canalizado' &&
          hasNatureCanalizado &&
          !knownIds.has(s.id)
        ) {
          return false;
        }
        return (
          showOtherOwners ||
          s.isBasic ||
          !s.ownerCharacterId ||
          s.ownerCharacterId === activeCharacter?.id
        );
      });

    return result.sort((a, b) => {
      if (sortMode === 'custom') return compareWithCustom(a, b);
      if (sortMode === 'favorites') {
        const favoriteDiff = Number(favoriteIds.has(b.id)) - Number(favoriteIds.has(a.id));
        return favoriteDiff || a.name.localeCompare(b.name);
      }
      if (sortMode === 'category') {
        const categoryDiff = CATEGORY_ORDER.indexOf(getSpellCategory(a)) - CATEGORY_ORDER.indexOf(getSpellCategory(b));
        return categoryDiff || a.name.localeCompare(b.name);
      }
      if (sortMode === 'mana') {
        const manaDiff =
          getEffectiveDefenseManaCost(activeCharacter, a).cost -
          getEffectiveDefenseManaCost(activeCharacter, b).cost;
        return manaDiff || a.name.localeCompare(b.name);
      }
      if (sortMode === 'nature') {
        const natureA = a.effectType === 'damage' ? getEffectiveSpellDamageKind(a) : isSpellMagical(a) ? 'magico' : 'fisico';
        const natureB = b.effectType === 'damage' ? getEffectiveSpellDamageKind(b) : isSpellMagical(b) ? 'magico' : 'fisico';
        return natureA.localeCompare(natureB) || a.name.localeCompare(b.name);
      }
      return a.name.localeCompare(b.name);
    });
  }, [spells, scope, knownIds, showOtherOwners, activeCharacter, hasNatureCanalizado, orderIndexMap, sortMode, favoriteIds]);

  // Resumen del grimorio aprendido (siempre refleja el estado del personaje activo)
  const grimorioSummary = useMemo(() => {
    const knownList = spells.filter((s) => knownIds.has(s.id));
    const counts: Record<SpellCategory, number> = {
      damage: 0,
      defense: 0,
      heal: 0,
      buff: 0,
      debuff: 0,
      effect: 0,
    };
    let customKnown = 0;
    let masteryActive = 0;
    let masteryNearLevelUp = 0;

    for (const sp of knownList) {
      counts[getSpellCategory(sp)] += 1;
      if (!sp.isBasic) customKnown += 1;
      if (activeCharacter && spellSupportsMastery(sp)) {
        const raw = activeCharacter.spellMastery?.[sp.id] || 0;
        if (raw > 0) {
          masteryActive += 1;
          const st = getSpellMasteryStatus(raw, formula);
          if (!st.isMaxLevel && st.progressPct >= 70) {
            masteryNearLevelUp += 1;
          }
        }
      }
    }

    return {
      totalKnown: knownList.length,
      customKnown,
      masteryActive,
      masteryNearLevelUp,
      counts,
    };
  }, [spells, knownIds, activeCharacter, formula]);

  const baseCount = scopeSpells.filter((s) => s.isBasic).length;
  const customCount = scopeSpells.length - baseCount;

  const normalizedQuery = searchQuery.trim().toLowerCase();

  const visibleSpells = useMemo(() => {
    return scopeSpells.filter((s) => {
      if (originFilter === 'base' && !s.isBasic) return false;
      if (originFilter === 'custom' && s.isBasic) return false;

      if (filter !== 'all' && getSpellCategory(s) !== filter) return false;

      const effectiveCost = getEffectiveDefenseManaCost(activeCharacter, s).cost;
      if (manaFilter === 'low' && effectiveCost > 1) return false;
      if (manaFilter === 'mid' && effectiveCost !== 2) return false;
      if (manaFilter === 'high' && effectiveCost < 3) return false;

      if (natureFilter !== 'all') {
        const magical =
          s.effectType === 'damage'
            ? getEffectiveSpellDamageKind(s) === 'magico'
            : isSpellMagical(s);
        if (natureFilter === 'magico' && !magical) return false;
        if (natureFilter === 'fisico' && magical) return false;
      }

      if (favoritesOnly && !favoriteIds.has(s.id)) return false;
      if (
        selectedPersonalTag &&
        !(activeCharacter?.personalSpellTags?.[s.id] || []).includes(selectedPersonalTag)
      ) {
        return false;
      }

      if (normalizedQuery) {
        const haystack = [
          s.name,
          s.effectDescription,
          s.damage?.notes || '',
          ...(s.orders || []),
          ...(s.statuses || []),
          s.armorConfig?.element || '',
          s.dependency?.enabled ? s.dependency.requiredName : '',
        ]
          .join(' ')
          .toLowerCase();
        if (!haystack.includes(normalizedQuery)) return false;
      }

      return true;
    });
  }, [
    scopeSpells,
    originFilter,
    filter,
    manaFilter,
    natureFilter,
    normalizedQuery,
    activeCharacter,
    favoritesOnly,
    favoriteIds,
    selectedPersonalTag,
  ]);

  const hasActiveFilters =
    normalizedQuery.length > 0 ||
    originFilter !== 'all' ||
    filter !== 'all' ||
    manaFilter !== 'all' ||
    natureFilter !== 'all' ||
    favoritesOnly ||
    selectedPersonalTag !== '';

  const clearAllFilters = () => {
    setSearchQuery('');
    setOriginFilter('all');
    setFilter('all');
    setManaFilter('all');
    setNatureFilter('all');
    setFavoritesOnly(false);
    setSelectedPersonalTag('');
  };

  const toggleFavorite = (spellId: string) => {
    updateActiveCharacter((character) => {
      const current = character.favoriteSpellIds || [];
      return {
        ...character,
        favoriteSpellIds: current.includes(spellId)
          ? current.filter((id) => id !== spellId)
          : [...current, spellId],
      };
    });
  };

  const toggleSpellTag = (spellId: string, tag: string) => {
    updateActiveCharacter((character) => {
      const current = character.personalSpellTags || {};
      const spellTags = current[spellId] || [];
      const nextTags = spellTags.includes(tag)
        ? spellTags.filter((item) => item !== tag)
        : [...spellTags, tag];
      return {
        ...character,
        personalSpellTags: { ...current, [spellId]: nextTags },
      };
    });
  };

  const createPersonalTag = () => {
    const tag = newPersonalTag.trim();
    if (!tag || personalTagNames.some((name) => name.toLocaleLowerCase() === tag.toLocaleLowerCase())) return;
    updateActiveCharacter((character) => ({
      ...character,
      personalSpellTagNames: [...(character.personalSpellTagNames || []), tag],
    }));
    setNewPersonalTag('');
  };

  const renamePersonalTag = (previousName: string) => {
    const nextName = renamedPersonalTag.trim();
    if (!nextName || personalTagNames.some((name) => name !== previousName && name.toLocaleLowerCase() === nextName.toLocaleLowerCase())) return;
    updateActiveCharacter((character) => ({
      ...character,
      personalSpellTagNames: (character.personalSpellTagNames || []).map((name) =>
        name === previousName ? nextName : name
      ),
      personalSpellTags: Object.fromEntries(
        Object.entries(character.personalSpellTags || {}).map(([spellId, tags]) => [
          spellId,
          tags.map((tag) => (tag === previousName ? nextName : tag)),
        ])
      ),
    }));
    if (selectedPersonalTag === previousName) setSelectedPersonalTag(nextName);
    setRenamingPersonalTag(null);
    setRenamedPersonalTag('');
  };

  const deletePersonalTag = (tagToDelete: string) => {
    updateActiveCharacter((character) => ({
      ...character,
      personalSpellTagNames: (character.personalSpellTagNames || []).filter(
        (tag) => tag !== tagToDelete
      ),
      personalSpellTags: Object.fromEntries(
        Object.entries(character.personalSpellTags || {}).map(([spellId, tags]) => [
          spellId,
          tags.filter((tag) => tag !== tagToDelete),
        ])
      ),
    }));
    if (selectedPersonalTag === tagToDelete) setSelectedPersonalTag('');
  };

  const renderSpellOrganizationControls = (spell: Spell) => {
    const assignedTags = activeCharacter?.personalSpellTags?.[spell.id] || [];
    const isFavorite = favoriteIds.has(spell.id);
    const editorOpenForSpell = tagEditorSpellId === spell.id;

    return (
      <div className="flex flex-wrap items-center gap-0.5">
        {assignedTags.map((tag) => (
          <span key={tag} className="rounded-full border border-[var(--arc-border)] bg-[var(--arc-surface)] px-1.5 py-0.5 text-[10px] text-[var(--arc-muted)]">
            {tag}
          </span>
        ))}
        <div className="relative flex shrink-0 items-center gap-0.5">
        <button
          type="button"
          onClick={(event) => {
            event.stopPropagation();
            toggleFavorite(spell.id);
          }}
          aria-label={isFavorite ? `Quitar ${spell.name} de favoritos` : `Marcar ${spell.name} como favorito`}
          aria-pressed={isFavorite}
          title={isFavorite ? 'Quitar de favoritos' : 'Marcar como favorito'}
          className={`inline-flex min-h-[28px] w-7 items-center justify-center rounded-md ${
            isFavorite
              ? 'text-[var(--arc-accent)]'
              : 'text-[var(--arc-muted)] hover:bg-[var(--arc-raised)] hover:text-[var(--arc-text)]'
          }`}
        >
          <Star className={`h-4 w-4 ${isFavorite ? 'fill-current' : ''}`} />
        </button>
        <button
          type="button"
          onClick={(event) => {
            event.stopPropagation();
            setTagEditorSpellId(editorOpenForSpell ? null : spell.id);
          }}
          aria-label={`Organizar etiquetas de ${spell.name}`}
          aria-expanded={editorOpenForSpell}
          className={`inline-flex min-h-[28px] items-center justify-center gap-1 rounded-md px-1.5 text-xs ${
            assignedTags.length > 0
              ? 'text-[var(--arc-accent)]'
              : 'text-[var(--arc-muted)] hover:bg-[var(--arc-raised)] hover:text-[var(--arc-text)]'
          }`}
        >
          <Tag className="h-3.5 w-3.5" />
          {assignedTags.length > 0 && <span>{assignedTags.length}</span>}
        </button>
        {editorOpenForSpell && (
          <div
            onClick={(event) => event.stopPropagation()}
            className="absolute right-0 top-8 z-30 min-w-40 rounded-lg border border-[var(--arc-border)] bg-[var(--arc-raised)] p-2 shadow-xl"
          >
            {personalTagNames.length === 0 ? (
              <p className="max-w-40 text-xs text-[var(--arc-muted)]">
                Creá etiquetas en la barra de organización.
              </p>
            ) : (
              <div className="max-h-40 space-y-1 overflow-y-auto">
                {personalTagNames.map((tag) => (
                  <label key={tag} className="flex cursor-pointer items-center gap-2 rounded px-1 py-1 text-xs text-[var(--arc-text)] hover:bg-[var(--arc-input)]">
                    <input
                      type="checkbox"
                      checked={assignedTags.includes(tag)}
                      onChange={() => toggleSpellTag(spell.id, tag)}
                      className="h-3.5 w-3.5 accent-[var(--arc-accent)]"
                    />
                    <span className="max-w-40 truncate">{tag}</span>
                  </label>
                ))}
              </div>
            )}
          </div>
        )}
        </div>
      </div>
    );
  };

  const commitVisibleOrder = (nextVisibleIds: string[]) => {
    const visibleSet = new Set(nextVisibleIds);
    const baseScopeIds = scopeSpells.map((s) => s.id);
    let pointer = 0;
    const mergedScopeIds = baseScopeIds.map((id) =>
      visibleSet.has(id) ? nextVisibleIds[pointer++] : id
    );
    const scopeSet = new Set(mergedScopeIds);
    const remainingIds = [
      ...spellOrder.filter((id) => !scopeSet.has(id)),
      ...spells.map((s) => s.id).filter((id) => !scopeSet.has(id) && !spellOrder.includes(id)),
    ];
    onReorderSpells([...mergedScopeIds, ...remainingIds]);
  };

  const handleMoveSpellStep = (spellId: string, direction: -1 | 1) => {
    const ids = visibleSpells.map((s) => s.id);
    const currentIdx = ids.indexOf(spellId);
    const targetIdx = currentIdx + direction;
    if (currentIdx < 0 || targetIdx < 0 || targetIdx >= ids.length) return;
    const next = [...ids];
    const [moved] = next.splice(currentIdx, 1);
    next.splice(targetIdx, 0, moved);
    commitVisibleOrder(next);
  };

  const handleDropSpellInsideGrimorio = (targetSpellId: string) => {
    if (!draggedSpellId || draggedSpellId === targetSpellId) {
      setDraggedSpellId(null);
      setDragOverSpellId(null);
      return;
    }
    const ids = visibleSpells.map((s) => s.id);
    const fromIdx = ids.indexOf(draggedSpellId);
    const toIdx = ids.indexOf(targetSpellId);
    if (fromIdx < 0 || toIdx < 0) {
      setDraggedSpellId(null);
      setDragOverSpellId(null);
      return;
    }
    const next = [...ids];
    const [moved] = next.splice(fromIdx, 1);
    next.splice(toIdx, 0, moved);
    commitVisibleOrder(next);
    setDraggedSpellId(null);
    setDragOverSpellId(null);
  };

  const gridClass =
    viewDensity === 'compact'
      ? 'grid gap-2.5 grid-cols-[repeat(auto-fit,minmax(min(100%,280px),1fr))]'
      : editorOpen
        ? 'grid gap-3.5 grid-cols-1'
        : 'grid gap-3.5 md:grid-cols-2';

  return (
    <section className="rounded-xl border border-[var(--arc-border)] bg-[var(--arc-surface)] p-4 sm:p-5 space-y-4">
      {/* Cabecera del Grimorio */}
      <div className="flex flex-wrap items-center justify-between gap-3 border-b border-[var(--arc-border)] pb-3.5">
        <div>
          <h2 className="font-display text-lg sm:text-xl font-bold text-[var(--arc-accent)]">
            Grimorio de {activeCharacter?.name || 'Personaje'}
          </h2>
          <p className="text-[13px] text-[var(--arc-muted)] mt-0.5">
            {scope === 'known'
              ? `Mostrando ${visibleSpells.length} de ${knownIds.size} hechizo(s) aprendido(s)`
              : `Biblioteca (${visibleSpells.length} de ${libraryForActive.length} disponibles)`}
          </p>
        </div>

        <div className="flex flex-wrap items-center gap-1.5">
          <div className="flex p-0.5 rounded-lg bg-[var(--arc-input)]">
            <button
              type="button"
              onClick={() => setScope('known')}
              className={`px-3 py-1.5 text-xs font-semibold rounded-md whitespace-nowrap shrink-0 transition-colors ${
                scope === 'known'
                  ? 'bg-[var(--arc-raised)] text-[var(--arc-text)]'
                  : 'text-[var(--arc-muted)] hover:text-[var(--arc-text)]'
              }`}
            >
              Aprendidos <span className="font-mono-num">({knownIds.size})</span>
            </button>
            <button
              type="button"
              onClick={() => setScope('library')}
              className={`px-3 py-1.5 text-xs font-semibold rounded-md whitespace-nowrap shrink-0 transition-colors ${
                scope === 'library'
                  ? 'bg-[var(--arc-raised)] text-[var(--arc-text)]'
                  : 'text-[var(--arc-muted)] hover:text-[var(--arc-text)]'
              }`}
            >
              Biblioteca <span className="font-mono-num">({libraryForActive.length})</span>
            </button>
          </div>

          <div
            className="flex p-0.5 rounded-lg bg-[var(--arc-input)]"
            role="group"
            aria-label="Densidad de tarjetas"
          >
            <button
              type="button"
              onClick={() => setViewDensity('detailed')}
              title="Vista detallada con toda la ficha y maestría"
              className={`min-h-[32px] inline-flex items-center gap-1 px-2.5 py-1 text-xs font-semibold rounded-md whitespace-nowrap shrink-0 transition-colors ${
                viewDensity === 'detailed'
                  ? 'bg-[var(--arc-raised)] text-[var(--arc-accent)]'
                  : 'text-[var(--arc-muted)] hover:text-[var(--arc-text)]'
              }`}
            >
              <LayoutGrid className="h-3.5 w-3.5" />
              Detallado
            </button>
            <button
              type="button"
              onClick={() => setViewDensity('compact')}
              title="Vista compacta para explorar muchos hechizos"
              className={`min-h-[32px] inline-flex items-center gap-1 px-2.5 py-1 text-xs font-semibold rounded-md whitespace-nowrap shrink-0 transition-colors ${
                viewDensity === 'compact'
                  ? 'bg-[var(--arc-raised)] text-[var(--arc-accent)]'
                  : 'text-[var(--arc-muted)] hover:text-[var(--arc-text)]'
              }`}
            >
              <LayoutList className="h-3.5 w-3.5" />
              Compacto
            </button>
          </div>

          <button
            type="button"
            onClick={() => {
              const next = !reorderMode;
              setReorderMode(next);
              if (next) {
                setSelectExportMode(false);
                updateActiveCharacter((character) => ({
                  ...character,
                  spellSortMode: 'custom',
                }));
              }
            }}
            className={`min-h-[36px] inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1.5 text-xs font-semibold whitespace-nowrap shrink-0 transition-colors ${
              reorderMode
                ? 'bg-[var(--arc-action)] text-[var(--arc-action-text)]'
                : 'bg-transparent text-[var(--arc-muted)] hover:bg-[var(--arc-raised)] hover:text-[var(--arc-text)]'
            }`}
          >
            <ArrowUpDown className="h-3.5 w-3.5" />
            {reorderMode ? 'Listo' : 'Ordenar'}
          </button>

          {hasCustomOrder && (
            <button
              type="button"
              onClick={onResetSpellOrder}
              title="Volver al orden alfabético base"
              className="min-h-[36px] inline-flex items-center gap-1 rounded-lg bg-transparent px-2 py-1.5 text-xs font-medium text-[var(--arc-muted)] hover:bg-[var(--arc-raised)] hover:text-[var(--arc-text)] whitespace-nowrap shrink-0 transition-colors"
            >
              A-Z
            </button>
          )}

          {onExportCustomSpells && (
            <button
              type="button"
              disabled={customExportCount === 0}
              onClick={() => {
                const res = onExportCustomSpells();
                setTransferNotice({ ok: res.ok, message: res.message });
              }}
              title={
                customExportCount === 0
                  ? 'Creá al menos un hechizo propio para compartir'
                  : `Descargar ${customExportCount} hechizo(s) propio(s) en JSON`
              }
              className="min-h-[36px] inline-flex items-center gap-1.5 rounded-lg bg-[var(--arc-raised)] px-3 py-1.5 text-xs font-semibold text-[var(--arc-accent)] hover:brightness-110 disabled:opacity-45 disabled:cursor-not-allowed whitespace-nowrap shrink-0 transition-all"
            >
              <Download className="h-3.5 w-3.5" />
              Compartir propios <span className="font-mono-num">({customExportCount})</span>
            </button>
          )}

          {onExportSelectedSpells && (
            <button
              type="button"
              onClick={() => {
                setSelectExportMode((v) => {
                  const next = !v;
                  if (next) {
                    setReorderMode(false);
                  } else {
                    setSelectedSpellIds([]);
                  }
                  return next;
                });
              }}
              title="Elegir manualmente qué hechizos exportar en JSON"
              className={`min-h-[36px] inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-xs font-semibold whitespace-nowrap shrink-0 transition-colors ${
                selectExportMode
                  ? 'bg-[var(--arc-action)] text-[var(--arc-action-text)]'
                  : 'bg-transparent text-[var(--arc-muted)] hover:bg-[var(--arc-raised)] hover:text-[var(--arc-text)]'
              }`}
            >
              <Share2 className="h-3.5 w-3.5" />
              {selectExportMode ? 'Salir de selección' : 'Compartir seleccionados'}
            </button>
          )}

          {onImportCustomSpells && (
            <>
              <button
                type="button"
                onClick={() => importFileRef.current?.click()}
                title="Importar archivo JSON de hechizos propios"
                className="min-h-[36px] inline-flex items-center gap-1.5 rounded-lg bg-transparent px-2.5 py-1.5 text-xs font-medium text-[var(--arc-muted)] hover:bg-[var(--arc-raised)] hover:text-[var(--arc-text)] whitespace-nowrap shrink-0 transition-colors"
              >
                <Upload className="h-3.5 w-3.5" />
                Importar
              </button>
              <input
                ref={importFileRef}
                type="file"
                accept=".json,application/json"
                hidden
                onChange={(e) => {
                  const file = e.target.files?.[0];
                  if (!file) return;
                  const reader = new FileReader();
                  reader.onload = () => {
                    const res = onImportCustomSpells(String(reader.result || ''));
                    setTransferNotice(res);
                  };
                  reader.readAsText(file);
                  e.target.value = '';
                }}
              />
            </>
          )}

          <button
            type="button"
            onClick={onRestoreBasics}
            className="min-h-[36px] inline-flex items-center gap-1.5 rounded-lg bg-transparent px-2.5 py-1.5 text-xs font-medium text-[var(--arc-muted)] hover:bg-[var(--arc-raised)] hover:text-[var(--arc-text)] whitespace-nowrap shrink-0 transition-colors"
          >
            <RotateCcw className="h-3.5 w-3.5" />
            Restaurar básicos
          </button>
        </div>
      </div>

      {/* Panel resumen del Grimorio */}
      {activeCharacter && (
        <div className="rounded-lg border border-[var(--arc-border)] bg-[var(--arc-surface-alt)] px-3.5 py-3 space-y-2.5">
          <div className="flex flex-wrap items-center justify-between gap-x-4 gap-y-1.5 text-xs">
            <div className="flex flex-wrap items-center gap-x-3 gap-y-1">
              <span className="text-[var(--arc-muted)]">
                Aprendidos:{' '}
                <strong className="font-mono-num text-[var(--arc-text)]">
                  {grimorioSummary.totalKnown}
                </strong>
              </span>
              <span className="text-[var(--arc-border-strong)]" aria-hidden="true">
                ·
              </span>
              <span className="text-[var(--arc-muted)]">
                Propios:{' '}
                <strong className="font-mono-num text-[var(--arc-accent)]">
                  {grimorioSummary.customKnown}
                </strong>
              </span>
              <span className="text-[var(--arc-border-strong)]" aria-hidden="true">
                ·
              </span>
              <span className="inline-flex items-center gap-1 text-[var(--arc-muted)]">
                <Award className="h-3.5 w-3.5 text-[var(--arc-accent)]" />
                Con maestría:{' '}
                <strong className="font-mono-num text-[var(--arc-text)]">
                  {grimorioSummary.masteryActive}
                </strong>
                {grimorioSummary.masteryNearLevelUp > 0 && (
                  <span className="text-[var(--arc-cat-buff-accent)] font-semibold">
                    ({grimorioSummary.masteryNearLevelUp} cerca de subir)
                  </span>
                )}
              </span>
            </div>

            {onNewSpell && !editorOpen && (
              <button
                type="button"
                onClick={onNewSpell}
                className="inline-flex items-center gap-1 text-xs font-semibold text-[var(--arc-accent)] hover:underline whitespace-nowrap shrink-0"
              >
                <Plus className="h-3.5 w-3.5" />
                Crear hechizo nuevo
              </button>
            )}
          </div>

          <div className="flex flex-wrap items-center gap-1.5">
            {CATEGORY_ORDER.map((cat) => {
              const meta = CATEGORY_META[cat];
