                    className="w-full min-h-[38px] rounded-md border border-[var(--arc-border)] bg-[var(--arc-input)] px-3 text-xs text-[var(--arc-text)]"
                  >
                    {combatants.map((cb) => {
                      const ch = charMap.get(cb.characterId);
