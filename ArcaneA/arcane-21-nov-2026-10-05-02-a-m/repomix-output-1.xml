                  <th className="py-2.5 px-3 text-right font-semibold">Hito (éxitos)</th>
                  <th className="py-2.5 px-3 text-right font-semibold">Dado de daño</th>
                  <th className="py-2.5 px-3 text-right font-semibold">Bono extra</th>
                </tr>
