  const [autoPassPaused, setAutoPassPaused] = useState<boolean>(false);
  const [autoPassSecondsLeft, setAutoPassSecondsLeft] = useState<number | null>(null);
  const [arenaLayout, setArenaLayout] = useState<ArenaLayoutConfig>(
