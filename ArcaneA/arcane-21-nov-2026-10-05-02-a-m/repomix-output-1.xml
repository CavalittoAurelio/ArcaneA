    const name = type==='damage'?'damage':type==='heal'?'heal':'effect';
    const label = type==='damage'?'Daño':type==='heal'?'Curación':'Efecto';
    return `${iconSvg(name)} ${label}`;
  }
  function generateId(){return 'sp_'+Date.now().toString(36)+Math.random().toString(36).slice(2,7)}
  function allOrders(){return [...new Set([...PRESET_ORDERS,...customOrders])].sort()}

  function getAttackStats(spell){
    if(Array.isArray(spell.attackStats)) return spell.attackStats;
    const result = [];
    if(spell.attackStat && spell.attackStat!=='none') result.push(spell.attackStat);
    if(spell.bonusAttackStat && spell.bonusAttackStat!=='none') result.push(spell.bonusAttackStat);
    return result;
  }

  function calcDice(level){
    const raw = formulaConfig.base + (level * formulaConfig.multiplier);
    return Math.max(0, Math.floor(raw));
  }
  function getDice(statKey){
    if(!statKey || statKey==='none') return 0;
    const lvl = character[statKey] || 1;
    const d = calcDice(lvl);
    return d < 1 ? 1 : d;
  }
  function statDiceLabel(statKey){
    if(!statKey || statKey==='none') return '—';
    return getDice(statKey)+'d6';
  }
  function formulaDescription(){
    const b = formulaConfig.base, m = formulaConfig.multiplier;
    if(b===0 && m===0) return '0 dados';
    if(b===0 && m===1) return 'nivel';
    if(b===1 && m===1) return '1 + nivel';
    if(m===0) return b+' fijo';
    if(m===1) return b+' + nivel';
    return b+' + '+m+'×nivel';
  }
  function updateFormulaDisplays(){
    $('formulaBadge').textContent = formulaDescription();
    $('formulaBaseDisplay').textContent = formulaConfig.base;
    $('formulaMultDisplay').textContent = formulaConfig.multiplier;
    $('formulaCurrent').textContent = formulaDescription();
  }
  function renderFormulaPreview(){
    const body = $('formulaPreviewBody');
    body.innerHTML = '';
    const currentLevels = {1:[],2:[],3:[],4:[],5:[]};
    ['fisico','manipulacion','influencia'].forEach(k=>{
      const lvl = character[k]||1;
      currentLevels[lvl].push(STAT_NAMES[k]);
    });
    [1,2,3,4,5].forEach(lvl=>{
      const pts = LEVEL_POINTS[lvl];
      let dice = calcDice(lvl);
      if(dice < 1) dice = 1;
      const isCurrent = currentLevels[lvl].length > 0;
      const row = document.createElement('tr');
      if(isCurrent) row.className = 'current';
      row.innerHTML = `
        <td>Nivel ${lvl}${isCurrent?` <span style="color:var(--text-muted);font-size:.72rem">(${currentLevels[lvl].join(', ')})</span>`:''}</td>
        <td>${pts} pts</td>
        <td>${dice}d6</td>
      `;
      body.appendChild(row);
    });
  }

  // ---------- PANEL COLLAPSE ----------
  function setupPanelCollapse(){
    const saved = JSON.parse(localStorage.getItem('arcane_panels') || '{}');
    document.querySelectorAll('.panel[data-pid]').forEach(panel=>{
      const pid = panel.dataset.pid;
      const h2 = panel.querySelector('h2');
      if(!h2) return;
      if(saved[pid]) panel.classList.add('collapsed');
      h2.addEventListener('click', e=>{
        if(e.target.closest('button:not(.panel-toggle)')) return;
        panel.classList.toggle('collapsed');
        const state = JSON.parse(localStorage.getItem('arcane_panels') || '{}');
        state[pid] = panel.classList.contains('collapsed');
        localStorage.setItem('arcane_panels', JSON.stringify(state));
      });
    });
  }

  // ---------- STORAGE ----------
  function loadStorage(){
    try{
      const s = localStorage.getItem('arcane_spells_v3');
      if(s) spells = JSON.parse(s);
      const o = localStorage.getItem('arcane_orders');
      if(o) customOrders = JSON.parse(o);
      const c = localStorage.getItem('arcane_character');
      if(c) character = JSON.parse(c);
      const f = localStorage.getItem('arcane_formula');
      if(f) formulaConfig = Object.assign({base:1,multiplier:1,notes:''}, JSON.parse(f));
    }catch(e){console.warn('storage error',e)}
  }
  function saveSpells(){localStorage.setItem('arcane_spells_v3',JSON.stringify(spells))}
  function saveOrders(){localStorage.setItem('arcane_orders',JSON.stringify(customOrders))}
  function saveCharacter(){localStorage.setItem('arcane_character',JSON.stringify(character))}
  function saveFormula(){localStorage.setItem('arcane_formula',JSON.stringify(formulaConfig))}

  function ensureBasicSpells(){
    let added=false;
    BASIC_SPELLS.forEach(basic=>{
      if(!spells.find(s=>s.id===basic.id)){
        spells.unshift(JSON.parse(JSON.stringify(basic)));
        added=true;
      }
    });
    if(added) saveSpells();
  }

  function renderProfile(){
    const grid = $('statGrid');
    grid.innerHTML = '';
    ['fisico','manipulacion','influencia'].forEach(key=>{
      const card = document.createElement('div');
      card.className = 'stat-card';
      const icons = {
        fisico:'<circle cx="12" cy="6" r="3"/><path d="M6 21 l3 -8 l3 3 l3 -3 l3 8"/>',
        manipulacion:'<path d="M12 3 L20 9 L20 15 L12 21 L4 15 L4 9 Z"/><path d="M12 3 L12 21"/>',
        influencia:'<circle cx="12" cy="8" r="3"/><path d="M5 21 v-1 a4 4 0 0 1 4 -4 h6 a4 4 0 0 1 4 4 v1"/>'
      };
      card.innerHTML = `
        <div class="stat-name">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${icons[key]}</svg>
          ${STAT_NAMES[key]}
        </div>
        <select data-stat="${key}" class="stat-level-select">
          ${[1,2,3,4,5].map(n=>`<option value="${n}" ${character[key]===n?'selected':''}>Nivel ${n}</option>`).join('')}
        </select>
        <div class="stat-info">
          <span class="stat-points">${LEVEL_POINTS[character[key]]} pts</span>
          <span class="stat-dice">${getDice(key)}d6</span>
        </div>
      `;
      grid.appendChild(card);
    });
    grid.querySelectorAll('.stat-level-select').forEach(sel=>{
      sel.addEventListener('change', e=>{
        const key = e.target.dataset.stat;
        character[key] = parseInt(e.target.value);
        saveCharacter();
        refreshAllDice();
      });
    });
  }

  function refreshAllDice(){
    renderProfile();
    renderFormulaPreview();
    renderAttackStatCheckboxes();
    updateCastStatBox();
    updateAttackStatBox();
    renderSpellList();
    updateFormulaDisplays();
  }

  function setupFormulaPanel(){
    $('formulaBase').value = formulaConfig.base;
    $('formulaMult').value = formulaConfig.multiplier;
    $('formulaNotes').value = formulaConfig.notes || '';
    $('formulaBase').addEventListener('change', e=>{
      formulaConfig.base = Math.max(0, parseInt(e.target.value)||0);
      e.target.value = formulaConfig.base;
      saveFormula(); refreshAllDice();
    });
    $('formulaMult').addEventListener('change', e=>{
      formulaConfig.multiplier = Math.max(0, parseInt(e.target.value)||0);
      e.target.value = formulaConfig.multiplier;
      saveFormula(); refreshAllDice();
    });
    $('formulaNotes').addEventListener('change', e=>{
      formulaConfig.notes = e.target.value;
      saveFormula();
    });
    document.querySelectorAll('.formula-preset').forEach(btn=>{
      btn.addEventListener('click', ()=>{
        formulaConfig.base = parseInt(btn.dataset.base)||0;
        formulaConfig.multiplier = parseInt(btn.dataset.mult)||0;
        $('formulaBase').value = formulaConfig.base;
        $('formulaMult').value = formulaConfig.multiplier;
        saveFormula(); refreshAllDice();
      });
    });
    updateFormulaDisplays();
  }

  function updateCastStatBox(){
    const box = $('castStatBox');
    const manual = $('manualCastSection');
    const hint = $('castHint');
    if(castStat==='manual'){
      box.style.display='none';
      manual.style.display='block';
      hint.textContent = 'Dados libres: no cambian con la fórmula.';
    } else if(castStat==='none'){
      box.style.display='none';
      manual.style.display='none';
      hint.textContent = 'Sin tirada de casteo.';
    } else {
      box.style.display='flex';
      manual.style.display='none';
      $('castStatValue').textContent = getDice(castStat)+'d6';
      $('castStatTag').textContent = STAT_NAMES[castStat]+' nv '+character[castStat];
      hint.textContent = `Usando ${STAT_NAMES[castStat]} (nivel ${character[castStat]}, ${LEVEL_POINTS[character[castStat]]} pts).`;
    }
  }
  $('castStatSelect').addEventListener('change', e=>{
    castStat = e.target.value;
    updateCastStatBox();
  });

  function renderAttackStatCheckboxes(){
    const container = $('attackStatCheckboxes');
    container.innerHTML = '';
    ['fisico','manipulacion','influencia'].forEach(key=>{
      const lbl = document.createElement('label');
      lbl.className = 'attack-stat-checkbox' + (attackStats.includes(key) ? ' checked' : '');
      lbl.innerHTML = `
        <input type="checkbox" data-stat="${key}" ${attackStats.includes(key)?'checked':''}>
        <span class="stat-label">${STAT_NAMES[key]}</span>
        <span class="stat-dice-inline">${getDice(key)}d6</span>
        <span class="stat-lvl-inline">nv ${character[key]}</span>
      `;
      const cb = lbl.querySelector('input');
      cb.addEventListener('change', e=>{
        if(e.target.checked){
          if(!attackStats.includes(key)) attackStats.push(key);
        } else {
          attackStats = attackStats.filter(k=>k!==key);
        }
        lbl.classList.toggle('checked', e.target.checked);
        updateAttackStatBox();
      });
      container.appendChild(lbl);
    });
  }

  function updateAttackStatBox(){
    const group = $('attackStatGroup');
    if(effectType!=='damage'){
      group.style.display='none';
      return;
    }
    group.style.display='block';
    if(attackStats.length===0){
      $('attackStatValue').textContent = '0d6';
      $('attackStatTag').textContent = 'Sin ataque';
      return;
    }
    const totalDice = attackStats.reduce((sum,k)=>sum+getDice(k),0);
    $('attackStatValue').textContent = totalDice+'d6';
    $('attackStatTag').textContent = attackStats.map(k=>STAT_NAMES[k]).join(' + ');
  }

  function updateCastPreview(){
    $('castCount').textContent = manualCastDice;
    $('castPreview').innerHTML =
      '<svg class="dice-preview-icon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">'+
      '<path d="M12 2 L22 8 L22 16 L12 22 L2 16 L2 8 Z" opacity=".9"/></svg>'+manualCastDice+'d6';
  }
  $('castMinus').addEventListener('click',()=>{if(manualCastDice>0){manualCastDice--;updateCastPreview()}});
  $('castPlus').addEventListener('click',()=>{if(manualCastDice<20){manualCastDice++;updateCastPreview()}});

  function updateAssuredPreview(){
    $('assuredCount').textContent = assuredSuccess;
    const label = assuredSuccess===1?'1 éxito':`${assuredSuccess} éxitos`;
    $('assuredPreview').innerHTML =
      '<svg class="dice-preview-icon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">'+
      '<path d="M12 2 L22 8 L22 16 L12 22 L2 16 L2 8 Z" opacity=".9"/></svg>'+label;
  }
  $('assuredMinus').addEventListener('click',()=>{if(assuredSuccess>0){assuredSuccess--;updateAssuredPreview()}});
  $('assuredPlus').addEventListener('click',()=>{if(assuredSuccess<20){assuredSuccess++;updateAssuredPreview()}});

  function setEffectType(t){
    effectType = t;
    $('tabDamage').classList.toggle('active', t==='damage');
    $('tabHeal').classList.toggle('active', t==='heal');
    $('tabEffect').classList.toggle('active', t==='effect');
    $('diceSection').style.display = (t==='damage'||t==='heal')?'block':'none';
    $('effectSection').style.display = t==='effect'?'block':'none';
    $('diceLabel').textContent = t==='heal'?'Dados de curación':'Dados de daño';
    $('bonusLabel').textContent = t==='heal'?'Bonificador de curación':'Bonificador fijo';
    $('notesLabel').textContent = t==='heal'?'Notas de curación':'Notas';
    $('addDamageDieBtn').textContent = t==='heal'?'+ Añadir dado de curación':'+ Añadir dado de daño';
    if(t==='heal' && damageDice.length===1 && damageDice[0].type==='d6' && damageDice[0].count===1){
      damageDice = [{type:'d4',count:1}];
      renderDamageDice();
    }
    updateAttackStatBox();
  }
  $('tabDamage').addEventListener('click',()=>setEffectType('damage'));
  $('tabHeal').addEventListener('click',()=>setEffectType('heal'));
  $('tabEffect').addEventListener('click',()=>setEffectType('effect'));
  $('addDamageDieBtn').addEventListener('click',()=>{
    damageDice.push({type: effectType==='heal'?'d4':'d6', count:1});
    renderDamageDice();
  });

  $('damageMode').addEventListener('change', e=>{
    damageMode = e.target.value;
  });

  function renderDamageDice(){
    const list = $('damageDiceList');
    list.innerHTML = '';
    damageDice.forEach((die,idx)=>{
      const row = document.createElement('div');
      row.className = 'damage-die-row';
      const sel = document.createElement('select');
      DIE_TYPES.forEach(t=>{
        const opt = document.createElement('option');
        opt.value = t; opt.textContent = t;
        if(t===die.type) opt.selected = true;
        sel.appendChild(opt);
      });
      sel.addEventListener('change',()=>{damageDice[idx].type = sel.value});
      const cnt = document.createElement('input');
      cnt.type='number'; cnt.min=1; cnt.value=die.count;
      cnt.addEventListener('change',()=>{
        damageDice[idx].count = Math.max(1, parseInt(cnt.value)||1);
        cnt.value = damageDice[idx].count;
      });
      const rm = document.createElement('button');
      rm.textContent='×'; rm.title='Quitar dado';
      rm.addEventListener('click',()=>{
        damageDice.splice(idx,1);
        if(damageDice.length===0) damageDice.push({type:'d6',count:1});
        renderDamageDice();
      });
      row.appendChild(sel); row.appendChild(cnt); row.appendChild(rm);
      list.appendChild(row);
    });
  }

  function renderOrderChips(){
    const container = $('orderChips');
    container.innerHTML = '';
    if(currentOrders.length===0){
      container.innerHTML = '<span class="empty" style="font-size:.8rem">Sin órdenes seleccionadas</span>';
      return;
    }
    currentOrders.forEach((order,idx)=>{
      const chip = document.createElement('span');
      chip.className='chip';
      chip.innerHTML = `${escapeHtml(order)} <button data-idx="${idx}" title="Quitar">×</button>`;
      chip.querySelector('button').addEventListener('click',()=>{
        currentOrders.splice(idx,1);
        renderOrderChips();
      });
      container.appendChild(chip);
    });
  }

  function renderOrderSelect(){
    const sel = $('orderSelect');
    const current = sel.value;
    sel.innerHTML = '';
    const ph = document.createElement('option');
    ph.value=''; ph.textContent='— Elegir orden existente —';
    sel.appendChild(ph);
    allOrders().forEach(o=>{
      const opt = document.createElement('option');
      opt.value=o; opt.textContent=o;
      sel.appendChild(opt);
    });
    if(current && allOrders().includes(current)) sel.value = current;
  }

  $('addOrderBtn').addEventListener('click',()=>{
    const sel = $('orderSelect');
    if(sel.value && !currentOrders.includes(sel.value)){
      currentOrders.push(sel.value);
      renderOrderChips();
      sel.value='';
    }
  });
  $('createOrderBtn').addEventListener('click',()=>{
    const input = $('newOrderInput');
    const val = input.value.trim();
    if(!val) return;
    if(!customOrders.includes(val) && !PRESET_ORDERS.includes(val)){
      customOrders.push(val); saveOrders();
    }
    if(!currentOrders.includes(val)) currentOrders.push(val);
    input.value='';
    renderOrderSelect();
    renderOrderChips();
  });

  function collectFormData(){
    return {
      id: editingId || generateId(),
      name: $('spellName').value.trim() || 'Hechizo sin nombre',
      manaCost: parseInt($('manaCost').value) || 0,
      orders: [...currentOrders],
      castStat: castStat,
      manualCastDice: manualCastDice,
      assuredSuccess: assuredSuccess,
      attackStats: [...attackStats],
      damageMode: damageMode,
      effectType: effectType,
      damage: {
        dice: damageDice.map(d=>({type:d.type,count:d.count})),
        bonus: parseInt($('damageBonus').value) || 0,
        notes: $('damageNotes').value.trim()
      },
      effectDescription: $('effectDescription').value.trim(),
      duration: $('duration').value.trim(),
      isBasic: false
    };
  }

  function fillForm(spell){
    editingId = spell.id;
    $('spellName').value = spell.name;
    $('manaCost').value = spell.manaCost;
    currentOrders = [...(spell.orders||[])];
    castStat = spell.castStat || 'manipulacion';
    manualCastDice = spell.manualCastDice || spell.castDice || 2;
    assuredSuccess = (typeof spell.assuredSuccess==='number') ? spell.assuredSuccess : (spell.assuredSuccess?1:0);
    attackStats = getAttackStats(spell);
    if(attackStats.length===0 && spell.effectType==='damage' && !spell.isBasic){
      attackStats = ['fisico'];
    }
    damageMode = spell.damageMode || 'auto';
    damageDice = (spell.damage && spell.damage.dice && spell.damage.dice.length)
      ? spell.damage.dice.map(d=>({...d}))
      : [{type:'d6',count:1}];
    $('damageBonus').value = (spell.damage && spell.damage.bonus) || 0;
    $('damageNotes').value = (spell.damage && spell.damage.notes) || '';
    $('damageMode').value = damageMode;
    $('effectDescription').value = spell.effectDescription || '';
    $('duration').value = spell.duration || '';
    $('castStatSelect').value = castStat;
    setEffectType(spell.effectType || 'damage');
    $('editorTitle').textContent = 'Editar hechizo';
    setIconText($('saveSpellBtn'), 'save', 'Actualizar hechizo');
    renderOrderChips();
    renderDamageDice();
    renderAttackStatCheckboxes();
    updateCastPreview();
    updateAssuredPreview();
    updateCastStatBox();
    updateAttackStatBox();
    window.scrollTo({top:0,behavior:'smooth'});
  }

  function resetForm(){
    editingId = null;
    $('spellName').value = '';
    $('manaCost').value = 3;
    currentOrders = [];
    castStat = 'manipulacion';
    manualCastDice = 2;
    assuredSuccess = 0;
    attackStats = ['fisico'];
    damageMode = 'auto';
    damageDice = [{type:'d6',count:1}];
    $('damageBonus').value = 0;
    $('damageNotes').value = '';
    $('damageMode').value = 'auto';
    $('effectDescription').value = '';
    $('duration').value = '';
    $('castStatSelect').value = 'manipulacion';
    setEffectType('damage');
    $('editorTitle').textContent = 'Crear hechizo';
    setIconText($('saveSpellBtn'), 'save', 'Guardar hechizo');
    renderOrderChips();
    renderDamageDice();
    renderAttackStatCheckboxes();
    updateCastPreview();
    updateAssuredPreview();
    updateCastStatBox();
    updateAttackStatBox();
  }

  $('saveSpellBtn').addEventListener('click',()=>{
    const spell = collectFormData();
    const idx = spells.findIndex(s=>s.id===spell.id);
    if(idx>=0){
      spell.isBasic = spells[idx].isBasic || false;
      spells[idx] = spell;
    } else {
      spells.push(spell);
    }
    saveSpells();
    renderSpellList();
    resetForm();
  });
  $('clearFormBtn').addEventListener('click',()=>resetForm());
  $('restoreBasicsBtn').addEventListener('click',()=>{ensureBasicSpells();renderSpellList()});

  function renderSpellList(){
    const list = $('spellList');
    $('spellCount').textContent = spells.length;
    if(spells.length===0){
      list.innerHTML = '<p class="empty">Todavía no hay hechizos guardados.</p>';
      return;
    }
    list.innerHTML = '';
    const basics = spells.filter(s=>s.isBasic);
    const custom = spells.filter(s=>!s.isBasic);
    const ordered = [...basics, ...custom.reverse()];
    ordered.forEach(spell=>{
      const card = document.createElement('div');
      card.className = 'spell-card'+(spell.isBasic?' is-basic':'');

      const h3 = document.createElement('h3');
      h3.innerHTML = escapeHtml(spell.name);
      if(spell.isBasic){
        const b=document.createElement('span'); b.className='badge-basic'; b.textContent='Básico';
        h3.appendChild(b);
      }
      const assuredN = (typeof spell.assuredSuccess==='number') ? spell.assuredSuccess : (spell.assuredSuccess?1:0);
      if(assuredN>0){
        const b=document.createElement('span'); b.className='badge-assured';
        b.innerHTML=`${iconSvg('check')} ${assuredN} asegurado${assuredN!==1?'s':''}`;
        h3.appendChild(b);
      }
      if(spell.damageMode==='manual' && (spell.effectType==='damage'||spell.effectType==='heal')){
        const b=document.createElement('span'); b.className='badge-manual';
        b.innerHTML = `${iconSvg('manual')} Manual`;
        h3.appendChild(b);
      }
      card.appendChild(h3);

      const statsDiv = document.createElement('div');
      statsDiv.className = 'spell-stats';
      const cStat = spell.castStat || 'none';
      if(cStat!=='none'){
        const statKey = cStat==='manual' ? null : cStat;
        const dice = statKey ? statDiceLabel(statKey) : (spell.manualCastDice||spell.castDice||2)+'d6';
        const tag = statKey ? STAT_NAMES[statKey] : 'Manual';
        const chip = document.createElement('span');
        chip.className = 'spell-stat-chip cast';
        chip.innerHTML = `${iconSvg('die')} Casteo: <strong>${dice}</strong> · ${tag}`;
        statsDiv.appendChild(chip);
      }
      const aStats = getAttackStats(spell);
      if(aStats.length>0 && (spell.effectType==='damage')){
        const totalDice = aStats.reduce((sum,k)=>sum+getDice(k),0);
        const chip = document.createElement('span');
        chip.className = 'spell-stat-chip atk';
        chip.innerHTML = `${iconSvg('attack')} Ataque: <strong>${totalDice}d6</strong> · ${aStats.map(k=>STAT_NAMES[k]).join(' + ')}`;
        statsDiv.appendChild(chip);
      }
      card.appendChild(statsDiv);

      const meta = document.createElement('div');
      meta.className = 'spell-meta';
      meta.innerHTML = `
        <span>${iconSvg('mana')} ${spell.manaCost} maná</span>
        ${spell.duration?`<span>${iconSvg('duration')} ${escapeHtml(spell.duration)}</span>`:''}
        <span>${effectLabel(spell.effectType)}</span>
      `;
      card.appendChild(meta);

      if(spell.orders && spell.orders.length){
        const ordersDiv = document.createElement('div');
        ordersDiv.className = 'spell-orders';
        spell.orders.forEach(o=>{
          const chip = document.createElement('span');
          chip.className = 'chip'; chip.textContent = o;
          ordersDiv.appendChild(chip);
        });
        card.appendChild(ordersDiv);
      }

      const effDiv = document.createElement('div');
      effDiv.className = 'spell-effect-text';
      if(spell.effectType==='damage' || spell.effectType==='heal'){
        const diceParts = (spell.damage.dice||[]).map(d=>`${d.count}${d.type}`).join(' + ');
        const bonus = spell.damage.bonus ? ` + ${spell.damage.bonus}` : '';
        const notes = spell.damage.notes ? ` (${spell.damage.notes})` : '';
        const prefix = spell.effectType==='heal'?'Curación':'Daño';
        effDiv.textContent = `${prefix}: ${diceParts||'—'}${bonus}${notes}`;
        if(spell.effectDescription) effDiv.textContent += '\n'+spell.effectDescription;
      } else {
        effDiv.textContent = spell.effectDescription || '(sin descripción)';
      }
      card.appendChild(effDiv);

      const actions = document.createElement('div');
      actions.className = 'spell-actions';

      if(spell.effectType==='damage'){
        if((spell.castStat||'none')!=='none'){
          const castBtn = document.createElement('button');
          setIconText(castBtn, 'die', 'Castear');
          castBtn.addEventListener('click',()=>rollCast(spell));
          actions.appendChild(castBtn);
        }
        if(getAttackStats(spell).length>0){
          const atkBtn = document.createElement('button');
          atkBtn.className = 'primary';
          setIconText(atkBtn, 'attack', 'Atacar');
          atkBtn.addEventListener('click',()=>rollAttackAndDamage(spell));
          actions.appendChild(atkBtn);
        }
      } else if(spell.effectType==='heal'){
        const healBtn = document.createElement('button');
        healBtn.className = 'primary';
        setIconText(healBtn, 'heal', 'Curar');
        healBtn.addEventListener('click',()=>rollHeal(spell));
        actions.appendChild(healBtn);
      } else {
        const rollBtn = document.createElement('button');
        rollBtn.className = 'primary';
        setIconText(rollBtn, 'die', 'Lanzar');
        rollBtn.addEventListener('click',()=>rollCast(spell));
        actions.appendChild(rollBtn);
      }

      const editBtn = document.createElement('button');
      editBtn.innerHTML = iconSvg('edit'); editBtn.title = 'Editar';
      editBtn.addEventListener('click',()=>fillForm(spell));
      actions.appendChild(editBtn);

      const delBtn = document.createElement('button');
      delBtn.className = 'danger'; delBtn.innerHTML = iconSvg('delete'); delBtn.title = 'Eliminar';
      delBtn.addEventListener('click',()=>{
        if(confirm(`¿Eliminar "${spell.name}"?${spell.isBasic?'\n\n(Podés restaurarlo con "Restaurar hechizos básicos".)':''}`)){
          spells = spells.filter(s=>s.id!==spell.id);
          saveSpells();
          renderSpellList();
        }
      });
      actions.appendChild(delBtn);

      card.appendChild(actions);
      list.appendChild(card);
    });
  }

  $('testSpellBtn').addEventListener('click',()=>{
    const spell = collectFormData();
    if(spell.effectType==='heal') rollHeal(spell);
    else if(spell.effectType==='damage' && getAttackStats(spell).length>0) rollAttackAndDamage(spell);
    else rollCast(spell);
  });

  function rollD6(){return Math.floor(Math.random()*6)+1}
  function rollDie(type){return Math.floor(Math.random()*parseInt(type.replace('d','')))+1}

  function countSuccesses(rolls){
    let successes = 0, fails = 0;
    for(const r of rolls){
      if(r===1) fails += 1;
      else if(r===5) successes += 1;
      else if(r===6) successes += 2;
    }
    return {successes, fails};
  }
  function renderDie(r){
    let cls = 'die-neutral';
    if(r===1) cls = 'die-fail';
    else if(r===5||r===6) cls = 'die-success';
    return `<span class="die ${cls}">${r}</span>`;
  }

  function spellAssured(spell){
    return (typeof spell.assuredSuccess==='number') ? spell.assuredSuccess : (spell.assuredSuccess?1:0);
  }
  function spellHasAttack(spell){
    return getAttackStats(spell).length > 0 && spell.effectType === 'damage';
  }

  function rollCastDiceFor(spell){
    const stat = spell.castStat || 'none';
    if(stat==='none') return null;
    let count;
    if(stat==='manual') count = spell.manualCastDice || spell.castDice || 2;
    else count = getDice(stat);
    if(count<=0) return null;
    const rolls = [];
    for(let i=0;i<count;i++) rolls.push(rollD6());
    const {successes, fails} = countSuccesses(rolls);
    const assured = spellHasAttack(spell) ? 0 : spellAssured(spell);
    return {rolls, successes: successes+assured, fails, assured, count, stat};
  }

  function rollAttackDiceFor(spell){
    const stats = getAttackStats(spell);
    if(stats.length===0) return null;
    let totalDice = 0;
    const breakdown = [];
    for(const key of stats){
      const d = getDice(key);
      if(d>0){ totalDice += d; breakdown.push({stat:key, dice:d}); }
    }
    if(totalDice===0) return null;
    const rolls = [];
    for(let i=0;i<totalDice;i++) rolls.push(rollD6());
    const {successes, fails} = countSuccesses(rolls);
    const assured = spellAssured(spell);
    return {rolls, successes: successes+assured, fails, assured, totalDice, breakdown};
  }

  function ensureLogVisible(){
    const logContainer = $('logContainer');
    const empty = logContainer.querySelector('.empty-illustration');
    if(empty) empty.remove();
    return logContainer;
  }

  function netLine(successes, fails){
    const net = successes - fails;
    let html = `<div class="log-line">→ <span class="success">${successes} éxito(s)</span> · <span class="fail">${fails} fallo(s)</span></div>`;
    if(successes===0 && fails===0){
      html += `<div class="log-line">${iconSvg('warning')} <strong>Sin éxitos ni fallos:</strong> no se ejecuta.</div>`;
    } else if(net>0){
      html += `<div class="log-line"><strong>Neto:</strong> <span class="success">+${net}</span></div>`;
    } else if(net<0){
      html += `<div class="log-line"><strong>Neto:</strong> <span class="fail">${net}</span></div>`;
    } else {
      html += `<div class="log-line"><strong>Neto:</strong> empate</div>`;
    }
    return html;
  }

  function buildCastSection(spell){
    const r = rollCastDiceFor(spell);
    if(!r) return '';
    let diceHtml = r.rolls.map(renderDie).join('');
    for(let i=0;i<r.assured;i++) diceHtml += '<span class="die die-assured" title="Éxito asegurado">+1</span>';
    const statLabel = r.stat==='manual'?'Manual':STAT_NAMES[r.stat];
    return `
      <div class="log-step">
        <div class="log-step-title">${iconSvg('die')} Casteo (${statLabel} · ${r.count}d6${r.assured>0?` +${r.assured} asegurado${r.assured!==1?'s':''}`:''})</div>
        <div class="dice-row">${diceHtml||'<span class="empty">—</span>'}</div>
        ${netLine(r.successes, r.fails)}
      </div>
    `;
  }

  function buildAttackSection(spell){
    const r = rollAttackDiceFor(spell);
    if(!r) return '';
    let diceHtml = r.rolls.map(renderDie).join('');
    for(let i=0;i<r.assured;i++) diceHtml += '<span class="die die-assured" title="Éxito asegurado">+1</span>';
    const parts = r.breakdown.map(b=>`${STAT_NAMES[b.stat]} ${b.dice}d6`).join(' + ');
    return `
      <div class="log-step">
        <div class="log-step-title attack">${iconSvg('attack')} Ataque híbrido (${parts}${r.assured>0?` +${r.assured} asegurado${r.assured!==1?'s':''}`:''})</div>
        <div class="dice-row">${diceHtml||'<span class="empty">—</span>'}</div>
        ${netLine(r.successes, r.fails)}
      </div>
    `;
  }

  function buildDamageSection(spell){
    if(spell.effectType!=='damage' && spell.effectType!=='heal') return '';
    const dmgRolls = [];
    const parts = [];
    (spell.damage.dice||[]).forEach(d=>{
      const rolls = [];
      for(let i=0;i<d.count;i++){
        const r = rollDie(d.type);
        rolls.push(r); dmgRolls.push(r);
      }
      parts.push(`${d.count}${d.type} [${rolls.join(', ')}]`);
    });
    const sum = dmgRolls.reduce((a,b)=>a+b,0) + (spell.damage.bonus||0);
    const notes = spell.damage.notes?` (${escapeHtml(spell.damage.notes)})`:'';
    const isHeal = spell.effectType==='heal';
    return `
      <div class="log-step">
        <div class="log-step-title damage">${effectLabel(spell.effectType)}</div>
        <div class="log-line">${parts.length?parts.join(' + '):'—'}${spell.damage.bonus?` + ${spell.damage.bonus}`:''} = <strong class="${isHeal?'heal':''}">${sum}</strong>${notes}</div>
      </div>
    `;
  }

  function buildDamageSectionManual(spell){
    const diceParts = (spell.damage.dice||[]).map(d=>`${d.count}${d.type}`).join(' + ');
    const bonus = spell.damage.bonus ? ` + ${spell.damage.bonus}` : '';
    const notes = spell.damage.notes ? ` (${escapeHtml(spell.damage.notes)})` : '';
    const isHeal = spell.effectType === 'heal';
    return `
      <div class="log-step manual-damage-section">
        <div class="log-step-title damage">${effectLabel(spell.effectType)} manual</div>
        <div class="log-line">Tirá <strong>${diceParts || '—'}${bonus}</strong>${notes} y anotá el total:</div>
        <div style="display:flex;gap:8px;margin-top:8px">
          <input type="number" class="manual-damage-input" placeholder="Total" min="0">
          <button class="manual-damage-confirm primary" style="padding:6px 14px">OK</button>
        </div>
      </div>
    `;
  }

  function attachManualDamageListener(entry, spell){
    const input = entry.querySelector('.manual-damage-input');
    const btn = entry.querySelector('.manual-damage-confirm');
    if(!input || !btn) return;
    const confirm = () => {
      const val = parseInt(input.value);
      if(isNaN(val)){ input.focus(); return; }
      const notes = spell.damage.notes ? ` (${escapeHtml(spell.damage.notes)})` : '';
      const isHeal = spell.effectType === 'heal';
      const section = entry.querySelector('.manual-damage-section');
      section.outerHTML = `
        <div class="log-step">
          <div class="log-step-title damage">${effectLabel(spell.effectType)}</div>
          <div class="log-line"><strong class="${isHeal?'heal':''}">${val}</strong>${notes} <span style="color:var(--text-muted);font-size:.72rem">(manual)</span></div>
        </div>
      `;
    };
    btn.addEventListener('click', confirm);
    input.addEventListener('keydown', e=>{ if(e.key==='Enter') confirm(); });
  }

  function rollCast(spell){
    const container = ensureLogVisible();
    const entry = document.createElement('div');
    entry.className = 'log-entry cast-only';
    entry.innerHTML = `<div class="log-title">${iconSvg('die')} ${escapeHtml(spell.name)} — Casteo</div>`;
    const castHtml = buildCastSection(spell);
    entry.innerHTML += castHtml || '<p class="empty">Este hechizo no tiene tirada de casteo.</p>';
    entry.innerHTML += `<div class="log-line" style="margin-top:8px;color:var(--text-dim)">${iconSvg('mana')} Coste: ${spell.manaCost} maná${spell.duration?` · ${iconSvg('duration')} ${escapeHtml(spell.duration)}`:''}</div>`;
    container.prepend(entry);
    entry.classList.add('flash');
    setTimeout(()=>entry.classList.remove('flash'),700);
  }

  function rollAttackAndDamage(spell){
    const container = ensureLogVisible();
    const entry = document.createElement('div');
    entry.className = 'log-entry attack-only';
    entry.innerHTML = `<div class="log-title">${iconSvg('attack')} ${escapeHtml(spell.name)} — Ataque</div>`;
    entry.innerHTML += buildAttackSection(spell) || '';
    if(spell.damageMode === 'manual'){
      entry.innerHTML += buildDamageSectionManual(spell);
    } else {
      entry.innerHTML += buildDamageSection(spell);
    }
    if(spell.effectDescription){
      entry.innerHTML += `<div class="log-line" style="margin-top:6px">${iconSvg('effect')} ${escapeHtml(spell.effectDescription)}</div>`;
    }
    entry.innerHTML += `<div class="log-line" style="margin-top:8px;color:var(--text-dim)">${iconSvg('mana')} Coste: ${spell.manaCost} maná${spell.duration?` · ${iconSvg('duration')} ${escapeHtml(spell.duration)}`:''}</div>`;
    container.prepend(entry);
    if(spell.damageMode === 'manual') attachManualDamageListener(entry, spell);
    entry.classList.add('flash');
    setTimeout(()=>entry.classList.remove('flash'),700);
  }

  function rollHeal(spell){
    const container = ensureLogVisible();
    const entry = document.createElement('div');
    entry.className = 'log-entry';
    entry.innerHTML = `<div class="log-title">${iconSvg('heal')} ${escapeHtml(spell.name)} — Curación</div>`;
    if((spell.castStat||'none')!=='none'){
      entry.innerHTML += buildCastSection(spell);
    }
    if(spell.damageMode === 'manual'){
      entry.innerHTML += buildDamageSectionManual(spell);
    } else {
      entry.innerHTML += buildDamageSection(spell);
    }
    if(spell.effectDescription){
      entry.innerHTML += `<div class="log-line" style="margin-top:6px">${iconSvg('effect')} ${escapeHtml(spell.effectDescription)}</div>`;
    }
    entry.innerHTML += `<div class="log-line" style="margin-top:8px;color:var(--text-dim)">${iconSvg('mana')} Coste: ${spell.manaCost} maná${spell.duration?` · ${iconSvg('duration')} ${escapeHtml(spell.duration)}`:''}</div>`;
    container.prepend(entry);
    if(spell.damageMode === 'manual') attachManualDamageListener(entry, spell);
    entry.classList.add('flash');
    setTimeout(()=>entry.classList.remove('flash'),700);
  }

  $('clearLogBtn').addEventListener('click',()=>{
    $('logContainer').innerHTML = `
      <div class="empty-illustration">
        <svg width="64" height="64" viewBox="0 0 64 64">
          <defs>
            <linearGradient id="emptyRock2" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#5a4530"/><stop offset="100%" stop-color="#2a2018"/>
            </linearGradient>
          </defs>
          <polygon points="10,44 20,28 32,24 44,30 54,44 44,54 20,54"
                   fill="url(#emptyRock2)" stroke="#4a3624" stroke-width="1.5" stroke-linejoin="round"/>
          <path d="M 32 24 Q 32 14 42 12 Q 40 20 32 24 Z" fill="#6a9147" opacity=".7"/>
          <path d="M 32 24 Q 26 16 18 16 Q 22 22 32 24 Z" fill="#6a9147" opacity=".5"/>
          <line x1="6" y1="10" x2="6" y2="56" stroke="#6a9147" stroke-width="1.5" opacity=".6"/>
          <line x1="58" y1="12" x2="58" y2="58" stroke="#6a9147" stroke-width="1.5" opacity=".6"/>
        </svg>
        Aún no has lanzado ningún hechizo.
      </div>`;
  });

  // ---------- FLOATING PANEL ----------
  function setupFloatPanel(){
    const panel = $('floatPanel');
    const header = $('floatHeader');
    const minBtn = $('floatMin');

    // Cargar posición guardada
    try {
      const saved = JSON.parse(localStorage.getItem('arcane_float_pos') || 'null');
      if(saved){
        panel.style.left = saved.left + 'px';
        panel.style.top = saved.top + 'px';
        panel.style.right = 'auto';
        panel.style.bottom = 'auto';
      }
      const minimized = localStorage.getItem('arcane_float_min') === '1';
      if(minimized){
        panel.classList.add('minimized');
        minBtn.textContent = '+';
      }
    } catch(e){}

    let dragging = false, offsetX = 0, offsetY = 0;
    header.addEventListener('mousedown', e=>{
      if(e.target.closest('.float-min')) return;
      dragging = true;
      const rect = panel.getBoundingClientRect();
      offsetX = e.clientX - rect.left;
      offsetY = e.clientY - rect.top;
      panel.style.right = 'auto';
      panel.style.bottom = 'auto';
      panel.style.left = rect.left + 'px';
      panel.style.top = rect.top + 'px';
      e.preventDefault();
    });
    document.addEventListener('mousemove', e=>{
      if(!dragging) return;
      panel.style.left = (e.clientX - offsetX) + 'px';
      panel.style.top = (e.clientY - offsetY) + 'px';
    });
    document.addEventListener('mouseup', ()=>{
      if(dragging){
        dragging = false;
        localStorage.setItem('arcane_float_pos', JSON.stringify({
          left: parseInt(panel.style.left),
          top: parseInt(panel.style.top)
        }));
      }
    });

    minBtn.addEventListener('click', ()=>{
      panel.classList.toggle('minimized');
      const minimized = panel.classList.contains('minimized');
      minBtn.textContent = minimized ? '+' : '−';
      localStorage.setItem('arcane_float_min', minimized ? '1' : '0');
    });

    let fDice = 2, fAssured = 0;
    panel.querySelectorAll('.mini-step').forEach(btn=>{
      btn.addEventListener('click', ()=>{
        const field = btn.dataset.field;
        const delta = parseInt(btn.dataset.delta);
        if(field === 'dice'){
          fDice = Math.max(0, Math.min(20, fDice + delta));
          $('floatDice').textContent = fDice;
        } else {
          fAssured = Math.max(0, Math.min(20, fAssured + delta));
          $('floatAssured').textContent = fAssured;
        }
      });
    });

    $('floatRoll').addEventListener('click', ()=>{
      const rolls = [];
      for(let i=0;i<fDice;i++) rolls.push(rollD6());
      let suc = 0, fail = 0;
      for(const r of rolls){
        if(r===1) fail += 1;
        else if(r===5) suc += 1;
        else if(r===6) suc += 2;
      }
      suc += fAssured;
      const diceHtml = rolls.map(renderDie).join('') +
        (fAssured>0 ? `<span class="die die-assured" title="Éxito asegurado">+${fAssured}</span>` : '');
      $('floatResult').innerHTML = `
        <div class="dice-row">${diceHtml||'<span class="empty">—</span>'}</div>
        <div class="dice-summary">
          <span class="success">${suc} éxito(s)</span> · <span class="fail">${fail} fallo(s)</span>
          · Neto: <strong style="color:${suc-fail>0?'var(--success)':suc-fail<0?'var(--fail)':'var(--text-dim)'}">${suc-fail>0?'+':''}${suc-fail}</strong>
        </div>
      `;
    });
  }


  // ---------- COPIAS DE SEGURIDAD PORTABLES ----------
  const BACKUP_KEYS = [
    'arcane_spells_v3','arcane_orders','arcane_character',
    'arcane_formula','arcane_panels','arcane_float_pos','arcane_float_min'
  ];

  function backupStatus(message, isError=false){
    const el = $('backupStatus');
    if(!el) return;
    el.textContent = message;
    el.style.color = isError ? 'var(--fail,#d87969)' : 'var(--success,#8ebd76)';
  }

  function makeBackup(){
    const data = {};
    BACKUP_KEYS.forEach(key=>{
      const raw = localStorage.getItem(key);
      if(raw !== null){
        try{ data[key] = JSON.parse(raw); }
        catch(_){ data[key] = raw; }
      }
    });
    return {
      app: 'Arcane Spell Lab',
      formatVersion: 1,
      exportedAt: new Date().toISOString(),
      description: 'Copia de seguridad de Arcane Spell Lab',
      data
    };
  }

  function downloadBlob(content, filename, mime){
    const blob = new Blob([content], {type:mime});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(()=>URL.revokeObjectURL(url), 1500);
  }

  function exportBackup(){
    try{
      const backup = makeBackup();
      const stamp = new Date().toISOString().replace(/[:.]/g,'-').slice(0,19);
      downloadBlob(JSON.stringify(backup,null,2), `arcane-backup-${stamp}.json`, 'application/json;charset=utf-8');
      backupStatus('Copia exportada. Guardala en un lugar seguro.');
    }catch(err){
      console.error(err);
      backupStatus('No se pudo exportar la copia. Revisá el espacio disponible del navegador.', true);
    }
  }

  function validateBackup(parsed){
    if(!parsed || typeof parsed !== 'object' || !parsed.data || typeof parsed.data !== 'object'){
      throw new Error('El archivo no tiene el formato de una copia de Arcane.');
    }
    if(parsed.app && parsed.app !== 'Arcane Spell Lab'){
      throw new Error('El archivo pertenece a otra aplicación.');
    }
    const data = parsed.data;
    if(data.arcane_spells_v3 !== undefined && !Array.isArray(data.arcane_spells_v3)){
      throw new Error('La lista de hechizos no es válida.');
    }
    if(data.arcane_orders !== undefined && !Array.isArray(data.arcane_orders)){
      throw new Error('La lista de órdenes no es válida.');
    }
    if(data.arcane_character !== undefined && (typeof data.arcane_character !== 'object' || Array.isArray(data.arcane_character))){
      throw new Error('Los datos del personaje no son válidos.');
    }
    if(data.arcane_formula !== undefined && (typeof data.arcane_formula !== 'object' || Array.isArray(data.arcane_formula))){
      throw new Error('La fórmula no es válida.');
    }
    return data;
  }

  function importBackupFile(file){
    if(!file) return;
    const reader = new FileReader();
    reader.onload = ()=>{
      try{
        const parsed = JSON.parse(String(reader.result || ''));
        const data = validateBackup(parsed);
        const count = Object.keys(data).filter(k=>BACKUP_KEYS.includes(k)).length;
        if(!count) throw new Error('La copia no contiene datos reconocibles.');
        if(!confirm('Importar esta copia reemplazará los datos actuales de Arcane en este navegador. Antes se descargará una copia de seguridad del estado actual. ¿Continuar?')) return;
        // Preserve the current state before replacing anything.
        const stamp = new Date().toISOString().replace(/[:.]/g,'-').slice(0,19);
        downloadBlob(JSON.stringify(makeBackup(),null,2), `arcane-backup-antes-de-importar-${stamp}.json`, 'application/json;charset=utf-8');
        BACKUP_KEYS.forEach(key=>{
          if(Object.prototype.hasOwnProperty.call(data,key)){
            const value = data[key];
            localStorage.setItem(key, typeof value === 'string' ? value : JSON.stringify(value));
          }else{
            localStorage.removeItem(key);
          }
        });
        backupStatus('Copia importada. Recargando el laboratorio…');
        setTimeout(()=>location.reload(), 650);
      }catch(err){
        console.error(err);
        backupStatus(err.message || 'No se pudo leer el archivo.', true);
      }
    };
    reader.onerror = ()=>backupStatus('No se pudo leer el archivo seleccionado.', true);
    reader.readAsText(file);
  }

  function setupBackupTools(){
    $('exportBackupBtn').addEventListener('click', exportBackup);
    $('importBackupBtn').addEventListener('click', ()=>$('backupFileInput').click());
    $('backupFileInput').addEventListener('change', e=>{
      importBackupFile(e.target.files && e.target.files[0]);
      e.target.value = '';
    });
    $('printAppBtn').addEventListener('click', ()=>window.print());
  }

  function init(){
    loadStorage();
    setupBackupTools();
    ensureBasicSpells();
    setupPanelCollapse();
    setupFormulaPanel();
    renderProfile();
    renderFormulaPreview();
    updateFormulaDisplays();
    renderOrderSelect();
    renderOrderChips();
    renderDamageDice();
    renderAttackStatCheckboxes();
    updateCastPreview();
    updateAssuredPreview();
    updateCastStatBox();
    updateAttackStatBox();
    renderSpellList();
    setEffectType('damage');
    setupFloatPanel();
  }
  init();
})();
</script>
