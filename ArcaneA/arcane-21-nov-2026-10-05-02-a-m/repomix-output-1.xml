                      </div>
                      <p className="mt-0.5 text-xs text-[var(--arc-muted)]">
                        {selectedControlMeta.detailedRule}
                      </p>
                      {targetImmuneToSelectedBlind && (
                        <p className="mt-1.5 text-xs font-semibold text-[#fbbf24]">
