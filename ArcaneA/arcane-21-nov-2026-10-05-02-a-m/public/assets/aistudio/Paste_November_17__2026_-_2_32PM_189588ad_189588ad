// ============ COMBAT ============
function getCombatantHp(cb){
  if(cb.kind === 'mage'){
    const m = mageById(cb.mageId);
    if(m) return m.hp;
    return {max:1, current:0};
  }
  return cb.hp;
}
function getCombatantMana(cb){
  if(cb.kind === 'mage'){
    const m = mageById(cb.mageId);
    return m ? m.mana : null;
  }
  return null;
}
function setCombatantHp(cb, current){
  if(cb.kind === 'mage'){
    const m = mageById(cb.mageId);
    if(m) m.hp.current = Math.max(0, Math.min(m.hp.max, current));
  } else {
    cb.hp.current = Math.max(-cb.hp.max, Math.min(cb.hp.max, current));
  }
}
function setCombatantMana(cb, current){
  if(cb.kind === 'mage'){
    const m = mageById(cb.mageId);
    if(m) m.mana.current = Math.max(0, Math.min(m.mana.max, current));
  }
}

function isCombatantActivePlayer(cb){
  return cb.kind === 'mage' && cb.mageId === state.activeMageId;
}
function isMageInCombat(mageId){
  return state.combat.combatants.some(c => c.kind === 'mage' && c.mageId === mageId);
}
function getOtherCombatants(){
  return state.combat.combatants.filter(c => !isCombatantActivePlayer(c) && getCombatantHp(c).current > 0);
}

function renderAddMageSelect(){
  const sel = $('addMageCombatSelect');
  sel.innerHTML = '';
  const available = state.mages.filter(m => !isMageInCombat(m.id));
  if(available.length === 0){
    const opt = document.createElement('option');
    opt.value = ''; opt.textContent = '(todos en combate)';
    sel.appendChild(opt);
    return;
  }
  const ph = document.createElement('option');
  ph.value = ''; ph.textContent = '— Añadir mago al combate —';
  sel.appendChild(ph);
  available.forEach(m => {
    const opt = document.createElement('option');
    opt.value = m.id; opt.textContent = m.name;
    sel.appendChild(opt);
  });
}

function renderCombat(){
  $('roundNumber').textContent = state.combat.round;
  renderAddMageSelect();
  const list = $('combatantList');
  if(state.combat.combatants.length === 0){
    list.innerHTML = '<p class="empty">No hay combatientes en el combate.</p>';
    return;
  }
  // Ordenar por iniciativa
  const sorted = [...state.combat.combatants].sort((a,b) => (b.initiative||0) - (a.initiative||0));
  list.innerHTML = '';
  sorted.forEach(cb => {
    const hp = getCombatantHp(cb);
    const mana = getCombatantMana(cb);
    const dead = hp.current <= 0;
    const isPlayer = isCombatantActivePlayer(cb);
    const mage = cb.kind === 'mage' ? mageById(cb.mageId) : null;
    const hpPct = hp.max > 0 ? Math.max(0, hp.current / hp.max * 100) : 0;
    const manaPct = mana && mana.max > 0 ? Math.max(0, mana.current / mana.max * 100) : 0;

    const row = document.createElement('div');
    row.className = 'combatant-row ' + cb.kind + (isPlayer ? ' is-active-player' : '') + (dead ? ' dead' : '');

    let statsHtml = '';
    if(mage){
      statsHtml = `<div class="combatant-stats">
        <span>Fís ${getDiceForMage(mage,'fisico')}d6</span>
        <span>Man ${getDiceForMage(mage,'manipulacion')}d6</span>
        <span>Inf ${getDiceForMage(mage,'influencia')}d6</span>
      </div>`;
    }

    let manaHtml = '';
    if(mana){
      manaHtml = `
        <div class="combatant-mana-track"><div class="combatant-mana-fill" style="width:${manaPct}%"></div></div>
        <div class="combatant-bars-labels"><span>Maná</span><span>${mana.current}/${mana.max}</span></div>
      `;
    }

    row.innerHTML = `
      <div class="combatant-header">
        <div class="combatant-name">
          ${esc(cb.name)}
          <span class="combatant-badge ${cb.kind}">${cb.kind === 'mage' ? 'Mago' : 'Enemigo'}</span>
          ${isPlayer ? '<span class="combatant-badge player">TÚ</span>' : ''}
          ${dead ? '<span class="combatant-badge dead">Derrotado</span>' : ''}
        </div>
        <span class="combatant-init">Init ${cb.initiative||0}</span>
      </div>
      <div class="combatant-bars">
        <div class="combatant-hp-track"><div class="combatant-hp-fill${dead?' dead':''}" style="width:${hpPct}%"></div></div>
        <div class="combatant-bars-labels"><span>Vida</span><span>${Math.max(0,hp.current)}/${hp.max}</span></div>
        ${manaHtml}
      </div>
      ${statsHtml}
      <div class="combatant-controls">
        <button class="small" data-cb="${cb.id}" data-hp="-10">−10</button>
        <button class="small" data-cb="${cb.id}" data-hp="-5">−5</button>
        <button class="small" data-cb="${cb.id}" data-hp="-1">−1</button>
        <button class="small" data-cb="${cb.id}" data-hp="1">+1</button>
        <button class="small" data-cb="${cb.id}" data-hp="5">+5</button>
        <button class="small" data-cb="${cb.id}" data-hp="reset">↺</button>
        <button class="small danger" data-cb="${cb.id}" data-del="1">🗑</button>
      </div>
    `;
    row.querySelectorAll('[data-hp]').forEach(btn => {
      btn.addEventListener('click', () => {
        const c = state.combat.combatants.find(x => x.id === cb.id);
        if(!c) return;
        const cur = getCombatantHp(c).current;
        const v = btn.dataset.hp;
        if(v === 'reset') setCombatantHp(c, getCombatantHp(c).max);
        else setCombatantHp(c, cur + parseInt(v));
        saveState(); refreshAll();
      });
    });
    row.querySelector('[data-del]')?.addEventListener('click', () => {
      state.combat.combatants = state.combat.combatants.filter(x => x.id !== cb.id);
      saveState(); refreshAll();
    });
    list.appendChild(row);
  });
}

