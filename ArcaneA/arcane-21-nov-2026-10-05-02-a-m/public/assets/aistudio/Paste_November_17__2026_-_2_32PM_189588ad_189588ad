  const m = activeMage();
  if(m) ensureBasicsKnown(m);
  saveState(); refreshAll();
});

// ============ KNOWN SPELLS ============
function renderSpellList(){
  const list = $('spellList');
  const mage = activeMage();
  const known = mage ? state.spellLibrary.filter(s => mage.knownSpells.includes(s.id)) : [];
  $('spellCount').textContent = known.length;
  if(known.length === 0){
    list.innerHTML = '<p class="empty">Este mago no conoce hechizos.</p>';
    return;
  }
  list.innerHTML = '';
  const sorted = [...known].sort((a,b) => {
    if(a.isBasic && !b.isBasic) return -1;
    if(!a.isBasic && b.isBasic) return 1;
    return a.name.localeCompare(b.name);
  });
  sorted.forEach(spell => {
    const card = document.createElement('div');
    card.className = 'spell-card' + (spell.isBasic ? ' is-basic' : '');
    const h3 = document.createElement('h3');
    h3.innerHTML = esc(spell.name);
    if(spell.isBasic){ const b=document.createElement('span'); b.className='badge-basic'; b.textContent='Básico'; h3.appendChild(b); }
    const assuredN = (typeof spell.assuredSuccess==='number') ? spell.assuredSuccess : (spell.assuredSuccess?1:0);
    if(assuredN>0){ const b=document.createElement('span'); b.className='badge-assured'; b.textContent=`✓ ${assuredN}`; h3.appendChild(b); }
    if(spell.damageMode==='manual' && (spell.effectType==='damage'||spell.effectType==='heal')){
      const b=document.createElement('span'); b.className='badge-manual'; b.textContent='✋'; h3.appendChild(b);
    }
    card.appendChild(h3);

    const statsDiv = document.createElement('div');
    statsDiv.className = 'spell-stats';
    if((spell.castStat||'none') !== 'none'){
      const statKey = spell.castStat==='manual' ? null : spell.castStat;
      const dice = statKey ? statDiceLabel(statKey) : (spell.manualCastDice||2)+'d6';
      const tag = statKey ? STAT_NAMES[statKey] : 'Manual';
      const chip = document.createElement('span');
      chip.className = 'spell-stat-chip cast';
      chip.innerHTML = `🎲 <strong>${dice}</strong> · ${tag}`;
      statsDiv.appendChild(chip);
    }
    const aStats = getAttackStats(spell);
    if(aStats.length>0 && spell.effectType==='damage'){
      const total = aStats.reduce((s,k)=>s+getDice(k),0);
      const chip = document.createElement('span');
      chip.className = 'spell-stat-chip atk';
      chip.innerHTML = `⚔️ <strong>${total}d6</strong> · ${aStats.map(k=>STAT_NAMES[k]).join(' + ')}`;
      statsDiv.appendChild(chip);
    }
    card.appendChild(statsDiv);

    const meta = document.createElement('div');
    meta.className = 'spell-meta';
    meta.innerHTML = `
      <span>💧 ${spell.manaCost} maná</span>
      ${spell.duration?`<span>⏱ ${esc(spell.duration)}</span>`:''}
      <span>${spell.effectType==='damage'?'💥 Daño':spell.effectType==='heal'?'💚 Curación':'✨ Efecto'}</span>
    `;
    card.appendChild(meta);

    if(spell.orders && spell.orders.length){
      const ordersDiv = document.createElement('div');
      ordersDiv.className = 'spell-orders';
      spell.orders.forEach(o => {
        const chip = document.createElement('span');
        chip.className = 'chip'; chip.textContent = o;
        ordersDiv.appendChild(chip);
      });
      card.appendChild(ordersDiv);
    }

    const effDiv = document.createElement('div');
    effDiv.className = 'spell-effect-text';
    if(spell.effectType==='damage' || spell.effectType==='heal'){
      const parts = (spell.damage.dice||[]).map(d=>`${d.count}${d.type}`).join(' + ');
      const bonus = spell.damage.bonus ? ` + ${spell.damage.bonus}` : '';
      const notes = spell.damage.notes ? ` (${spell.damage.notes})` : '';
      effDiv.textContent = `${spell.effectType==='heal'?'Curación':'Daño'}: ${parts||'—'}${bonus}${notes}`;
    } else {
      effDiv.textContent = spell.effectDescription || '(sin descripción)';
    }
    card.appendChild(effDiv);

    const actions = document.createElement('div');
    actions.className = 'spell-actions';
    if(spell.effectType==='damage'){
      if((spell.castStat||'none')!=='none'){
        const b = document.createElement('button');
        b.textContent = '🎲 Castear';
        b.addEventListener('click', () => rollCast(spell));
        actions.appendChild(b);
      }
      if(getAttackStats(spell).length>0){
        const b = document.createElement('button');
        b.className = 'primary';
        b.textContent = '⚔️ Atacar';
        b.addEventListener('click', () => rollAttack(spell));
        actions.appendChild(b);
      }
    } else if(spell.effectType==='heal'){
      const b = document.createElement('button');
      b.className = 'primary';
      b.textContent = '💚 Curar';
      b.addEventListener('click', () => rollHeal(spell));
      actions.appendChild(b);
    } else {
      const b = document.createElement('button');
      b.className = 'primary';
      b.textContent = '🎲 Lanzar';
      b.addEventListener('click', () => rollCast(spell));
      actions.appendChild(b);
    }
    const eBtn = document.createElement('button');
    eBtn.textContent = '✎';
    eBtn.addEventListener('click', () => fillForm(spell));
    actions.appendChild(eBtn);
    card.appendChild(actions);
    list.appendChild(card);
  });
}

// ============ EDITOR ============
function renderAttackStatCheckboxes(){
  const container = $('attackStatCheckboxes');
  container.innerHTML = '';
  const mage = activeMage();
  ['fisico','manipulacion','influencia'].forEach(key => {
    const lbl = document.createElement('label');
    lbl.className = 'attack-stat-checkbox' + (attackStats.includes(key) ? ' checked' : '');
    lbl.innerHTML = `
      <input type="checkbox" data-stat="${key}" ${attackStats.includes(key)?'checked':''}>
      <span class="stat-label">${STAT_NAMES[key]}</span>
      <span class="stat-dice-inline">${getDiceForMage(mage,key)}d6</span>
      <span class="stat-lvl-inline">nv ${mage?.stats[key]||1}</span>
    `;
    const cb = lbl.querySelector('input');
    cb.addEventListener('change', e => {
      if(e.target.checked){ if(!attackStats.includes(key)) attackStats.push(key); }
      else { attackStats = attackStats.filter(k => k !== key); }
      lbl.classList.toggle('checked', e.target.checked);
      updateAttackStatBox();
    });
    container.appendChild(lbl);
  });
}
function updateAttackStatBox(){
  const group = $('attackStatGroup');
  if(effectType !== 'damage'){ group.style.display = 'none'; return; }
  group.style.display = 'block';
  if(attackStats.length === 0){
    $('attackStatValue').textContent = '0d6';
    $('attackStatTag').textContent = 'Sin ataque';
    return;
  }
  const total = attackStats.reduce((s,k)=>s+getDice(k),0);
  $('attackStatValue').textContent = total + 'd6';
  $('attackStatTag').textContent = attackStats.map(k=>STAT_NAMES[k]).join(' + ');
}
function updateCastStatBox(){
  const box = $('castStatBox');
  const manual = $('manualCastSection');
  if(castStat === 'manual'){ box.style.display='none'; manual.style.display='block'; return; }
  if(castStat === 'none'){ box.style.display='none'; manual.style.display='none'; return; }
  box.style.display='flex'; manual.style.display='none';
