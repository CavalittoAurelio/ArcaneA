// ============ LIBRARY ============
function renderLibrary(){
  $('libraryCount').textContent = state.spellLibrary.length;
  const list = $('libraryList');
  if(state.spellLibrary.length === 0){
    list.innerHTML = '<p class="empty">Biblioteca vacía.</p>';
    return;
  }
  const mage = activeMage();
  list.innerHTML = '';
  const sorted = [...state.spellLibrary].sort((a,b) => {
    if(a.isBasic && !b.isBasic) return -1;
    if(!a.isBasic && b.isBasic) return 1;
    return a.name.localeCompare(b.name);
  });
  sorted.forEach(spell => {
    const known = mage && mage.knownSpells.includes(spell.id);
    const item = document.createElement('div');
    item.className = 'library-item' + (known ? ' known' : '');
    const meta = [];
    if(spell.isBasic) meta.push('Básico');
    if(spell.manaCost) meta.push(`${spell.manaCost} maná`);
    meta.push(spell.effectType === 'damage' ? 'Daño' : spell.effectType === 'heal' ? 'Curación' : 'Efecto');
    item.innerHTML = `
      <div class="info">
        <div class="name">${esc(spell.name)}</div>
        <div class="meta">${meta.join(' · ')}</div>
      </div>
      <button class="small ${known?'ghost':''}" data-learn="${spell.id}">
        ${known ? '✓' : 'Aprender'}
      </button>
    `;
    item.querySelector('[data-learn]').addEventListener('click', () => {
      const m = activeMage(); if(!m) return;
      if(m.knownSpells.includes(spell.id)){
        if(spell.isBasic){ alert('Los básicos no se olvidan.'); return; }
        m.knownSpells = m.knownSpells.filter(id => id !== spell.id);
      } else {
        m.knownSpells.push(spell.id);
      }
      saveState(); refreshAll();
    });
    list.appendChild(item);
  });
}
$('restoreBasicsBtn').addEventListener('click', () => {
