<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Arcane — Laboratorio y Combate PvP</title>
<style>
:root{--bg:#1a1108;--panel:#2c1e12;--panel-2:#38281a;--panel-3:#44301e;
--border:#4a3624;--border-light:#5a4530;--accent:#8fb56a;--accent-dark:#6a9147;
--accent-2:#d4a843;--accent-3:#b87b4a;--text:#ecdfc4;--text-dim:#b0a084;
--text-muted:#7a6b52;--danger:#d85a3a;--success:#a4d67e;--fail:#e08060}
*{box-sizing:border-box}html,body{margin:0}
body{font-family:'Segoe UI',system-ui,-apple-system,sans-serif;
background:radial-gradient(ellipse at top,#2a1e10 0%,var(--bg) 70%);
background-attachment:fixed;color:var(--text);min-height:100vh}
body::before{content:"";position:fixed;inset:0;z-index:-1;
background-image:url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='160' height='280' viewBox='0 0 160 280'%3E%3Cg fill='%238fb56a'%3E%3Crect x='22' y='0' width='7' height='280' rx='1'/%3E%3Crect x='19' y='65' width='13' height='3' rx='1' fill='%236a9147'/%3E%3Crect x='19' y='155' width='13' height='3' rx='1' fill='%236a9147'/%3E%3Crect x='78' y='0' width='6' height='280' rx='1'/%3E%3Crect x='75' y='40' width='12' height='3' rx='1' fill='%236a9147'/%3E%3Crect x='75' y='120' width='12' height='3' rx='1' fill='%236a9147'/%3E%3Crect x='128' y='0' width='8' height='280' rx='1'/%3E%3Crect x='125' y='85' width='14' height='3' rx='1' fill='%236a9147'/%3E%3C/g%3E%3C/svg%3E");
background-size:160px 280px;opacity:.07;pointer-events:none}

header{padding:20px 22px;background:linear-gradient(135deg,rgba(60,40,20,.9) 0%,rgba(44,30,18,.95) 50%,rgba(40,50,26,.9) 100%);
border-bottom:2px solid var(--accent-dark);display:flex;align-items:center;gap:14px;flex-wrap:wrap;
box-shadow:0 4px 24px rgba(0,0,0,.5)}
header h1{margin:0;font-size:1.4rem;letter-spacing:1.5px;
background:linear-gradient(90deg,var(--accent),var(--accent-2));
-webkit-background-clip:text;background-clip:text;color:transparent;font-weight:700}
header .sub{color:var(--text-dim);font-size:.8rem;margin-top:2px}
header .title-block{flex:1;min-width:200px}
header .selector{display:flex;align-items:center;gap:6px;background:rgba(20,14,8,.5);
border:1px solid var(--border-light);border-radius:999px;padding:5px 12px}
header .selector label{font-size:.7rem;text-transform:uppercase;letter-spacing:.5px;color:var(--text-dim)}
header .selector select{background:transparent;border:none;color:var(--accent-2);font-weight:600;font-size:.88rem;padding:0;width:auto;max-width:200px}

main{display:grid;grid-template-columns:1fr 1fr;gap:18px;padding:18px;max-width:1500px;margin:0 auto}
@media(max-width:1000px){main{grid-template-columns:1fr}}
.column{display:flex;flex-direction:column;gap:18px}

.panel{background:var(--panel);border:1px solid var(--border);border-radius:12px;padding:16px;
position:relative;overflow:hidden;box-shadow:0 2px 12px rgba(0,0,0,.25);transition:padding .2s}
.panel::before{content:"";position:absolute;inset:0;
background:linear-gradient(135deg,rgba(143,181,106,.05),transparent 40%);pointer-events:none}
.panel>*{position:relative}
.panel.collapsed{padding-bottom:10px}
.panel.collapsed .panel-content{display:none}
.panel h2{margin:0 0 12px;font-size:1.05rem;color:var(--accent);
border-bottom:1px solid var(--border);padding-bottom:8px;display:flex;align-items:center;gap:8px;
cursor:pointer;user-select:none;transition:margin .2s,padding .2s,border-color .2s}
.panel.collapsed h2{margin-bottom:0;padding-bottom:0;border-bottom-color:transparent}
.panel-toggle{background:none;border:none;padding:0;width:18px;height:18px;
display:inline-flex;align-items:center;justify-content:center;color:var(--text-dim);
cursor:pointer;font-size:.75rem;transition:transform .2s;flex:0 0 auto}
.panel.collapsed .panel-toggle{transform:rotate(-90deg)}
.panel h2:hover{color:var(--accent-2)}
.icon-inline{width:1em;height:1em;flex:0 0 auto;vertical-align:-.16em}

.stat-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px}
@media(max-width:520px){.stat-grid{grid-template-columns:1fr}}
.stat-card{background:var(--panel-2);border:1px solid var(--border);border-radius:10px;padding:10px}
.stat-name{font-size:.75rem;text-transform:uppercase;letter-spacing:.6px;
color:var(--accent-2);font-weight:600;margin-bottom:6px}
.stat-card select{margin-bottom:6px;font-size:.85rem;padding:6px 8px}
.stat-info{display:flex;justify-content:space-between;font-size:.75rem;color:var(--text-dim)}
.stat-points{background:var(--panel);border:1px solid var(--border);padding:2px 8px;
border-radius:4px;color:var(--accent-3)}
.stat-dice{background:var(--panel);border:1px solid var(--accent-dark);padding:2px 10px;
border-radius:4px;color:var(--accent);font-family:monospace;font-weight:700}

.resource-bars{display:flex;gap:12px;margin-top:12px;flex-wrap:wrap}
.resource-bar{flex:1;min-width:220px}
.resource-bar-header{display:flex;justify-content:space-between;align-items:baseline;
margin-bottom:5px;font-size:.75rem}
.resource-bar-header .label{color:var(--accent-2);text-transform:uppercase;
letter-spacing:.5px;font-weight:600;display:flex;align-items:center;gap:5px}
.resource-bar-header .value{font-family:monospace;color:var(--text)}
.resource-bar-track{height:16px;background:var(--panel);border:1px solid var(--border);
border-radius:8px;overflow:hidden}
.resource-bar-fill{height:100%;transition:width .3s;border-radius:8px}
.resource-bar-fill.hp{background:linear-gradient(90deg,#a83a2a,#d85a3a)}
.resource-bar-fill.mana{background:linear-gradient(90deg,#3a5aa8,#5a8ad8)}
.resource-controls{display:flex;gap:3px;margin-top:5px;flex-wrap:wrap;align-items:center}
.resource-controls button{padding:3px 8px;font-size:.72rem;min-width:0}
.resource-controls input{width:55px;padding:3px 6px;font-size:.75rem}

.form-group{margin-bottom:12px}
.form-group>label{display:block;font-size:.75rem;text-transform:uppercase;
letter-spacing:.5px;color:var(--text-dim);margin-bottom:6px}
input[type=text],input[type=number],select,textarea{width:100%;background:var(--panel-2);
border:1px solid var(--border);border-radius:8px;padding:7px 10px;color:var(--text);
font-family:inherit;font-size:.88rem;transition:border-color .15s}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--accent);
box-shadow:0 0 0 2px rgba(143,181,106,.18)}
textarea{resize:vertical;min-height:60px}

button{background:var(--panel-2);border:1px solid var(--border);color:var(--text);
border-radius:8px;padding:7px 13px;cursor:pointer;font-family:inherit;font-size:.88rem;
transition:all .15s;display:inline-flex;align-items:center;justify-content:center;gap:6px}
button:hover{border-color:var(--accent);background:var(--panel-3)}
button.primary{background:var(--accent-dark);border-color:var(--accent);color:#fff;font-weight:600}
button.primary:hover{background:var(--accent)}
button.danger{color:var(--danger)}
button.danger:hover{border-color:var(--danger);background:#2e1810}
button.small{padding:4px 9px;font-size:.75rem}
button.ghost{background:transparent;border:1px dashed var(--border-light);color:var(--text-dim)}
button.ghost:hover{color:var(--accent);border-color:var(--accent-dark);border-style:solid}

.chips{display:flex;flex-wrap:wrap;gap:6px;min-height:28px;margin-bottom:8px}
.chip{background:var(--panel-2);border:1px solid var(--accent-dark);color:var(--text);
border-radius:999px;padding:3px 10px;font-size:.8rem;display:inline-flex;align-items:center;gap:6px}
.chip::before{content:"◈";color:var(--accent-2);font-size:.72rem}
.chip button{background:none;border:none;color:var(--text-dim);padding:0;
font-size:1rem;line-height:1;cursor:pointer}
.chip button:hover{color:var(--danger)}
.row{display:flex;gap:8px}.row>*{flex:1}.row>button{flex:0 0 auto}

.dice-counter{display:flex;align-items:center;gap:8px}
.dice-counter button{width:34px;height:34px;font-size:1.2rem;padding:0}
.dice-preview{font-family:monospace;font-size:1rem;color:var(--accent-2);
padding:5px 12px;background:var(--panel-2);border-radius:8px;border:1px solid var(--border)}

.stat-linked-box{background:var(--panel-2);border:1px solid var(--accent-dark);
border-radius:8px;padding:9px 12px;display:flex;align-items:center;justify-content:space-between;
gap:10px;flex-wrap:wrap}
.stat-linked-box .label{font-size:.8rem;color:var(--text-dim)}
.stat-linked-box .value{font-family:monospace;font-size:1.1rem;color:var(--accent);font-weight:700}
.stat-linked-box .stat-tag{font-size:.68rem;color:var(--text-muted);
background:var(--panel);padding:2px 8px;border-radius:4px;border:1px solid var(--border)}

.attack-stat-checkbox{display:flex;align-items:center;gap:10px;padding:9px 12px;
background:var(--panel-2);border:1px solid var(--border);border-radius:8px;
cursor:pointer;margin-bottom:6px;transition:.15s;user-select:none}
.attack-stat-checkbox:hover{border-color:var(--accent-dark)}
.attack-stat-checkbox.checked{border-color:var(--accent);background:rgba(143,181,106,.08)}
.attack-stat-checkbox input{width:16px;height:16px;accent-color:var(--accent);cursor:pointer;margin:0}
.attack-stat-checkbox .stat-label{flex:1;font-size:.85rem}
.attack-stat-checkbox .stat-dice-inline{font-family:monospace;color:var(--accent);font-weight:700;font-size:.85rem}
.attack-stat-checkbox .stat-lvl-inline{font-size:.68rem;color:var(--text-muted)}

.effect-tabs{display:flex;gap:4px;margin-bottom:10px}
.effect-tabs button{flex:1;font-size:.82rem;padding:7px 4px}
.effect-tabs button.active{background:var(--accent-dark);border-color:var(--accent);color:#fff}

.damage-die-row{display:flex;gap:6px;align-items:center;margin-bottom:6px}
.damage-die-row select{flex:0 0 90px}
.damage-die-row input{flex:0 0 70px}
.damage-die-row button{flex:0 0 auto;padding:5px 9px}

.actions{display:flex;gap:6px;margin-top:12px;flex-wrap:wrap}
.actions button{flex:1;min-width:100px}

.spell-card{background:var(--panel-2);border:1px solid var(--border);
border-left:3px solid var(--accent-dark);border-radius:10px;padding:12px;margin-bottom:10px}
.spell-card.is-basic{border-left-color:var(--accent-2)}
.spell-card h3{margin:0 0 6px;font-size:.95rem;color:var(--accent-2);
display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.badge-basic{background:var(--accent-2);color:#2a1e10;font-size:.6rem;
padding:2px 7px;border-radius:4px;font-weight:700;letter-spacing:.5px;text-transform:uppercase}
.badge-assured{background:rgba(212,168,67,.15);color:var(--accent-2);
border:1px solid var(--accent-2);font-size:.6rem;padding:2px 7px;border-radius:4px;font-weight:600}
.badge-manual{background:rgba(184,123,74,.15);color:var(--accent-3);
border:1px solid var(--accent-3);font-size:.6rem;padding:2px 7px;border-radius:4px;font-weight:600}
.spell-stats{display:flex;flex-wrap:wrap;gap:5px;margin:7px 0}
.spell-stat-chip{font-size:.7rem;padding:2px 8px;border-radius:999px;
background:var(--panel);border:1px solid var(--border);color:var(--text-dim);
display:inline-flex;align-items:center;gap:5px}
.spell-stat-chip strong{color:var(--accent);font-family:monospace}
.spell-stat-chip.cast{border-color:var(--accent-dark)}
.spell-stat-chip.atk{border-color:var(--accent-3);color:var(--text)}
.spell-meta{display:flex;flex-wrap:wrap;gap:5px;font-size:.75rem;color:var(--text-dim);margin-bottom:7px}
.spell-meta span{background:var(--panel);padding:2px 8px;border-radius:4px;border:1px solid var(--border)}
.spell-orders{display:flex;flex-wrap:wrap;gap:4px;margin-bottom:7px}
.spell-orders .chip{font-size:.7rem;padding:2px 8px}
.spell-effect-text{font-size:.82rem;color:var(--text);margin-bottom:7px;white-space:pre-wrap;
background:var(--panel);padding:7px 10px;border-radius:6px;border:1px solid var(--border);line-height:1.5}
.spell-actions{display:flex;gap:5px;flex-wrap:wrap}
.spell-actions button{padding:5px 9px;font-size:.78rem}

/* Combatant rows */
.combatant-row{background:var(--panel-2);border:1px solid var(--border);
border-radius:10px;padding:10px 12px;margin-bottom:8px;border-left:3px solid var(--border)}
.combatant-row.mage{border-left-color:var(--accent)}
.combatant-row.enemy{border-left-color:var(--accent-3)}
.combatant-row.is-active-player{background:rgba(143,181,106,.08);border-color:var(--accent-dark)}
.combatant-row.dead{opacity:.5}
.combatant-header{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:6px}
.combatant-name{font-weight:600;color:var(--accent-2);font-size:.9rem;
display:flex;align-items:center;gap:6px;flex-wrap:wrap;flex:1}
.combatant-badge{font-size:.6rem;padding:2px 7px;border-radius:4px;font-weight:700;
letter-spacing:.4px;text-transform:uppercase}
.combatant-badge.mage{background:var(--accent);color:#1a1108}
.combatant-badge.enemy{background:var(--accent-3);color:#1a1108}
.combatant-badge.player{background:var(--accent-2);color:#1a1108}
.combatant-badge.dead{background:#4a3624;color:var(--text-muted)}
.combatant-init{font-size:.68rem;padding:2px 7px;background:var(--panel);
border:1px solid var(--border);border-radius:4px;color:var(--accent-3);font-family:monospace}
.combatant-bars{display:flex;flex-direction:column;gap:4px;margin-bottom:6px}
.combatant-hp-track,.combatant-mana-track{height:9px;background:var(--panel);
border-radius:5px;overflow:hidden;border:1px solid var(--border)}
.combatant-hp-fill{height:100%;background:linear-gradient(90deg,#a83a2a,#d85a3a);transition:width .3s}
.combatant-mana-fill{height:100%;background:linear-gradient(90deg,#3a5aa8,#5a8ad8);transition:width .3s}
.combatant-hp-fill.dead{background:linear-gradient(90deg,#4a4a4a,#6a6a6a)}
.combatant-bars-labels{display:flex;justify-content:space-between;font-size:.68rem;
color:var(--text-dim);font-family:monospace}
.combatant-stats{display:flex;gap:5px;flex-wrap:wrap;margin-top:5px;font-size:.68rem}
.combatant-stats span{background:var(--panel);padding:1px 7px;border-radius:4px;
border:1px solid var(--border);font-family:monospace;color:var(--text-dim)}
.combatant-controls{display:flex;gap:3px;flex-wrap:wrap;margin-top:7px;align-items:center}
.combatant-controls button{padding:3px 7px;font-size:.7rem;min-width:0}
.combatant-controls input{width:48px;padding:3px 6px;font-size:.7rem}

/* Defense panel */
.defense-panel{background:var(--panel-2);border:1px solid var(--accent-2);
border-radius:8px;padding:10px;margin-top:8px}
.defense-title{font-size:.82rem;color:var(--accent-2);font-weight:600;margin-bottom:8px}
.defense-row{display:flex;gap:6px;align-items:center;flex-wrap:wrap}
.defense-row select{flex:1;min-width:140px;font-size:.82rem}
.defense-row button{flex:0 0 auto;padding:6px 12px;font-size:.82rem}
.defense-result{margin-top:8px;font-size:.82rem;padding:8px 10px;
background:var(--panel);border-radius:6px;border:1px solid var(--border);line-height:1.5}
.defense-result.win{border-color:var(--danger)}
.defense-result.lose{border-color:var(--accent)}
.defense-result.draw{border-color:var(--accent-2)}

.apply-buttons{display:flex;flex-wrap:wrap;gap:4px;margin-top:8px;padding:8px;
background:var(--panel);border:1px dashed var(--accent-dark);border-radius:6px}
.apply-buttons .label{font-size:.7rem;color:var(--text-muted);text-transform:uppercase;
letter-spacing:.4px;flex:0 0 100%;margin-bottom:2px}
.apply-buttons button{padding:4px 10px;font-size:.72rem;background:var(--panel-2);
border:1px solid var(--accent-dark);color:var(--text)}
.apply-buttons button:hover{background:var(--accent-dark);color:#fff}
.apply-buttons button.defend{border-color:var(--accent-2);color:var(--accent-2)}
.apply-buttons button.defend:hover{background:var(--accent-2);color:#1a1108}

/* Log */
.log-entry{background:var(--panel-2);border-left:3px solid var(--accent);
border-radius:6px;padding:10px 12px;margin-bottom:10px;font-size:.84rem}
.log-entry.cast-only{border-left-color:var(--accent-dark)}
.log-entry.attack-only{border-left-color:var(--accent-3)}
.log-entry.combat-event{border-left-color:var(--accent-2)}
.log-title{font-weight:600;color:var(--accent-2);margin-bottom:7px;font-size:.92rem}
.log-step{background:var(--panel);border:1px solid var(--border);border-radius:6px;
padding:8px 10px;margin:7px 0}
.log-step-title{font-size:.74rem;text-transform:uppercase;letter-spacing:.5px;
color:var(--accent);font-weight:600;margin-bottom:5px}
.log-step-title.attack{color:var(--accent-3)}
.log-step-title.damage{color:var(--accent-2)}
.log-line{margin:4px 0;line-height:1.5}
.dice-row{display:flex;flex-wrap:wrap;gap:4px;margin:5px 0;align-items:center}
.die{display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;
border-radius:7px;font-weight:700;font-family:monospace;font-size:.88rem;border:2px solid}
.die-neutral{background:#2e2418;color:var(--text-muted);border-color:#4a3624}
.die-fail{background:#3e1c12;color:#ff9a7a;border-color:#7a3020}
.die-success{background:#1e3a18;color:#c4f2a4;border-color:#4a7a30}
.die-assured{background:#3a2e10;color:var(--accent-2);border-color:#8a6a20;border-style:dashed}
.success{color:var(--success);font-weight:600}
.fail{color:var(--fail);font-weight:600}
.heal{color:#a4d67e;font-weight:600}
.empty{color:var(--text-dim);font-style:italic;font-size:.82rem}
.hint{font-size:.72rem;color:var(--text-dim);margin-top:4px;line-height:1.5}
.empty-illustration{display:flex;flex-direction:column;align-items:center;gap:8px;
padding:18px;color:var(--text-muted);font-style:italic;font-size:.82rem}
.flash{animation:flash .7s ease}
@keyframes flash{0%{background:var(--accent-dark)}100%{background:var(--panel-2)}}

.mage-row{display:flex;align-items:center;gap:8px;padding:9px 11px;
background:var(--panel-2);border:1px solid var(--border);border-radius:8px;margin-bottom:5px}
.mage-row.active{border-color:var(--accent);background:rgba(143,181,106,.08)}
.mage-row .info{flex:1;min-width:0}
.mage-row .info .name{font-size:.88rem;font-weight:600}
.mage-row .info .detail{font-size:.7rem;color:var(--text-muted);margin-top:2px}
.mage-row .actions{display:flex;gap:4px}
.mage-row button{padding:3px 8px;font-size:.7rem;min-width:0}

.library-item{background:var(--panel-2);border:1px solid var(--border);
border-left:3px solid var(--accent-3);border-radius:8px;padding:9px 11px;margin-bottom:6px;
display:flex;align-items:center;gap:8px}
.library-item.known{border-left-color:var(--accent)}
.library-item .info{flex:1;min-width:0}
.library-item .name{font-weight:600;color:var(--accent-2);font-size:.88rem}
.library-item .meta{font-size:.7rem;color:var(--text-muted);margin-top:2px}
.library-item button{padding:4px 10px;font-size:.72rem;min-width:0;flex:0 0 auto}

.float-panel{position:fixed;bottom:20px;right:20px;width:210px;
background:var(--panel);border:2px solid var(--accent-dark);border-radius:12px;
box-shadow:0 8px 32px rgba(0,0,0,.6);z-index:1000;font-size:.82rem}
.float-panel.minimized .float-body{display:none}
.float-header{cursor:move;padding:9px 11px;background:var(--panel-2);
border-radius:10px 10px 0 0;display:flex;justify-content:space-between;align-items:center;
user-select:none;font-weight:600;color:var(--accent-2);font-size:.8rem}
.float-header:active{cursor:grabbing}
.float-min{background:none;border:none;color:var(--text-dim);width:22px;height:22px;
padding:0;cursor:pointer;font-size:.95rem;border-radius:4px}
.float-min:hover{color:var(--accent)}
.float-body{padding:10px}
.float-row{display:flex;align-items:center;gap:6px;margin-bottom:6px}
.float-row>span:first-child{flex:1;color:var(--text-dim);font-size:.74rem}
.float-row button{width:26px;height:26px;padding:0;font-size:.95rem}
.float-val{font-family:monospace;min-width:1.5em;text-align:center;
color:var(--accent);font-weight:700;font-size:.95rem}
#floatRoll{width:100%;margin-top:4px;padding:7px;font-size:.82rem}
.float-result{margin-top:8px}
.float-result .die{width:24px;height:24px;font-size:.78rem}
.float-result .dice-summary{font-size:.72rem;color:var(--text-dim);margin-top:5px;line-height:1.4}

.manual-damage-section input[type=number]{flex:1}

.backup-panel{grid-column:1/-1;margin:0;padding:0;border:1px solid var(--border);
border-radius:14px;background:linear-gradient(135deg,rgba(93,125,70,.10),rgba(197,151,76,.045));overflow:hidden}
.backup-head{display:flex;align-items:center;justify-content:space-between;gap:12px;
flex-wrap:wrap;cursor:pointer;list-style:none;padding:14px 18px}
.backup-head::-webkit-details-marker{display:none}
.backup-title{font-size:.9rem;font-weight:650}
.backup-chevron{font-size:1.1rem;color:var(--text-dim);transition:transform .2s}
.backup-panel[open] .backup-chevron{transform:rotate(45deg)}
.backup-panel[open] .backup-head{border-bottom:1px solid var(--border)}
.backup-note,.backup-actions,.backup-status{margin:14px 18px 0}
.backup-status{margin-bottom:14px;font-size:.78rem;min-height:1.2em;color:var(--success)}
.backup-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
</style>
</head>
<body>

<header>
  <div class="title-block">
    <h1>Arcane — Laboratorio y Combate PvP</h1>
    <div class="sub">Sistema d6 · tiradas enfrentadas · mago vs mago</div>
  </div>
  <div class="selector">
    <label>Mago activo</label>
    <select id="mageSelector"></select>
  </div>
</header>

<main>
  <div class="column">
    <section class="panel" data-pid="profile">
      <h2><span class="panel-toggle">▼</span> Perfil del mago</h2>
      <div class="panel-content">
        <div class="form-group">
          <label>Nombre</label>
          <input type="text" id="mageName" placeholder="Ej: Torin Roca">
        </div>
        <div class="stat-grid" id="statGrid"></div>
        <div class="resource-bars">
          <div class="resource-bar">
            <div class="resource-bar-header">
              <span class="label">❤ Vida</span>
              <span class="value"><span id="hpCurrent">20</span> / <input type="number" id="hpMax" min="1" value="20"></span>
            </div>
            <div class="resource-bar-track"><div class="resource-bar-fill hp" id="hpFill" style="width:100%"></div></div>
            <div class="resource-controls">
              <button class="small" data-hp="-5">−5</button>
              <button class="small" data-hp="-1">−1</button>
              <button class="small" data-hp="1">+1</button>
              <button class="small" data-hp="5">+5</button>
              <button class="small" data-hp="reset">↺</button>
            </div>
          </div>
          <div class="resource-bar">
            <div class="resource-bar-header">
              <span class="label">✦ Maná</span>
              <span class="value"><span id="manaCurrent">15</span> / <input type="number" id="manaMax" min="0" value="15"></span>
            </div>
            <div class="resource-bar-track"><div class="resource-bar-fill mana" id="manaFill" style="width:100%"></div></div>
            <div class="resource-controls">
              <button class="small" data-mana="-5">−5</button>
              <button class="small" data-mana="-1">−1</button>
              <button class="small" data-mana="1">+1</button>
              <button class="small" data-mana="5">+5</button>
              <button class="small" data-mana="reset">↺</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="panel" data-pid="combat">
      <h2>
        <span class="panel-toggle">▼</span>
        Combate
        <span style="margin-left:auto;font-size:.7rem;color:var(--text-muted);text-transform:none;font-weight:normal">Ronda <strong id="roundNumber">1</strong></span>
      </h2>
      <div class="panel-content">
        <div class="actions" style="margin-top:0;margin-bottom:10px">
          <button id="prevRoundBtn" class="ghost small">← Ronda</button>
          <button id="nextRoundBtn" class="primary small">Siguiente →</button>
          <button id="resetCombatBtn" class="danger small">Terminar</button>
        </div>
        <div class="row" style="margin-bottom:8px">
          <select id="addMageCombatSelect"></select>
          <button id="addMageCombatBtn">+ Mago</button>
        </div>
        <div class="row" style="margin-bottom:10px">
          <input type="text" id="enemyName" placeholder="Enemigo">
          <input type="number" id="enemyHp" placeholder="PV" min="1" value="10" style="max-width:70px">
          <input type="number" id="enemyInit" placeholder="Init" min="0" value="0" style="max-width:60px">
          <button id="addEnemyBtn" class="primary">+</button>
        </div>
        <div id="combatantList"><p class="empty">No hay combatientes en el combate.</p></div>
      </div>
    </section>

    <section class="panel collapsed" data-pid="mages">
      <h2><span class="panel-toggle">▼</span> Magos (<span id="mageCount">0</span>)</h2>
      <div class="panel-content">
        <div id="mageList"></div>
        <div class="actions">
          <button id="newMageBtn" class="primary">+ Nuevo</button>
          <button id="duplicateMageBtn" class="ghost">Duplicar</button>
        </div>
      </div>
    </section>

    <section class="panel collapsed" data-pid="formula">
      <h2><span class="panel-toggle">▼</span> Fórmula de dados</h2>
      <div class="panel-content">
        <div class="formula-formula" style="font-family:monospace;font-size:.88rem;background:var(--panel-2);border:1px solid var(--accent-dark);border-radius:8px;padding:10px;text-align:center;color:var(--accent-2);margin-bottom:10px">
          dados = <strong id="formulaBaseDisplay">1</strong> + (nivel × <strong id="formulaMultDisplay">1</strong>) → <strong id="formulaCurrent">1 + nivel</strong>
        </div>
        <div class="row">
          <div class="form-group" style="margin-bottom:0">
            <label>Base</label>
            <input type="number" id="formulaBase" min="0" max="10" value="1">
          </div>
          <div class="form-group" style="margin-bottom:0">
            <label>×Nivel</label>
            <input type="number" id="formulaMult" min="0" max="5" value="1">
          </div>
        </div>
        <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:10px">
          <button class="small ghost formula-preset" data-base="1" data-mult="1">1 + nivel</button>
          <button class="small ghost formula-preset" data-base="0" data-mult="1">Solo nivel</button>
          <button class="small ghost formula-preset" data-base="1" data-mult="2">1 + 2×nivel</button>
          <button class="small ghost formula-preset" data-base="2" data-mult="1">2 + nivel</button>
        </div>
      </div>
    </section>

    <section class="panel" data-pid="editor">
      <h2><span class="panel-toggle">▼</span> <span id="editorTitle">Crear hechizo</span></h2>
      <div class="panel-content">
        <div class="form-group">
          <label>Nombre</label>
          <input type="text" id="spellName" placeholder="Ej: Puño de Tierra">
        </div>
        <div class="row" style="margin-bottom:12px">
          <div style="flex:1">
            <label style="font-size:.75rem;text-transform:uppercase;letter-spacing:.5px;color:var(--text-dim);display:block;margin-bottom:6px">Maná</label>
            <input type="number" id="manaCost" min="0" value="3">
          </div>
          <div style="flex:2">
            <label style="font-size:.75rem;text-transform:uppercase;letter-spacing:.5px;color:var(--text-dim);display:block;margin-bottom:6px">Duración</label>
            <input type="text" id="duration" list="durationList" placeholder="Instantáneo...">
            <datalist id="durationList"><option value="Instantáneo"><option value="1 turno"><option value="1 golpe"><option value="Hasta el final del combate"><option value="Hasta ser disipado"></datalist>
          </div>
        </div>
        <div class="form-group">
          <label>Órdenes</label>
          <div class="chips" id="orderChips"></div>
          <div class="row" style="margin-bottom:5px">
            <select id="orderSelect"></select>
            <button id="addOrderBtn">+ Añadir</button>
          </div>
          <div class="row">
            <input type="text" id="newOrderInput" placeholder="Nueva orden...">
            <button id="createOrderBtn">+ Crear</button>
          </div>
        </div>
        <div class="form-group">
          <label>Casteo</label>
          <select id="castStatSelect">
            <option value="manipulacion">Manipulación</option>
            <option value="fisico">Físico</option>
            <option value="influencia">Influencia</option>
            <option value="manual">Manual</option>
            <option value="none">Ninguna</option>
          </select>
          <div class="stat-linked-box" id="castStatBox" style="margin-top:8px">
            <span class="label">Dados</span>
            <span class="value" id="castStatValue">3d6</span>
            <span class="stat-tag" id="castStatTag">Manipulación</span>
          </div>
          <div id="manualCastSection" style="display:none;margin-top:8px">
            <div class="dice-counter">
              <button id="castMinus">−</button>
              <span id="castCount" style="min-width:2em;text-align:center;font-weight:600">2</span>
              <button id="castPlus">+</button>
              <span class="dice-preview" id="castPreview">2d6</span>
            </div>
          </div>
        </div>
        <div class="form-group">
          <label>Éxitos asegurados</label>
          <div class="dice-counter">
            <button id="assuredMinus">−</button>
            <span id="assuredCount" style="min-width:2em;text-align:center;font-weight:600">0</span>
            <button id="assuredPlus">+</button>
            <span class="dice-preview" id="assuredPreview">0</span>
          </div>
        </div>
        <div class="form-group">
          <label>Efecto</label>
          <div class="effect-tabs">
            <button data-type="damage" class="active" id="tabDamage">💥 Daño</button>
            <button data-type="heal" id="tabHeal">💚 Curación</button>
            <button data-type="effect" id="tabEffect">✨ Efecto</button>
          </div>
          <div id="diceSection">
            <label style="font-size:.72rem;color:var(--text-dim);display:block;margin-bottom:5px" id="diceLabel">Dados de daño</label>
            <div id="damageDiceList"></div>
            <button id="addDamageDieBtn" class="small" style="margin-bottom:10px">+ Dado</button>
            <div class="row" style="margin-bottom:10px">
              <div style="flex:1">
                <label style="font-size:.72rem;color:var(--text-dim);display:block;margin-bottom:4px" id="bonusLabel">Bonus</label>
                <input type="number" id="damageBonus" value="0">
              </div>
              <div style="flex:2">
                <label style="font-size:.72rem;color:var(--text-dim);display:block;margin-bottom:4px" id="notesLabel">Notas</label>
                <input type="text" id="damageNotes" placeholder="Ej: mágico de tierra">
              </div>
            </div>
            <div class="form-group" style="margin-bottom:0">
              <label>Modo</label>
              <select id="damageMode">
                <option value="auto">Automático</option>
                <option value="manual">Manual</option>
              </select>
            </div>
          </div>
          <div id="effectSection" style="display:none">
            <textarea id="effectDescription" placeholder="Describe el efecto..."></textarea>
          </div>
        </div>
        <div class="form-group" id="attackStatGroup">
          <label>Estadísticas de ataque</label>
          <div id="attackStatCheckboxes"></div>
          <div class="stat-linked-box" id="attackStatBox" style="margin-top:8px">
            <span class="label">Total</span>
            <span class="value" id="attackStatValue">3d6</span>
            <span class="stat-tag" id="attackStatTag">Físico</span>
          </div>
        </div>
        <div class="actions">
          <button class="primary" id="saveSpellBtn">💾 Guardar</button>
          <button id="testSpellBtn">🎲 Probar</button>
          <button id="clearFormBtn">✕ Limpiar</button>
        </div>
      </div>
    </section>
  </div>

  <div class="column">
    <section class="panel" data-pid="spells">
      <h2><span class="panel-toggle">▼</span> Hechizos conocidos (<span id="spellCount">0</span>)</h2>
      <div class="panel-content">
        <div id="spellList"><p class="empty">Sin hechizos.</p></div>
      </div>
    </section>

    <section class="panel collapsed" data-pid="library">
      <h2><span class="panel-toggle">▼</span> Biblioteca (<span id="libraryCount">0</span>)</h2>
      <div class="panel-content">
        <div id="libraryList"></div>
        <div style="margin-top:10px;text-align:right">
          <button class="small ghost" id="restoreBasicsBtn">↺ Restaurar básicos</button>
        </div>
      </div>
    </section>

    <section class="panel" data-pid="log">
      <h2><span class="panel-toggle">▼</span> Log de combate</h2>
      <div class="panel-content">
        <div id="logContainer">
          <div class="empty-illustration">Sin tiradas todavía.</div>
        </div>
        <div class="actions"><button id="clearLogBtn" class="small">Borrar</button></div>
      </div>
    </section>

    <section class="panel collapsed" data-pid="rules">
      <h2><span class="panel-toggle">▼</span> Reglas</h2>
      <div class="panel-content">
        <ul style="list-style:none;padding:0;margin:0;display:grid;grid-template-columns:1fr 1fr;gap:5px;font-size:.82rem">
          <li style="display:flex;align-items:center;gap:7px;padding:5px 9px;background:var(--panel-2);border-radius:6px;border:1px solid var(--border)"><span class="die die-fail">1</span> <strong>1 fallo</strong></li>
          <li style="display:flex;align-items:center;gap:7px;padding:5px 9px;background:var(--panel-2);border-radius:6px;border:1px solid var(--border)"><span class="die die-neutral">2</span> nada</li>
          <li style="display:flex;align-items:center;gap:7px;padding:5px 9px;background:var(--panel-2);border-radius:6px;border:1px solid var(--border)"><span class="die die-neutral">3</span> nada</li>
          <li style="display:flex;align-items:center;gap:7px;padding:5px 9px;background:var(--panel-2);border-radius:6px;border:1px solid var(--border)"><span class="die die-neutral">4</span> nada</li>
          <li style="display:flex;align-items:center;gap:7px;padding:5px 9px;background:var(--panel-2);border-radius:6px;border:1px solid var(--border)"><span class="die die-success">5</span> <strong>1 éxito</strong></li>
          <li style="display:flex;align-items:center;gap:7px;padding:5px 9px;background:var(--panel-2);border-radius:6px;border:1px solid var(--border)"><span class="die die-success">6</span> <strong>2 éxitos</strong></li>
        </ul>
      </div>
    </section>
  </div>

  <details class="backup-panel">
    <summary class="backup-head">
      <span class="backup-title">📦 Copias de seguridad</span>
      <span class="backup-chevron">＋</span>
    </summary>
    <p class="backup-note" style="font-size:.78rem;color:var(--text-muted)">Todo se guarda en el navegador. Exportá una copia JSON para conservar magos, hechizos y combate.</p>
    <div class="backup-actions">
      <button class="primary" id="exportBackupBtn">⬇ Exportar</button>
      <button id="importBackupBtn">⬆ Importar</button>
      <input id="backupFileInput" type="file" accept=".json" hidden>
    </div>
    <div class="backup-status" id="backupStatus"></div>
  </details>
</main>

<div id="floatPanel" class="float-panel">
  <div class="float-header" id="floatHeader">
    <span>🎲 Dados rápidos</span>
    <button class="float-min" id="floatMin">−</button>
  </div>
  <div class="float-body">
    <div class="float-row">
      <span>Casteo</span>
      <button class="mini-step" data-field="dice" data-delta="-1">−</button>
      <span class="float-val" id="floatDice">2</span>
      <button class="mini-step" data-field="dice" data-delta="1">+</button>
    </div>
    <div class="float-row">
      <span>Asegurados</span>
      <button class="mini-step" data-field="assured" data-delta="-1">−</button>
      <span class="float-val" id="floatAssured">0</span>
      <button class="mini-step" data-field="assured" data-delta="1">+</button>
    </div>
    <button id="floatRoll" class="primary">🎲 Tirar</button>
    <div id="floatResult" class="float-result"></div>
  </div>
</div>

<script>
(function(){
'use strict';

const LEVEL_POINTS = {1:0,2:10,3:20,4:40,5:80};
const STAT_NAMES = {fisico:'Físico',manipulacion:'Manipulación',influencia:'Influencia'};
const DIE_TYPES = ['d4','d6','d8','d10','d12'];

const PRESET_ORDERS = [
'Levantar tierra','Mover tierra','Endurecer tierra','Moldear',
'Comprimir','Proyectar','Adherir','Sostener','Deslizar',
'Desgastar','Contener','Retrasar','Iluminar','Curar',
'Proteger','Fragmentar','Escudo','Barrera'
];

const BASIC_SPELLS = [
{id:'basic_luz_mago',name:'Luz de Mago',manaCost:0,orders:['Iluminar'],
 castStat:'manipulacion',manualCastDice:2,assuredSuccess:0,
 attackStats:[],damageMode:'auto',effectType:'effect',
 damage:{dice:[],bonus:0,notes:''},
 effectDescription:'Esfera de luz que sigue al mago.',
 duration:'Hasta ser disipado',isBasic:true},
{id:'basic_escudo_magico',name:'Escudo Mágico',manaCost:0,orders:['Proteger'],
 castStat:'manipulacion',manualCastDice:2,assuredSuccess:1,
 attackStats:[],damageMode:'auto',effectType:'effect',
 damage:{dice:[],bonus:0,notes:''},
 effectDescription:'Bloquea un ataque. Éxito asegurado.',
 duration:'1 golpe',isBasic:true},
{id:'basic_curar_heridas',name:'Curar Heridas Leves',manaCost:0,orders:['Curar'],
 castStat:'influencia',manualCastDice:2,assuredSuccess:0,
 attackStats:[],damageMode:'auto',effectType:'heal',
 damage:{dice:[{type:'d4',count:1}],bonus:0,notes:'curación'},
 effectDescription:'Cura 1d4 a un ser vivo tocado.',
 duration:'Instantáneo',isBasic:true}
];
const BASIC_IDS = BASIC_SPELLS.map(s => s.id);

// ============ STATE ============
const state = {
  mages: [],
  activeMageId: null,
  spellLibrary: [],
  customOrders: [],
  formula: {base:1, multiplier:1, notes:''},
  combat: {round: 1, combatants: []}
};

let editingId = null;
let currentOrders = [];
let effectType = 'damage';
let damageDice = [{type:'d6',count:1}];
let assuredSuccess = 0;
let castStat = 'manipulacion';
let manualCastDice = 2;
let attackStats = ['fisico'];
let damageMode = 'auto';

const $ = id => document.getElementById(id);
const esc = s => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const genId = p => (p||'id_')+Date.now().toString(36)+Math.random().toString(36).slice(2,7);
const allOrders = () => [...new Set([...PRESET_ORDERS, ...state.customOrders])].sort();

function activeMage(){ return state.mages.find(m => m.id === state.activeMageId) || state.mages[0] || null; }
function mageById(id){ return state.mages.find(m => m.id === id); }
function getAttackStats(spell){
  if(Array.isArray(spell.attackStats)) return spell.attackStats;
  const r = [];
  if(spell.attackStat && spell.attackStat !== 'none') r.push(spell.attackStat);
  if(spell.bonusAttackStat && spell.bonusAttackStat !== 'none') r.push(spell.bonusAttackStat);
  return r;
}

// ============ SAVE / LOAD ============
function saveState(){ localStorage.setItem('arcane_state_v5', JSON.stringify(state)); }
function loadState(){
  const raw = localStorage.getItem('arcane_state_v5');
  if(raw){
    try {
      const parsed = JSON.parse(raw);
      Object.assign(state, parsed);
      if(!state.mages || !state.mages.length) createInitialMage();
      if(!state.activeMageId || !state.mages.find(m => m.id === state.activeMageId)){
        state.activeMageId = state.mages[0].id;
      }
      if(!state.combat) state.combat = {round:1, combatants:[]};
      return;
    } catch(e){ console.warn('v5 parse error', e); }
  }
  // Migrar desde v4
  const oldRaw = localStorage.getItem('arcane_state_v4');
  if(oldRaw){
    try {
      const old = JSON.parse(oldRaw);
      Object.assign(state, old);
      // Migrar enemies a combatientes
      if(old.enemies && Array.isArray(old.enemies)){
        state.combat = {
          round: old.combatRound || 1,
          combatants: old.enemies.map(e => ({
            id: genId('cb_'), kind: 'enemy', name: e.name,
            initiative: e.initiative||0, hp: {max: e.hp.max, current: e.hp.current}
          }))
        };
      }
      delete state.enemies;
      delete state.combatRound;
      saveState();
      return;
    } catch(e){ console.warn('v4 migration error', e); }
  }
  // Migrar desde v3
  const oldSpells = JSON.parse(localStorage.getItem('arcane_spells_v3') || 'null');
  const oldChar = JSON.parse(localStorage.getItem('arcane_character') || 'null');
  const oldOrders = JSON.parse(localStorage.getItem('arcane_orders') || 'null');
  const oldFormula = JSON.parse(localStorage.getItem('arcane_formula') || 'null');
  if(oldSpells || oldChar){
    state.spellLibrary = oldSpells || [];
    state.customOrders = oldOrders || [];
    state.formula = oldFormula || {base:1, multiplier:1, notes:''};
    const mage = {
      id: genId('mage_'), name: 'Mi mago',
      stats: oldChar || {fisico:2, manipulacion:2, influencia:1},
      hp: {max:20, current:20}, mana: {max:15, current:15},
      knownSpells: (oldSpells||[]).map(s => s.id)
    };
    state.mages = [mage];
    state.activeMageId = mage.id;
    saveState();
  } else {
    createInitialMage();
  }
}
function createInitialMage(){
  const mage = {
    id: genId('mage_'), name: 'Mi mago',
    stats: {fisico:2, manipulacion:2, influencia:1},
    hp: {max:20, current:20}, mana: {max:15, current:15},
    knownSpells: []
  };
  state.mages = [mage];
  state.activeMageId = mage.id;
  ensureBasicSpells();
  ensureBasicsKnown(mage);
  saveState();
}
function ensureBasicSpells(){
  let added = false;
  BASIC_SPELLS.forEach(b => {
    if(!state.spellLibrary.find(s => s.id === b.id)){
      state.spellLibrary.unshift(JSON.parse(JSON.stringify(b)));
      added = true;
    }
  });
  if(added) saveState();
}
function ensureBasicsKnown(mage){
  if(!mage) return;
  BASIC_IDS.forEach(id => {
    if(!mage.knownSpells.includes(id)) mage.knownSpells.push(id);
  });
}

// ============ DICE ============
function calcDice(lvl){ return Math.max(0, Math.floor(state.formula.base + lvl * state.formula.multiplier)); }
function getDiceForMage(mage, statKey){
  if(!mage || !statKey || statKey === 'none') return 0;
  const lvl = mage.stats[statKey] || 1;
  const d = calcDice(lvl);
  return d < 1 ? 1 : d;
}
function getDice(statKey){ return getDiceForMage(activeMage(), statKey); }
function statDiceLabel(statKey){ return !statKey || statKey === 'none' ? '—' : getDice(statKey)+'d6'; }
function formulaDescription(){
  const b = state.formula.base, m = state.formula.multiplier;
  if(b===0 && m===0) return '0 dados';
  if(b===0 && m===1) return 'nivel';
  if(b===1 && m===1) return '1 + nivel';
  if(m===0) return b+' fijo';
  if(m===1) return b+' + nivel';
  return b+' + '+m+'×nivel';
}

