function renderMageList(){
  const list = $('mageList');
  $('mageCount').textContent = state.mages.length;
  list.innerHTML = '';
  state.mages.forEach(m => {
    const row = document.createElement('div');
    row.className = 'mage-row' + (m.id === state.activeMageId ? ' active' : '');
    row.innerHTML = `
      <div class="info">
        <div class="name">${esc(m.name)}</div>
        <div class="detail">❤ ${m.hp.current}/${m.hp.max} · ✦ ${m.mana.current}/${m.mana.max} · ${m.knownSpells.length} hechizos</div>
      </div>
      <div class="actions">
        ${m.id === state.activeMageId ? '' : `<button data-switch="${m.id}">Usar</button>`}
        <button class="danger" data-del="${m.id}">🗑</button>
      </div>
    `;
    row.querySelector('[data-switch]')?.addEventListener('click', () => {
      state.activeMageId = m.id; saveState(); refreshAll();
    });
    row.querySelector('[data-del]')?.addEventListener('click', () => {
      if(state.mages.length <= 1){ alert('Necesitás al menos un mago.'); return; }
      if(!confirm(`¿Eliminar "${m.name}"?`)) return;
      state.mages = state.mages.filter(x => x.id !== m.id);
      if(state.activeMageId === m.id) state.activeMageId = state.mages[0].id;
      // Eliminar también de combate
      state.combat.combatants = state.combat.combatants.filter(c => !(c.kind==='mage' && c.mageId === m.id));
      saveState(); refreshAll();
    });
    list.appendChild(row);
  });
}
