// ============ ROLLING ============
function rollD6(){ return Math.floor(Math.random()*6)+1; }
function rollDie(type){ return Math.floor(Math.random()*parseInt(type.replace('d','')))+1; }
function countSuccesses(rolls){
  let s=0, f=0;
  for(const r of rolls){ if(r===1) f+=1; else if(r===5) s+=1; else if(r===6) s+=2; }
  return {successes: s, fails: f};
}
function renderDie(r){
  let cls = 'die-neutral';
  if(r===1) cls = 'die-fail';
  else if(r===5||r===6) cls = 'die-success';
  return `<span class="die ${cls}">${r}</span>`;
}
function spellAssured(spell){
  return (typeof spell.assuredSuccess==='number') ? spell.assuredSuccess : (spell.assuredSuccess?1:0);
}
function spellHasAttack(spell){
  return getAttackStats(spell).length > 0 && spell.effectType === 'damage';
}
function rollCastDiceFor(spell){
  const stat = spell.castStat || 'none';
  if(stat === 'none') return null;
  let count = (stat === 'manual') ? (spell.manualCastDice || 2) : getDice(stat);
  if(count <= 0) return null;
  const rolls = [];
  for(let i=0;i<count;i++) rolls.push(rollD6());
  const {successes, fails} = countSuccesses(rolls);
  const assured = spellHasAttack(spell) ? 0 : spellAssured(spell);
  return {rolls, successes: successes+assured, fails, assured, count, stat};
}
function rollAttackDiceFor(spell){
  const stats = getAttackStats(spell);
  if(stats.length === 0) return null;
  let total = 0;
  const breakdown = [];
  stats.forEach(k => { const d = getDice(k); if(d>0){ total += d; breakdown.push({stat:k, dice:d}); } });
  if(total === 0) return null;
  const rolls = [];
  for(let i=0;i<total;i++) rolls.push(rollD6());
  const {successes, fails} = countSuccesses(rolls);
  const assured = spellAssured(spell);
  return {rolls, successes: successes+assured, fails, assured, totalDice: total, breakdown};
}
function ensureLogVisible(){
  const c = $('logContainer');
  const e = c.querySelector('.empty-illustration');
  if(e) e.remove();
  return c;
}
function netLine(s, f){
  const n = s - f;
  let h = `<div class="log-line">→ <span class="success">${s} éxito(s)</span> · <span class="fail">${f} fallo(s)</span></div>`;
  if(s===0 && f===0) h += `<div class="log-line">⚠️ <strong>Sin éxitos ni fallos:</strong> no se ejecuta.</div>`;
  else if(n>0) h += `<div class="log-line"><strong>Neto:</strong> <span class="success">+${n}</span></div>`;
  else if(n<0) h += `<div class="log-line"><strong>Neto:</strong> <span class="fail">${n}</span></div>`;
  else h += `<div class="log-line"><strong>Neto:</strong> empate</div>`;
  return h;
}
function buildCastSection(spell){
  const r = rollCastDiceFor(spell);
  if(!r) return '';
  let dh = r.rolls.map(renderDie).join('');
  for(let i=0;i<r.assured;i++) dh += '<span class="die die-assured">+1</span>';
  const statLabel = r.stat === 'manual' ? 'Manual' : STAT_NAMES[r.stat];
  return `<div class="log-step"><div class="log-step-title">🎲 Casteo (${statLabel} · ${r.count}d6${r.assured>0?' +'+r.assured:''})</div><div class="dice-row">${dh||'—'}</div>${netLine(r.successes, r.fails)}</div>`;
}
function buildAttackSection(spell){
  const r = rollAttackDiceFor(spell);
  if(!r) return {html:'', r:null};
  let dh = r.rolls.map(renderDie).join('');
  for(let i=0;i<r.assured;i++) dh += '<span class="die die-assured">+1</span>';
  const parts = r.breakdown.map(b => `${STAT_NAMES[b.stat]} ${b.dice}d6`).join(' + ');
  const html = `<div class="log-step"><div class="log-step-title attack">⚔️ Ataque (${parts}${r.assured>0?' +'+r.assured:''})</div><div class="dice-row">${dh||'—'}</div>${netLine(r.successes, r.fails)}</div>`;
  return {html, r};
}
function buildDamageSection(spell){
  if(spell.effectType!=='damage' && spell.effectType!=='heal') return {html:'', sum:0};
  const rolls = [];
  const parts = [];
  (spell.damage.dice||[]).forEach(d => {
    const rs = [];
    for(let i=0;i<d.count;i++){ const r = rollDie(d.type); rs.push(r); rolls.push(r); }
    parts.push(`${d.count}${d.type} [${rs.join(', ')}]`);
  });
  const sum = rolls.reduce((a,b)=>a+b,0) + (spell.damage.bonus||0);
  const notes = spell.damage.notes ? ` (${esc(spell.damage.notes)})` : '';
  const isHeal = spell.effectType === 'heal';
  const html = `<div class="log-step"><div class="log-step-title damage">${isHeal?'💚 Curación':'💥 Daño'}</div><div class="log-line">${parts.length?parts.join(' + '):'—'}${spell.damage.bonus?` + ${spell.damage.bonus}`:''} = <strong class="${isHeal?'heal':''}">${sum}</strong>${notes}</div></div>`;
  return {html, sum};
}
function buildDamageSectionManual(spell){
  const parts = (spell.damage.dice||[]).map(d=>`${d.count}${d.type}`).join(' + ');
  const bonus = spell.damage.bonus ? ` + ${spell.damage.bonus}` : '';
  const notes = spell.damage.notes ? ` (${esc(spell.damage.notes)})` : '';
  const isHeal = spell.effectType === 'heal';
  return `<div class="log-step manual-damage-section"><div class="log-step-title damage">${isHeal?'💚 Curación':'💥 Daño'} manual</div><div class="log-line">Tirá <strong>${parts||'—'}${bonus}</strong>${notes} y anotá:</div><div style="display:flex;gap:8px;margin-top:8px"><input type="number" class="manual-damage-input" placeholder="Total" min="0"><button class="manual-damage-confirm primary small">OK</button></div></div>`;
}

