// ============ PROFILE ============
function renderProfile(){
  const mage = activeMage();
  if(!mage) return;
  $('mageName').value = mage.name;
  const grid = $('statGrid');
  grid.innerHTML = '';
  ['fisico','manipulacion','influencia'].forEach(key => {
    const card = document.createElement('div');
    card.className = 'stat-card';
    card.innerHTML = `
      <div class="stat-name">${STAT_NAMES[key]}</div>
      <select data-stat="${key}">
        ${[1,2,3,4,5].map(n => `<option value="${n}" ${mage.stats[key]===n?'selected':''}>Nivel ${n}</option>`).join('')}
      </select>
      <div class="stat-info">
        <span class="stat-points">${LEVEL_POINTS[mage.stats[key]]} pts</span>
        <span class="stat-dice">${getDice(key)}d6</span>
      </div>
    `;
    grid.appendChild(card);
  });
  grid.querySelectorAll('select[data-stat]').forEach(sel => {
    sel.addEventListener('change', e => {
      mage.stats[e.target.dataset.stat] = parseInt(e.target.value);
      saveState(); refreshAll();
    });
  });
  renderResourceBars(mage);
}
function renderResourceBars(mage){
  $('hpCurrent').textContent = mage.hp.current;
  $('hpMax').value = mage.hp.max;
  const hpPct = mage.hp.max > 0 ? Math.max(0, mage.hp.current / mage.hp.max * 100) : 0;
  $('hpFill').style.width = Math.min(100, hpPct) + '%';
  $('manaCurrent').textContent = mage.mana.current;
  $('manaMax').value = mage.mana.max;
  const manaPct = mage.mana.max > 0 ? Math.max(0, mage.mana.current / mage.mana.max * 100) : 0;
  $('manaFill').style.width = Math.min(100, manaPct) + '%';
}
$('mageName').addEventListener('change', e => {
  const m = activeMage();
  if(m){ m.name = e.target.value.trim() || 'Sin nombre'; saveState(); renderMageSelector(); renderMageList(); renderAddMageSelect(); renderCombat(); }
});
document.querySelectorAll('[data-hp]').forEach(btn => {
  btn.addEventListener('click', () => {
    const m = activeMage(); if(!m) return;
    const v = btn.dataset.hp;
    if(v === 'reset') m.hp.current = m.hp.max;
    else m.hp.current = Math.max(0, Math.min(m.hp.max, m.hp.current + parseInt(v)));
    saveState(); refreshAll();
  });
});
document.querySelectorAll('[data-mana]').forEach(btn => {
  btn.addEventListener('click', () => {
    const m = activeMage(); if(!m) return;
    const v = btn.dataset.mana;
    if(v === 'reset') m.mana.current = m.mana.max;
    else m.mana.current = Math.max(0, Math.min(m.mana.max, m.mana.current + parseInt(v)));
    saveState(); refreshAll();
  });
});
$('hpMax').addEventListener('change', e => {
  const m = activeMage(); if(!m) return;
  m.hp.max = Math.max(1, parseInt(e.target.value) || 1);
  m.hp.current = Math.min(m.hp.current, m.hp.max);
  saveState(); refreshAll();
});
$('manaMax').addEventListener('change', e => {
  const m = activeMage(); if(!m) return;
  m.mana.max = Math.max(0, parseInt(e.target.value) || 0);
  m.mana.current = Math.min(m.mana.current, m.mana.max);
  saveState(); refreshAll();
});

